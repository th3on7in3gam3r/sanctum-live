# Sanctum Live™ - Environment Variables

# GEMINI_API_KEY: Required for server-side capabilities
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL where Sanctum Live is hosted
APP_URL="http://localhost:3000"

# API_PORT: Express API port used by Vite's /api proxy in local development
API_PORT="3001"

# Database Configuration (PostgreSQL / Prisma)
# Missing DATABASE_URL does not crash the app; GET /api/health reports database: unavailable
DATABASE_URL="postgresql://user:password@localhost:5432/sanctum_live?schema=public"

# Auth Secrets
AUTH_SECRET="your-32-character-secret-key-for-session-tokens"

# -------------------------------------------------------------
# Clerk (dashboard sessions)
# Prisma stores memberships. Clerk mints the signed-in session.
# Without these keys, /dashboard cannot authenticate.
# Sign in with a seeded membership email, e.g. kenneth@miraclecenter.org
# -------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxx"
CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxx"

# -------------------------------------------------------------
# LiveKit Real-Time Media Engine (server-only)
# LIVEKIT_API_SECRET must never be exposed to the Vite client.
# Missing values do not crash the app; health reports livekit: unavailable
# -------------------------------------------------------------
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="APIxxxxxxxxx"
LIVEKIT_API_SECRET="Qsboy951owg0qa6Iyq2EK44GxohyOc8587CsbN9mpSL"

# -------------------------------------------------------------
# Operator live proof (Dawn Intercession)
# Do not treat the UI as live until these have actually been applied
# against the Postgres instance in DATABASE_URL. This repo does not
# apply migrate/seed for you.
#
#   npx prisma migrate deploy
#   npx prisma db seed
#
# Until that runs, Open Sanctuary / Start Prayer return 403 and there
# are no memberships.
#
# Point LiveKit Cloud webhooks at {APP_URL}/api/livekit/webhooks
# Login only as a seeded email: kenneth@miraclecenter.org
# Open Dawn Intercession (room_dawn_intercession).
#
# HOST/MODERATOR still cannot publish audio. The pastor prays from a
# listener tab after invite. That is correct for 1B.2.
# -------------------------------------------------------------
