# Copy to .env. The same names, with required/optional and which app, are in DEPLOY.md.
# When DEPLOY_ENV is staging or production, the API refuses to boot if a required value is missing.
# Email and Sentry are optional: the process logs once and keeps running.

# Required on Render and Vercel when this host is deployed. Leave unset for local development.
# DEPLOY_ENV=staging

# Required on Render. Pooled Postgres URL. Both query params are required.
DATABASE_URL="postgresql://user:password@pooler.example/sanctum_live?sslmode=require&connection_limit=10&pool_timeout=20"

# Required on Render. Comma-separated site origins for CORS. Localhost is ignored when NODE_ENV=production.
PUBLIC_SITE_ORIGINS="http://127.0.0.1:3002"
# Required on Render. Church website. GET / on Sanctum redirects here in church mode.
PUBLIC_SITE_URL="http://127.0.0.1:3002"
# Optional. Used only when PUBLIC_SITE_ORIGINS is unset and DEPLOY_ENV is unset.
SITE_ORIGIN="http://127.0.0.1:3002"

# Optional on Render. church redirects Sanctum home to the website. product keeps the marketing home.
SANCTUM_MODE="church"

# Required on Render. Public Sanctum origin. Staging: https://app-staging.example.org
APP_URL="http://127.0.0.1:3000"
API_PORT="3001"

# Required on Render. Full URL the API POSTs after church content changes.
SITE_REVALIDATE_URL="http://127.0.0.1:3002/api/revalidate"
# Required on Render and Vercel. The same value on both.
REVALIDATE_SECRET="replace-me"
# Required on Render. Sent as x-cron-secret by the YouTube import cron.
CRON_SECRET="replace-me"

# Required on Vercel. Documented here so one example lists every name.
# NEXT_PUBLIC_API_URL="https://app-staging.example.org"
# SANCTUM_APP_URL="https://app-staging.example.org"
# ORG_SLUG="promised-land-christian-center"
# SITE_URL="https://staging.example.org"

# Required on Render. Vite inlines the publishable key. Use the same value for both Clerk publishable names.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_SECRET_KEY="sk_test_replace_me"

# Required on Render. The existing LiveKit Cloud project.
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="replace-me"
LIVEKIT_API_SECRET="replace-me"

# Required on Render.
CLOUDINARY_CLOUD_NAME="replace-me"
CLOUDINARY_API_KEY="replace-me"
CLOUDINARY_API_SECRET="replace-me"

# Optional on Render. Gallery review email stays off until both are set.
RESEND_API_KEY="re_replace_me"
GALLERY_REVIEW_FROM="Promised Land <media@example.org>"

# Optional. Release is RENDER_GIT_COMMIT or VERCEL_GIT_COMMIT_SHA when SENTRY_RELEASE is unset.
SENTRY_DSN="https://public@o0.ingest.sentry.io/0"
VITE_SENTRY_DSN="https://public@o0.ingest.sentry.io/0"
NEXT_PUBLIC_SENTRY_DSN="https://public@o0.ingest.sentry.io/0"
SENTRY_AUTH_TOKEN="replace-me"
SENTRY_ORG="your-org"
SENTRY_PROJECT_API="sanctum-api"
SENTRY_PROJECT_SANCTUM="sanctum-web"
SENTRY_PROJECT_SITE="plcc-site"
# SENTRY_RELEASE=""

# Staging builds may keep unpublished sample rows. Leave unset for production.
# ALLOW_PLACEHOLDER="true"

# Optional local helper.
# GEMINI_API_KEY=""
