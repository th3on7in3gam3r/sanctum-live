{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/check-brand.mjs && tsx scripts/check-deploy-env.ts && tsx scripts/check-sample-content.ts",
    "check:brand": "node scripts/check-brand.mjs",
    "dev": "concurrently -k \"npm run server\" \"vite --port=3000 --host=0.0.0.0\"",
    "server": "tsx server/index.ts",
    "build": "prisma generate && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs --external:@prisma/client --external:@sentry/node && mkdir -p dist/node_modules && rm -rf dist/node_modules/@prisma dist/node_modules/.prisma && cp -R node_modules/@prisma dist/node_modules/ && cp -R node_modules/.prisma dist/node_modules/ && node scripts/upload-server-sourcemap.mjs",
    "postbuild": "node scripts/check-built-copy.mjs dist",
    "smoke": "tsx scripts/smoke.ts",
    "start": "node dist/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:contrast": "playwright test tests/e2e/public-theme.spec.ts",
    "build:extension": "vite build --config extension/vite.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name phase_1b2_audio",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.59",
    "@clerk/react": "^6.14.4",
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "@plcc/brand": "file:./packages/brand",
    "@sentry/node": "^10.22.0",
    "@sentry/react": "^10.22.0",
    "dotenv": "^17.2.3",
    "driver.js": "^1.8.0",
    "express": "^4.21.2",
    "livekit-client": "^2.22.0",
    "livekit-server-sdk": "^2.18.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@sentry/cli": "^2.55.0",
    "@sentry/vite-plugin": "^4.6.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
