# Public site (Next.js on Vercel). See DEPLOY.md for the shared table.
# Required names are checked when DEPLOY_ENV is staging or production.
# Sentry is optional: the build logs once and the site still ships.

# Required on Vercel.
DEPLOY_ENV=
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
SANCTUM_APP_URL=http://127.0.0.1:3000
ORG_SLUG=promised-land-christian-center
REVALIDATE_SECRET=replace-me
SITE_URL=http://127.0.0.1:3002

# Optional. Defaults to ORG_SLUG.
PRAYER_ROOM_SLUG=promised-land-christian-center

# Optional. Browser and server DSNs. Source maps upload only when the token, org, and project are set.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_SITE=plcc-site

# Render-only names. Listed so this file covers the same set as the root example.
# DATABASE_URL is the pooled Postgres URL with connection_limit=10&pool_timeout=20.
# PUBLIC_SITE_ORIGINS, APP_URL, PUBLIC_SITE_URL, SITE_REVALIDATE_URL, CRON_SECRET
# LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET
# CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY, VITE_CLERK_PUBLISHABLE_KEY
# CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
# RESEND_API_KEY, GALLERY_REVIEW_FROM
# VITE_SENTRY_DSN, SENTRY_PROJECT_API, SENTRY_PROJECT_SANCTUM
# ALLOW_PLACEHOLDER=true on the staging Render service only
