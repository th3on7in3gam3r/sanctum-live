{"id":"AMO","name":"Amosi","chapters":[{"number":1,"content":[{"type":"verse","number":1,"content":["Bino bye bigambo Amosi eyali omu ku balunzi b’endiga mu bitundu by’e Tekowa bye yabikkulirwa, musisi amale ajje nga wakayitawo emyaka ebiri, mu mirembe gya Uzziya kabaka wa Yuda, era nga gy’emirembe gya kabaka Yerobowaamu mutabani wa Yowaasi nga y’afuga Isirayiri."]},{"type":"verse","number":2,"content":["Amosi yagamba nti,",{"lineBreak":true},"“Mukama awuluguma ng’asinziira mu Sayuuni,",{"lineBreak":true},"era eddoboozi lye liwulirwa nga libwatukira mu Yerusaalemi;",{"lineBreak":true},"omuddo mu malundiro gulikala",{"lineBreak":true},"n’entikko y’olusozi Kalumeeri erisigala njereere.”"]},{"type":"heading","content":["Okulamulwa kwa Baliraanwa ba Isirayiri"]},{"type":"verse","number":3,"content":["Bw’ati bw’ayogera Mukama nti,",{"lineBreak":true},"“Olw’ebyonoono bya Ddamasiko ebisatu,",{"lineBreak":true},"weewaawo ebina, siriggyawo busungu bwange.",{"lineBreak":true},"Kubanga baabonereza nnyo abantu b’e Gireyaadi",{"lineBreak":true},"nga babasalaasala n’ebyuma."]},{"type":"verse","number":4,"content":["Ndiweereza omuliro mu lubiri lwa kabaka Kazayeeri",{"lineBreak":true},"era njokye n’ebigo bya kabaka Benikadadi."]},{"type":"verse","number":5,"content":["Era ndimenya enzigi z’ekibuga Ddamasiko",{"lineBreak":true},"era ndizikiriza kabaka ali mu Kiwonvu ky’e Aveni,",{"lineBreak":true},"oyo akwata omuggo ogw’obwakabaka mu Besiadeni.",{"lineBreak":true},"Abantu b’e Busuuli balitwalibwa mu buwaŋŋanguse mu Kiri,”",{"lineBreak":true},"bw’ayogera Mukama."]},{"type":"verse","number":6,"content":["Bw’ati bw’ayogera Mukama nti,",{"lineBreak":true},"“Olw’ebyonoono bya Gaza ebisatu,",{"lineBreak":true},"weewaawo ebina, siriggyawo busungu bwange.",{"lineBreak":true},"Kubanga yatwala eggwanga ddamba mu busibe",{"lineBreak":true},"n’alitunda eri Edomu."]},{"type":"verse","number":7,"content":["Ndiweereza omuliro ku bbugwe wa Gaza",{"lineBreak":true},"ogulyokya ebigo byakyo."]},{"type":"verse","number":8,"content":["Ndizikiriza atuula mu Asudodi,",{"lineBreak":true},"n’oyo akwata omuggo gw’obwakabaka ndimumalawo okuva mu Asukulooni.",{"lineBreak":true},"Ndibonereza Ekuloni",{"lineBreak":true},"okutuusa lwe ndimalirawo ddala Abafirisuuti,”",{"lineBreak":true},"bw’ayogera Mukama."]},{"type":"verse","number":9,"content":["Mukama bw’ati bw’ayogera nti,",{"lineBreak":true},"“Olw’ebyonoono bya Ttuulo ebisatu,",{"lineBreak":true},"weewaawo ebina, siriggyawo busungu bwange.",{"lineBreak":true},"Kubanga yatunda eggwanga ddamba erya Edomu mu busibe",{"lineBreak":true},"n’amenya endagaano ey’obwaseruganda eyali ekoleddwa,"]},{"type":"verse","number":10,"content":["kyenaava mpeereza omuliro ku bbugwe wa Ttuulo,",{"lineBreak":true},"ogunaayokya ebigo byakyo.”"]},{"type":"verse","number":11,"content":["Bw’ati bw’ayogera Mukama nti,",{"lineBreak":true},"“Olw’ebyonoono bya Edomu ebisatu,",{"lineBreak":true},"weewaawo ebina, siriggyawo busungu bwange.",{"lineBreak":true},"Kubanga yayigganya muganda we n’ekitala",{"lineBreak":true},"awatali kusaasira,",{"lineBreak":true},"obusungu bwabwe ne bubuubuuka obutakoma",{"lineBreak":true},"era ne batabusalako."]},{"type":"verse","number":12,"content":["Ndiweereza omuliro ku Temani",{"lineBreak":true},"oguliyokya ebigo bya Bozula.”"]},{"type":"verse","number":13,"content":["Bw’ati bw’ayogera Mukama nti,",{"lineBreak":true},"“Olw’ebyonoono bya Amoni ebisatu",{"lineBreak":true},"weewaawo ebina, siriggyawo busungu bwange.",{"lineBreak":true},"Mu ntalo ez’okugaziya ensi ye,",{"lineBreak":true},"yabaaga abakazi abaali embuto ab’e Giriyaadi."]},{"type":"verse","number":14,"content":["Ndiweereza omuliro ku bbugwe wa Labba,",{"lineBreak":true},"era gulyokya ebigo byakyo.",{"lineBreak":true},"Walibaawo n’oluyoogaano olunene ku lunaku olw’olutalo",{"lineBreak":true},"mu mpewo ey’amaanyi, kibuyaga ng’akunta."]},{"type":"verse","number":15,"content":["Kabaka waakyo alitwalibwa mu buwaŋŋanguse,",{"lineBreak":true},"ye n’abakungu be bonna,”",{"lineBreak":true},"bw’ayogera Mukama."]}],"footnotes":[]},{"number":2,"content":[{"type":"verse","number":1,"content":["Bw’ati bw’ayogera Mukama nti,",{"lineBreak":true},"“Olw’ebyonoono bya Mowaabu ebisatu",{"lineBreak":true},"weewaawo ebina, siriggyawo busungu bwange.",{"lineBreak":true},"Kubanga yayokya amagumba ga kabaka wa Edomu",{"lineBreak":true},"ne gafuuka evvu."]},{"type":"verse","number":2,"content":["Ndiweereza omuliro ku Mowaabu",{"lineBreak":true},"era gulyokya ebigo bya Keriyoosi.",{"lineBreak":true},"Abantu ba Mowaabu balifiira",{"lineBreak":true},"wakati mu kusasamala okungi omuliba okuleekaana n’okufuuwa amakondeere."]},{"type":"verse","number":3,"content":["Ndizikiriza omukulembeze wa Mowaabu",{"lineBreak":true},"n’abakungu baamu bonna, ndibatta,”",{"lineBreak":true},"bw’ayogera Mukama."]},{"type":"verse","number":4,"content":["Bw’ati bw’ayogera Mukama nti,",{"lineBreak":true},"“Olw’ebyonoono bya Yuda ebisatu",{"lineBreak":true},"weewaawo ebina, siriggyawo busungu bwange.",{"lineBreak":true},"Kubanga banyoomye amateeka ga Mukama,",{"lineBreak":true},"ne batakuuma biragiro bye nabawa",{"lineBreak":true},"ne bagondera bakatonda ab’obulimba",{"lineBreak":true},"bajjajjaabwe be baagobereranga."]},{"type":"verse","number":5,"content":["Ndiweereza omuliro ku Yuda",{"lineBreak":true},"ne njokya ebigo bya Yerusaalemi.”"]},{"type":"verse","number":6,"content":["Bw’ati bw’ayogera Mukama nti,",{"lineBreak":true},"“Olw’ebyonoono bya Isirayiri ebisatu",{"lineBreak":true},"weewaawo ebina, siriggyawo busungu bwange.",{"lineBreak":true},"Batunda obutuukirivu bafune ffeeza,",{"lineBreak":true},"ne batunda n’abaavu olw’omugogo gw’engatto."]},{"type":"verse","number":7,"content":["Balinnyiririra emitwe gy’abaavu",{"lineBreak":true},"mu nfuufu,",{"lineBreak":true},"n’abajoogebwa ne batalamulwa mu bwenkanya.",{"lineBreak":true},"Omwana ne kitaawe bayingira eri omuwala omu",{"lineBreak":true},"ne boonoona erinnya lyange."]},{"type":"verse","number":8,"content":["Bagalamira okumpi ne buli kyoto",{"lineBreak":true},"ku ngoye ezaweebwayo ng’obweyamo.",{"lineBreak":true},"Mu nnyumba ya bakatonda baabwe",{"lineBreak":true},"mwe banywera omwenge oguleetebwa abatanziddwa."]},{"type":"verse","number":9,"content":["“Nazikiriza Abamoli ku lwabwe",{"lineBreak":true},"newaakubadde nga baali bawanvu ng’emivule",{"lineBreak":true},"era nga ba maanyi ng’emyera.",{"lineBreak":true},"Nazikiriza ebibala ebyali waggulu",{"lineBreak":true},"okutuuka ku mirandira egyali wansi."]},{"type":"verse","number":10,"content":["Nakuggya mu nsi y’e Misiri,",{"lineBreak":true},"ne nkukulemberera emyaka amakumi ana mu ddungu,",{"lineBreak":true},"weetwalire ensi y’Abamoli."]},{"type":"verse","number":11,"content":["“Nayimusa abamu ku batabani bammwe okubeera bannabbi,",{"lineBreak":true},"ne ku balenzi bammwe okuba Abawonge ba Mukama.",{"lineBreak":true},"Si bwe kiri bwe kityo abantu ba Isirayiri?”",{"lineBreak":true},"bw’ayogera Mukama."]},{"type":"verse","number":12,"content":["“Naye mmwe ne mudda mu kuwa Abawonge ba Mukama omwenge okunywa,",{"lineBreak":true},"ne muwa bannabbi amateeka nga mubagamba nti temuwa byabunnabbi."]},{"type":"verse","number":13,"content":["“Laba, ndibasesebbula",{"lineBreak":true},"ng’eggaali eryettisse ebinywa by’emmere ey’empeke bwe lisesebbula ekiri mu kkubo lyalyo."]},{"type":"verse","number":14,"content":["Abanguwa tebaliwona,",{"lineBreak":true},"n’ab’amaanyi tebalikuŋŋaanya maanyi gaabwe",{"lineBreak":true},"era n’omuzira nnamige talisobola kuwonya bulamu bwe."]},{"type":"verse","number":15,"content":["Omukubi w’obusaale omukugu taliyimirira kunywera,",{"lineBreak":true},"n’omuserikale ow’ebigere nnakinku talisobola kuwenyuka.",{"lineBreak":true},"Abo abasajja abazira abeebagazi b’embalaasi tebalisobola kuwonya bulamu bwabwe."]},{"type":"verse","number":16,"content":["Ku lunaku olwo abalwanyi abazira nnamige",{"lineBreak":true},"balidduka bukunya!”",{"lineBreak":true},"bw’atyo bw’ayogera Mukama."]}],"footnotes":[]},{"number":3,"content":[{"type":"heading","content":["Okulabula Abantu ba Isirayiri"]},{"type":"verse","number":1,"content":["Muwulire ekigambo kino Mukama ky’aboogerako mmwe abaana ba Isirayiri, ennyumba yonna gye naggya mu Misiri."]},{"type":"verse","number":2,"content":["“Mu bantu bonna abali ku nsi,",{"lineBreak":true},"mmwe mwekka be nalonda.",{"lineBreak":true},"Kyendiva mbabonereza",{"lineBreak":true},"olw’ebibi byammwe byonna.”"]},{"type":"verse","number":3,"content":["Abantu ababiri bayinza okutambulira awamu",{"lineBreak":true},"wabula nga bakkiriziganyizza?"]},{"type":"verse","number":4,"content":["Empologoma ewulugumira mu kisaka",{"lineBreak":true},"nga terina muyiggo?",{"lineBreak":true},"Empologoma ento ekaabira mu mpuku yaayo",{"lineBreak":true},"nga teriiko ky’ekutte?"]},{"type":"verse","number":5,"content":["Akanyonyi kayinza okugwa mu mutego",{"lineBreak":true},"nga tewali kikasikirizza?",{"lineBreak":true},"Omutego gumasuka",{"lineBreak":true},"nga teguliiko kye gukwasizza?"]},{"type":"verse","number":6,"content":["Akagombe kavugira mu kibuga",{"lineBreak":true},"abantu ne batatya?",{"lineBreak":true},"Akabenje kagwa mu kibuga",{"lineBreak":true},"nga Mukama si y’akaleese?"]},{"type":"verse","number":7,"content":["Naye ddala Mukama Katonda takola kintu kyonna",{"lineBreak":true},"nga tasoose kukibikkulira",{"lineBreak":true},"baweereza be, bannabbi."]},{"type":"verse","number":8,"content":["Empologoma ewulugumye,",{"lineBreak":true},"ani ataatye?",{"lineBreak":true},"Mukama Katonda ayogedde",{"lineBreak":true},"ani ataawe bubaka bwe?"]},{"type":"verse","number":9,"content":["Langirira eri ebigo by’e Asudodi",{"lineBreak":true},"n’eri ebigo by’e Misiri nti,",{"lineBreak":true},"“Mujje mukuŋŋaanire ku nsozi z’e Samaliya",{"lineBreak":true},"mulabe akajagalalo akanene akali eyo",{"lineBreak":true},"n’abantu be nga bwe bajoogebwa.”"]},{"type":"verse","number":10,"content":["Mukama agamba nti, “Abantu abajjuzza",{"lineBreak":true},"ebigo byabwe n’ebintu ebinyage,",{"lineBreak":true},"tebamanyi kukola kituufu.”"]},{"type":"verse","number":11,"content":["Noolwekyo bw’ati bw’ayogera Mukama Katonda nti,",{"lineBreak":true},"“Omulabe alirumba ensi,",{"lineBreak":true},"n’amenyaamenya ebigo byo eby’amaanyi",{"lineBreak":true},"era n’abinyagulula.”"]},{"type":"verse","number":12,"content":["Bw’ati bw’ayogera Mukama nti,",{"lineBreak":true},"“Ng’omusumba bw’agezaako okutaasa endiga ye okuva mu kamwa k’empologoma",{"lineBreak":true},"n’asikayo amagulu abiri obubiri n’ekitundu ky’okutu,",{"lineBreak":true},"bwe batyo Abayisirayiri bwe balinunulibwa,",{"lineBreak":true},"abo abatuula mu Samaliya",{"lineBreak":true},"ku nkomerero y’ebitanda byabwe",{"lineBreak":true},"ne ku bitanda byabwe mu Ddamasiko."]},{"type":"verse","number":13,"content":["“Muwulirize kino era mulumirize enju ya Yakobo yonna,” bw’ayogera Mukama Katonda Ayinzabyonna."]},{"type":"verse","number":14,"content":["“Ku lunaku lwe lumu lwe ndibonereza Isirayiri olw’ebibi bye,",{"lineBreak":true},"ndisaanyaawo ebyoto by’e Beseri,",{"lineBreak":true},"n’amayembe g’ekyoto galisalibwako",{"lineBreak":true},"ne gagwa wansi."]},{"type":"verse","number":15,"content":["Era ndisaanyaawo ennyumba ebeerwamu mu biseera eby’obutiti,",{"lineBreak":true},"awamu n’ennyumba ebeerwamu mu biseera ey’ebbugumu;",{"lineBreak":true},"era ndimenyaamenya n’ennyumba ezayolebwa n’amasanga,",{"lineBreak":true},"ne nsanyaawo n’embiri,”",{"lineBreak":true},"bw’ayogera Mukama."]}],"footnotes":[]},{"number":4,"content":[{"type":"heading","content":["Katonda Yeerayirira Okuzikiriza Abantu"]},{"type":"verse","number":1,"content":["Muwulire kino mmwe ente ez’omu Basani ezibeera ku Lusozi Samaliya,",{"lineBreak":true},"mmwe abakazi abajooga abaavu ne munyigiriza abanaku,",{"lineBreak":true},"era abagamba ba bbaabwe nti, “Mutuletereyo ekyokunywa.”"]},{"type":"verse","number":2,"content":["Mu butukuvu bwe Mukama Katonda alayidde nti,",{"lineBreak":true},"“Ekiseera kijja",{"lineBreak":true},"lwe balibasika n’amalobo,",{"lineBreak":true},"era abalisembayo ku mmwe ne basikibwa n’amalobo agavuba."]},{"type":"verse","number":3,"content":["Mulisikibwa okuva mu mayumba gammwe",{"lineBreak":true},"ne musuulibwa ebweru nga muyisibwa mu bituli ebibotoddwa mu bbugwe,",{"lineBreak":true},"musuulibwe ku Kalumooni,",{"lineBreak":true},"bw’ayogera Mukama."]},{"type":"verse","number":4,"content":["Kale mmwe mugende e Beseri mukoleyo ebitasaana;",{"lineBreak":true},"era mugende ne Girugaali mwongere okukola ebibi.",{"lineBreak":true},"Mutwalengayo ssaddaaka zammwe buli nkya,",{"lineBreak":true},"n’ekimu eky’ekkumi buli myaka esatu."]},{"type":"verse","number":5,"content":["Muweeyo ekiweebwayo eky’okwebaza eky’emigaati egizimbulukusibbwa,",{"lineBreak":true},"mulangirire n’ebiweebwayo eby’ekyeyagalire;",{"lineBreak":true},"mwe mwenyumiririza, mmwe Abayisirayiri",{"lineBreak":true},"kubanga ekyo kye mwagala,”",{"lineBreak":true},"bw’ayogera Mukama Katonda Ayinzabyonna."]},{"type":"verse","number":6,"content":["“Nabaleetera enjala embuto zammwe ne ziba njereere mu buli kibuga,",{"lineBreak":true},"ne ssibawa kyakulya mu buli kabuga,",{"lineBreak":true},"naye era ne mugaana okudda gye ndi,”",{"lineBreak":true},"bw’ayogera Mukama."]},{"type":"verse","number":7,"content":["“Ne mbamma enkuba",{"lineBreak":true},"ng’ekyabulayo emyezi esatu amakungula gatuuke.",{"lineBreak":true},"Ne ntonnyesa enkuba mu kibuga ekimu",{"lineBreak":true},"ne ngiziyiza mu kirala.",{"lineBreak":true},"Yatonnyanga mu nnimiro emu,",{"lineBreak":true},"mu ndala n’etatonnya, ebirime ne biwotoka."]},{"type":"verse","number":8,"content":["Abantu ne bavanga mu kibuga ekimu ne balaga mu kirala nga banoonya amazzi banyweko,",{"lineBreak":true},"naye ne gababula;",{"lineBreak":true},"naye era ne mutakyuka kudda gye ndi,”",{"lineBreak":true},"bw’ayogera Mukama."]},{"type":"verse","number":9,"content":["“Emirundi mingi ebirime byammwe n’ennimiro zammwe ez’emizabbibu na bigengewaza.",{"lineBreak":true},"Nabileetako obulwadde.",{"lineBreak":true},"Enzige nazo ne zirya emitiini gyammwe n’emizeeyituuni gyammwe,",{"lineBreak":true},"naye era temwadda gye ndi,”",{"lineBreak":true},"bw’ayogera Mukama."]},{"type":"verse","number":10,"content":["“Nabasindikira kawumpuli",{"lineBreak":true},"nga gwe nasindika mu Misiri.",{"lineBreak":true},"Abavubuka bammwe ne mbattira mu lutalo n’ekitala",{"lineBreak":true},"awamu n’embalaasi zammwe ze mwawamba.",{"lineBreak":true},"Okuwunya kw’olusisira lwammwe ne kuyitirira nnyo",{"lineBreak":true},"naye era ne mugaana okudda gye ndi,”",{"lineBreak":true},"bw’ayogera Mukama."]},{"type":"verse","number":11,"content":["“Nazikiriza abamu ku mmwe",{"lineBreak":true},"nga bwe nakola Sodomu ne Ggomola,",{"lineBreak":true},"ne muba ng’olumuli olusikiddwa mu muliro ogwaka",{"lineBreak":true},"naye era ne mulema okudda gye ndi,”",{"lineBreak":true},"bw’ayogera Mukama."]},{"type":"verse","number":12,"content":["“Kyendiva nkukola bwe ntyo, ggwe Isirayiri,",{"lineBreak":true},"era ndikwongerako ebibonoobono.",{"lineBreak":true},"Noolwekyo weetegeke okusisinkana Katonda wo, ggwe Isirayiri.”"]},{"type":"verse","number":13,"content":["Kubanga laba, oyo eyatonda ensozi",{"lineBreak":true},"era ye yatonda n’embuyaga",{"lineBreak":true},"era abikkulira omuntu ebirowoozo bye.",{"lineBreak":true},"Yafuula enkya okubeera ekiro,",{"lineBreak":true},"era alinnya mu bifo ebigulumivu eby’ensi.",{"lineBreak":true},"Mukama Katonda ow’Eggye lye linnya lye."]}],"footnotes":[]},{"number":5,"content":[{"type":"heading","content":["Okukuba Omulanga ogw’Okukungubaga n’Okwenenya mu Isirayiri"]},{"type":"verse","number":1,"content":["Muwulirize mmwe abantu ba Isirayiri ekigambo kino eky’ennaku ekibakwatako."]},{"type":"verse","number":2,"content":["“Isirayiri embeerera agudde",{"lineBreak":true},"obutayimuka nate.",{"lineBreak":true},"Bamwabulidde",{"lineBreak":true},"era tewali amuyimusa.”"]},{"type":"verse","number":3,"content":["Bw’ati bw’ayogera Mukama Katonda nti,",{"lineBreak":true},"“Ekibuga ekiyungula abalwanyi olukumi okugenda mu lutalo",{"lineBreak":true},"kirisigazaawo kikumi bokka,",{"lineBreak":true},"n’ekyo ekiweereza ekikumi,",{"lineBreak":true},"kirizza kkumi bokka!”"]},{"type":"verse","number":4,"content":["Bw’ati bw’ayogera Mukama eri ennyumba ya Isirayiri nti,",{"lineBreak":true},"“Munnoonye kale munaabanga balamu."]},{"type":"verse","number":5,"content":["Temunnoonyeza Beseri",{"lineBreak":true},"so temulaga Girugaali",{"lineBreak":true},"wadde okulaga e Beeruseba.",{"lineBreak":true},"Kubanga abantu b’e Girugaali balitwalibwa mu buwaŋŋanguse",{"lineBreak":true},"era ne Beseri kiriggwaawo.”"]},{"type":"verse","number":6,"content":["Munoonye Mukama munaabanga balamu",{"lineBreak":true},"aleme okubuubuuka ng’omuliro ku nnyumba ya Yusufu;",{"lineBreak":true},"guligyokya",{"lineBreak":true},"nga tewali wa kuguzikiza mu Beseri."]},{"type":"verse","number":7,"content":["Mmwe abantu ba Isirayiri abafuula obwenkanya okuba eky’okufumwa obufumwa",{"lineBreak":true},"mutulugunya obutuukirivu."]},{"type":"verse","number":8,"content":["Oyo eyakola ettendo eriri mu mmunyeenye ezaaka ng’ebizungirizi",{"lineBreak":true},"era afuula ekisiikirize okubeera enkya",{"lineBreak":true},"era akyusa obudde ne buva mu kitangaala ne bufuuka ekiro,",{"lineBreak":true},"ayita amazzi g’omu nnyanja",{"lineBreak":true},"ne gafukirira ensi ng’enkuba,",{"lineBreak":true},"Mukama lye linnya lye."]},{"type":"verse","number":9,"content":["Okutemya n’okuzibula aleeta okuzikirira ku b’amaanyi",{"lineBreak":true},"era n’asaanyaawo ebibuga ebiriko ebigo."]},{"type":"verse","number":10,"content":["Mukyawa abalamuzi abasalawo mu bwenkanya",{"lineBreak":true},"era munyooma n’abo aboogera amazima."]},{"type":"verse","number":11,"content":["Olinnyirira omwavu,",{"lineBreak":true},"n’omuwaliriza okukuwa emmere ey’empeke.",{"lineBreak":true},"Newaakubadde nga mwezimbidde amayumba ag’amayinja,",{"lineBreak":true},"temuligabeeramu;",{"lineBreak":true},"era newaakubadde nga mwesimbidde ennimiro z’emizabbibu ennungi,",{"lineBreak":true},"temulinywa ku wayini waamu."]},{"type":"verse","number":12,"content":["Ebibi byammwe mbimanyi,",{"lineBreak":true},"nga bingi ate nga bisasamaza.",{"lineBreak":true},"Munyigiriza omutuukirivu ne mulya n’enguzi,",{"lineBreak":true},"abaavu temubasalira musango mu bwenkanya."]},{"type":"verse","number":13,"content":["Noolwekyo oyo alina amagezi kyaliva asirika obusirisi mu biseera ng’ebyo",{"lineBreak":true},"kubanga ennaku mbi."]},{"type":"verse","number":14,"content":["Munoonyenga okukola obulungi, so si obubi",{"lineBreak":true},"munaabeeranga balamu!",{"lineBreak":true},"Bw’atyo Mukama Katonda ow’Eggye anaabeeranga mubeezi wammwe",{"lineBreak":true},"nga bulijjo bwe mumuyita."]},{"type":"verse","number":15,"content":["Mukyawe ekibi, mwagalenga ekirungi",{"lineBreak":true},"era embuga z’amateeka zibeerengamu obwenkanya.",{"lineBreak":true},"Oboolyawo Mukama Katonda ow’Eggye anaabakwatirwa ekisa",{"lineBreak":true},"abantu abo abaasigalawo ku Yusufu."]},{"type":"verse","number":16,"content":["Noolwekyo bw’ati bw’ayogera Mukama Katonda ow’Eggye nti,",{"lineBreak":true},"“Walibeerawo okwaziirana mu nguudo",{"lineBreak":true},"n’okukaaba mu buli kibangirizi eky’omu kibuga.",{"lineBreak":true},"N’abalimi baliyitibwa, bakaabe,",{"lineBreak":true},"n’abakungubazi bakube ebiwoobe."]},{"type":"verse","number":17,"content":["Walibaawo okukaaba mu buli nnimiro ya mizabbibu",{"lineBreak":true},"kubanga nzija okuyita wakati mu mmwe.”"]},{"type":"verse","number":18,"content":["Zibasanze mmwe abasuubira",{"lineBreak":true},"olunaku lwa Mukama.",{"lineBreak":true},"Lwaki mwesunga olunaku lwa Mukama?",{"lineBreak":true},"Olunaku olwo luliba kizikiza so si kitangaala."]},{"type":"verse","number":19,"content":["Olunaku olwo lulibeera ng’omusajja adduka empologoma",{"lineBreak":true},"n’asisinkana eddubu,",{"lineBreak":true},"bw’aba ng’ayingira mu nnyumba",{"lineBreak":true},"ne yeekwata ku kisenge,",{"lineBreak":true},"ate n’abojjebwa omusota."]},{"type":"verse","number":20,"content":["Olunaku lwa Mukama, teruliba kizikiza awatali kitangaala n’akatono,",{"lineBreak":true},"ng’ekizikiza ekikutte ennyo?"]},{"type":"verse","number":21,"content":["Nkyawa, era nnyooma embaga zammwe n’emikolo gyammwe egy’eddiini",{"lineBreak":true},"so sisanyukira kukuŋŋaana kwammwe."]},{"type":"verse","number":22,"content":["Weewaawo, ne bwe munaawaayo gye ndi ebiweebwayo byammwe ebyokebwa n’ebiweebwayo eby’emmere ey’empeke,",{"lineBreak":true},"sijja kubikkiriza.",{"lineBreak":true},"Ne bwe mulireeta ebiweebwayo olw’emirembe ebisinga obulungi,",{"lineBreak":true},"siribikkiriza."]},{"type":"verse","number":23,"content":["Muggyeewo ennyimba zammwe ez’okutendereza.",{"lineBreak":true},"Siriwuliriza na bivuga ng’entongooli zammwe."]},{"type":"verse","number":24,"content":["Kye njagala okulaba ge mazima n’obwenkanya nga bikulukuta ng’amazzi,",{"lineBreak":true},"n’obutuukirivu nga bukulukuta ng’omugga ogw’amaanyi."]},{"type":"verse","number":25,"content":["“Mwandeeteranga ssaddaaka n’ebiweebwayo mu ddungu",{"lineBreak":true},"emyaka gyonna amakumi ana, ggw’ennyumba ya Isirayiri?"]},{"type":"verse","number":26,"content":["Muyimusizza essabo lya kabaka wammwe,",{"lineBreak":true},"amaanyi ga bakatonda bammwe,",{"lineBreak":true},"n’emmunyeenye ya katonda wammwe,",{"lineBreak":true},"bye mwekolera mmwe."]},{"type":"verse","number":27,"content":["Kyendiva mbawaŋŋangusa okusukka Ddamasiko,”",{"lineBreak":true},"bw’ayogera Mukama, ayitibwa Katonda Ayinzabyonna."]}],"footnotes":[]},{"number":6,"content":[{"type":"heading","content":["Mukama Anenya Abali mu Mirembe"]},{"type":"verse","number":1,"content":["Zibasanze abo abateefiirayo mu Sayuuni,",{"lineBreak":true},"n’abo abawulira emirembe ku lusozi lw’e Samaliya.",{"lineBreak":true},"Mmwe abasajja abeekitiibwa ab’ensi enkulembeze,",{"lineBreak":true},"abantu ba Isirayiri gye beeyuna."]},{"type":"verse","number":2,"content":["Mugende mulabe e Kalune;",{"lineBreak":true},"muveeyo mulage mu Kamasi ekikulu,",{"lineBreak":true},"ate era muserengete mu kibuga ky’Abafirisuuti eky’e Gaasi.",{"lineBreak":true},"Basinga obwakabaka bwammwe obubiri?",{"lineBreak":true},"Ensi yaabwe esinga eyammwe obunene?"]},{"type":"verse","number":3,"content":["Mulindiriza olunaku olw’ekibi,",{"lineBreak":true},"ate ne musembeza effugabbi."]},{"type":"verse","number":4,"content":["Mugalamira ku bitanda ebyakolebwa mu masanga",{"lineBreak":true},"ne muwummulira mu ntebe ennyonvu",{"lineBreak":true},"nga muvaabira ennyama y’endiga",{"lineBreak":true},"n’ey’ennyana ensava."]},{"type":"verse","number":5,"content":["Mwekubira ennanga nga Dawudi bwe yakolanga,",{"lineBreak":true},"ne muyiiya n’ennyimba ku bivuga."]},{"type":"verse","number":6,"content":["Mwekatankira wayini,",{"lineBreak":true},"ne mwesiiga n’ebizigo ebirungi,",{"lineBreak":true},"naye temukaabira kubonaabona kwa Yusufu."]},{"type":"verse","number":7,"content":["Noolwekyo mmwe mulisooka okugenda mu buwaŋŋanguse.",{"lineBreak":true},"Era embaga zammwe n’okwewummuza birikoma."]},{"type":"verse","number":8,"content":["Mukama Katonda ow’Eggye alayidde, Mukama Katonda Ayinzabyonna agamba nti,",{"lineBreak":true},"“Neetamiddwa amalala ga Yakobo,",{"lineBreak":true},"nkyawa ebigo bye,",{"lineBreak":true},"era nzija kuwaayo ekibuga",{"lineBreak":true},"ne byonna ebikirimu eri abalabe baakyo.”"]},{"type":"verse","number":9,"content":["Era singa ennyumba eneeba ekyalinawo abasajja ekkumi abasigaddewo, nabo balifa."]},{"type":"verse","number":10,"content":["Era singa ow’ekika akola ku by’okuziika, anaaba afulumya amagumba n’abuuza oba waliwo omuntu yenna eyeekwese munda mu nnyumba, oba alina gwe yeekwese naye, n’addamu nti, “Nedda,” olwo omuziisi anaamusirisa ng’agamba nti, “Sirika; tetwogera ku linnya lya Mukama.”"]},{"type":"verse","number":11,"content":["Laba Mukama alagidde,",{"lineBreak":true},"ennyumba ennene erimenyebwamenyebwa,",{"lineBreak":true},"n’ennyumba entono erimenyebwamenyebwa."]},{"type":"verse","number":12,"content":["Kisoboka embalaasi okuddukira ku mayinja?",{"lineBreak":true},"Waali wabaddewo abalima ku mayinja n’enkumbi ezisikibwa ente?",{"lineBreak":true},"Naye obwenkanya mubufudde obutwa",{"lineBreak":true},"n’ekibala eky’obutuukirivu ne mukifuula ekikaawa."]},{"type":"verse","number":13,"content":["Mwenyumiririza bwereere nti muli b’amaanyi olw’okuba nga mwawamba ekibuga Lodeba.",{"lineBreak":true},"Mwogera nti, “Tetwawamba Kanayimu n’amaanyi gaffe?”"]},{"type":"verse","number":14,"content":["Mukama Katonda ow’Eggye agamba nti,",{"lineBreak":true},"“Ndibasindikira eggwanga libalumbe, mmwe ennyumba ya Isirayiri;",{"lineBreak":true},"liribajooga ebbanga lyonna",{"lineBreak":true},"okuva e Lebo Kamasi okutuuka mu kiwonvu kye Alaba.”"]}],"footnotes":[]},{"number":7,"content":[{"type":"heading","content":["Okwolesebwa ku by’Omusango"]},{"type":"verse","number":1,"content":["Bino Mukama Katonda bye yandaga. Yali ateekateeka ebibinja by’enzige okusaanyaawo ebirime ebyalimwanga, nga baakakungula olukungula olusooka ssinziggu, kabaka kw’afuna omusolo."]},{"type":"verse","number":2,"content":["Enzige bwe zaalya buli kantu akaali mu nnimiro akalamu, ne nkaaba nti, “Mukama Katonda, sonyiwa abantu bo nkwegayiridde. Yakobo aliwona atya? Nga mutono nnyo.”"]},{"type":"verse","number":3,"content":["Mukama bwe yawulira okukaaba kuno n’akyusa ekirowoozo kye.  N’agamba nti, “Ekyo tekiribaawo.”"]},{"type":"verse","number":4,"content":["Bino Mukama bye yayongera okundaga. Yali ategeka okubonereza abantu n’omuliro. Gwalya ennyanja eyali wansi w’ensi ne gumalawo n’olukalu."]},{"type":"verse","number":5,"content":["Ne nkaaba nti, “Ayi Mukama Katonda nkwegayiridde osonyiwe abantu bo! Yakobo anaasobola atya okusigalawo? Nga mutono nnyo!”"]},{"type":"verse","number":6,"content":["Awo Mukama bwe yawulira okukaaba kuno, n’akyusa ekirowoozo kye.  Era n’agamba nti, “Era n’ekyo tekijja kubeerawo.”"]},{"type":"verse","number":7,"content":["Ate Mukama n’andaga okwolesebwa okulala. Ne ndaba Mukama ng’ayimiridde ku bbugwe azimbiddwa obulungi nga yatereera era nga Mukama akutte bbirigi mu mukono gwe."]},{"type":"verse","number":8,"content":["Mukama n’ambuuza nti, “Amosi, kiki ky’olaba?”  Ne nziramu nti, “Ndaba bbirigi.”  Mukama n’alyoka aŋŋamba nti, “Laba nteese bbirigi wakati mu bantu bange Isirayiri. Sijja kuddayo kukyusa kirowoozo kyange nate ku ky’okubabonereza."]},{"type":"verse","number":9,"content":["“Ebifo ebigulumivu ebya Isaaka birizikirizibwa,",{"lineBreak":true},"n’ebifo bya Isirayiri ebitukuvu birifuuka matongo.",{"lineBreak":true},"N’ennyumba ya Yerobowaamu ndigirwanyisa n’ekitala.”"]},{"type":"heading","content":["Amosi ne Amaziya"]},{"type":"verse","number":10,"content":["Awo Amaziya kabona w’e Beseri n’aweereza kabaka wa Isirayiri, Yerobowaamu, obubaka ng’agamba nti, “Amosi agezaako okukulyamu olukwe wakati mu Isirayiri mwennyini. Ensi teyinza kugumira bigambo bye.”"]},{"type":"verse","number":11,"content":["Bw’ati Amosi bw’ayogera nti,",{"lineBreak":true},"“ ‘Yerobowaamu alifa kitala,",{"lineBreak":true},"ne Isirayiri balitwalibwa mu buwaŋŋanguse",{"lineBreak":true},"bave mu nsi yaboobwe.’ ”"]},{"type":"verse","number":12,"content":["Awo Amaziya n’alyoka alagira Amosi nti, “Vva wano ggwe omulabi",{"noteId":1},". Ddayo mu nsi ya Yuda gy’oba oweera obunnabbi, ofunire eyo omusaala gwo."]},{"type":"verse","number":13,"content":["Toweera wano bunnabbi nate e Beseri kubanga luno lubiri lwa kabaka era ssinzizo lya bwakabaka.”"]},{"type":"verse","number":14,"content":["Amosi n’amuddamu nti, “Saali nnabbi oba omwana wa nnabbi nnali mulunzi wa ndiga era nga ndabirira miti emisukamooli."]},{"type":"verse","number":15,"content":["Naye Mukama yanziggya eyo mu kulunda ekisibo n’aŋŋamba nti, ‘Genda owe obunnabbi abantu bange, Isirayiri.’ ”"]},{"type":"verse","number":16,"content":["Noolwekyo ggwe wuliriza ekigambo kya Mukama. Ogamba nti,",{"lineBreak":true},"“ ‘Towa bunnabbi bunenya Isirayiri,",{"lineBreak":true},"era lekaraawo okubuulira ebikwata ku nnyumba ya Isaaka.’"]},{"type":"verse","number":17,"content":["“Mukama kyava akuddamu nti,",{"lineBreak":true},"“ ‘Mukazi wo alifuuka malaaya mu kibuga",{"lineBreak":true},"era n’abaana bo aboobulenzi n’aboobuwala balifa ekitala.",{"lineBreak":true},"Ettaka lyo lirigabanyizibwamu ne liweebwa abalala",{"lineBreak":true},"naawe kennyini olifiira mu nsi ey’abakafiiri.",{"lineBreak":true},"Ekituufu kiri nti abantu ba Isirayiri balitwalibwa mu buwaŋŋanguse,",{"lineBreak":true},"ne baggyibwa mu nsi yaboobwe.’ ”"]}],"footnotes":[{"noteId":1,"text":"omulabi ye nnabbi","caller":null,"verse":12}]},{"number":8,"content":[{"type":"heading","content":["Ekisero ky’Ebibala"]},{"type":"verse","number":1,"content":["Bino Mukama Katonda bye yandaga. Ne ndaba ekisero ekirimu ebibala ebyengedde."]},{"type":"verse","number":2,"content":["Mukama n’ambuuza nti, “Amosi, kiki ky’olaba?”  Ne muddamu nti, “Ndaba ekisero ky’ebibala ebyengedde.”   Mukama n’alyoka aŋŋamba nti, “Ekiseera eky’okubonereza abaana ba Isirayiri kituuse. Siribasonyiwa nate."]},{"type":"verse","number":3,"content":["“Ku lunaku olwo,” bw’ayogera Mukama Katonda, “okuyimba kw’omu yeekaalu kulifuuka kukungubaga. Walibeerawo okufa okuyitirivu, emirambo nga gibunye wonna. Walibaawo akasiriikiriro.”"]},{"type":"verse","number":4,"content":["Muwulire bino mmwe abalinnyirira abateesobola,",{"lineBreak":true},"era abasaanyaawo abanaku b’omu nsi,"]},{"type":"verse","number":5,"content":["nga mwogera nti,",{"lineBreak":true},"“Ennaku enkulu ez’Omwezi ogwa kaboneka ziggwaako ddi,",{"lineBreak":true},"tulyoke tutunde emmere yaffe ey’empeke,",{"lineBreak":true},"era ne Ssabbiiti eggwaako ddi,",{"lineBreak":true},"tutunde eŋŋaano yaffe?”",{"lineBreak":true},"Mukozesa minzaani enkyamu",{"lineBreak":true},"ne mwongera emiwendo",{"lineBreak":true},"ne mukozesa n’ebipimo ebitatuuse,"]},{"type":"verse","number":6,"content":["mmwe abagula abaavu n’effeeza",{"lineBreak":true},"n’abanaku ne mubagula n’omugogo gw’engatto,",{"lineBreak":true},"ne mutundira ebisaaniiko mu ŋŋaano."]},{"type":"verse","number":7,"content":["Mukama yeeweredde amalala ga Yakobo ng’agamba nti, “Sigenda kwerabira bintu bye bakoze."]},{"type":"verse","number":8,"content":["“Ensi terikankana olw’ekyo,",{"lineBreak":true},"na buli abeeramu n’akungubaga?",{"lineBreak":true},"Ensi yonna eritumbiira ng’omugga Kiyira",{"lineBreak":true},"n’ekka ng’amazzi",{"lineBreak":true},"ag’omugga gw’e Misiri bwe gakola.”"]},{"type":"verse","number":9,"content":["Mukama Katonda agamba nti,",{"lineBreak":true},"“Ku lunaku olwo, enjuba erigwiira mu ttuntu",{"lineBreak":true},"era ensi erikwata ekizikiza emisana ttuku."]},{"type":"verse","number":10,"content":["Embaga zammwe ez’eddini ndizifuula mikolo gya kukungubaga",{"lineBreak":true},"era okuyimba kwammwe kwonna kulifuuka kukaaba.",{"lineBreak":true},"Mwenna nzija kubatuusa ku kwambala ebibukutu",{"lineBreak":true},"n’emitwe gyammwe mugimwe.",{"lineBreak":true},"Olunaku olwo ndilufuula ng’olw’okukungubagira omwana owoobulenzi omu yekka,",{"lineBreak":true},"era n’enkomerero yaabyo ekaayire ddala."]},{"type":"verse","number":11,"content":["“Ekiseera kijja,” bw’ayogera Mukama Katonda,",{"lineBreak":true},"“lwe ndisindika enjala mu nsi yonna,",{"lineBreak":true},"teriba njala ya mmere oba nnyonta y’amazzi,",{"lineBreak":true},"naye eriba enjala y’ekigambo kya Katonda."]},{"type":"verse","number":12,"content":["Abantu balibundabunda okuva ku nnyanja emu okudda ku ndala,",{"lineBreak":true},"bave mu bukiikakkono badde mu bukiikaddyo",{"lineBreak":true},"nga banoonya ekigambo kya Mukama,",{"lineBreak":true},"naye tebalikifuna."]},{"type":"verse","number":13,"content":["“Mu biro ebyo,",{"lineBreak":true},"“abawala ababalagavu n’abalenzi ab’amaanyi",{"lineBreak":true},"balizirika olw’ennyonta."]},{"type":"verse","number":14,"content":["Abo abaalayira eby’ensonyi eby’e Samaliya",{"lineBreak":true},"oba abaayogera nti, ‘Nga katonda wo bw’ali omulamu ggwe Ddaani,’",{"lineBreak":true},"oba nti, ‘Nga katonda w’e Beeruseba bw’ali omulamu,’",{"lineBreak":true},"baligwa obutayimuka nate.”"]}],"footnotes":[]},{"number":9,"content":[{"type":"heading","content":["Okuzikirira kwa Isirayiri"]},{"type":"verse","number":1,"content":["Bwe ntyo nate ne ndaba Mukama ng’ayimiridde ku mabbali g’ekyoto, n’ayogera nti,",{"lineBreak":true},"“Mukube emitwe gy’empagi bya yeekaalu n’amaanyi mangi,",{"lineBreak":true},"emifuubeeto gikankane.",{"lineBreak":true},"Bisesebbuke bikube emitwe gy’abantu bonna,",{"lineBreak":true},"n’abo abaliba bawonyeewo ndibattisa ekitala.",{"lineBreak":true},"Tewaliba n’omu awona."]},{"type":"verse","number":2,"content":["Ne bwe balisima ne baddukira emagombe,",{"lineBreak":true},"omukono gwange gulibaggyayo.",{"lineBreak":true},"Ne bwe balirinnya waggulu mu ggulu",{"lineBreak":true},"ndibawanulayo."]},{"type":"verse","number":3,"content":["Wadde balyekweka ku lusozi Kalumeeri,",{"lineBreak":true},"ndibanoonyaayo ne mbaggyayo.",{"lineBreak":true},"Ne bwe balyekweka wansi mu buziba bw’ennyanja",{"lineBreak":true},"ndiragira ogusota ne gubalumirayo."]},{"type":"verse","number":4,"content":["Ne bwe balitwalibwa abalabe baabwe mu buwaŋŋanguse,",{"lineBreak":true},"era nayo ndiragira ekitala ne kibattirayo.",{"lineBreak":true},"Ndibasimba amaaso",{"lineBreak":true},"ne batuukibwako bibi so si birungi.”"]},{"type":"verse","number":5,"content":["Era Mukama, Mukama ow’Eggye,",{"lineBreak":true},"akwata ku nsi n’esaanuuka,",{"lineBreak":true},"abantu baayo bonna abagibeeramu ne bakungubaga,",{"lineBreak":true},"ensi yonna n’etumbiira nga Kiyira",{"lineBreak":true},"ate n’ekka ng’amazzi g’omugga gw’e Misiri;"]},{"type":"verse","number":6,"content":["oyo eyazimba olubiri lwe olulungi ennyo mu ggulu,",{"lineBreak":true},"omusingi gwalwo ne gubeera ku nsi,",{"lineBreak":true},"ayita amazzi g’ennyanja,",{"lineBreak":true},"n’agayiwa wansi ku lukalu,",{"lineBreak":true},"Mukama lye linnya lye."]},{"type":"verse","number":7,"content":["Mukama ayongera n’agamba nti,",{"lineBreak":true},"“Mmwe abaana ba Isirayiri temuli ng’Abakuusi gye ndi?",{"lineBreak":true},"Ssabaggya mu nsi y’e Misiri",{"lineBreak":true},"nga bwe naggya Abafirisuuti e Katufoli,",{"lineBreak":true},"n’Abasuuli e Kiri?”"]},{"type":"heading","content":["Essuubi lya Isirayiri"]},{"type":"verse","number":8,"content":["“Ddala ddala amaaso ga Mukama Katonda,",{"lineBreak":true},"gatunuulidde nkaliriza obwakabaka obwonoonyi.",{"lineBreak":true},"Ndibuzikiriza ne mbusaasaanya",{"lineBreak":true},"okuva ku nsi.",{"lineBreak":true},"Kyokka sirizikiririza ddala",{"lineBreak":true},"ennyumba ya Yakobo okugimalawo,”",{"lineBreak":true},"bw’ayogera Mukama."]},{"type":"verse","number":9,"content":["“Kubanga ndiwa ekiragiro,",{"lineBreak":true},"ennyumba ya Isirayiri erinyeenyezebwa",{"lineBreak":true},"mu mawanga gonna,",{"lineBreak":true},"ng’emmere ey’empeke bwe kuŋŋutibwa mu kakuŋŋunta",{"lineBreak":true},"era tewaliba kayinja akaligwa wansi."]},{"type":"verse","number":10,"content":["Aboonoonyi bonna mu bantu bange,",{"lineBreak":true},"balifa kitala,",{"lineBreak":true},"abo bonna aboogera nti,",{"lineBreak":true},"‘Akabi tekalitutuukako.’ ”"]},{"type":"heading","content":["Isirayiri Edda Obuggya"]},{"type":"verse","number":11,"content":["“Mu biro ebyo ndizzaawo",{"lineBreak":true},"ennyumba ya Dawudi eyagwa",{"lineBreak":true},"era ndiddaabiriza ebifo ebyamenyebwamenyebwa,",{"lineBreak":true},"ne nzizaawo ebyali amatongo,",{"lineBreak":true},"ne biba nga bwe byabeeranga,"]},{"type":"verse","number":12,"content":["balyoke batwale ekitundu kya Edomu ekyasigalawo",{"lineBreak":true},"n’amawanga gonna ge nayita okuba abantu bange,”",{"lineBreak":true},"bw’ayogera Mukama alikola ebintu ebyo byonna."]},{"type":"verse","number":13,"content":["“Ennaku zijja,” bw’ayogera Mukama,",{"lineBreak":true},"“akungula lw’alisinga asiga,",{"lineBreak":true},"n’asiga ensigo lw’alisinga atunda emizabbibu.",{"lineBreak":true},"Wayini omuggya alitonnya okuva mu nsozi,",{"lineBreak":true},"n’akulukuta okuva mu busozi."]},{"type":"verse","number":14,"content":["Ndikomyawo abantu bange Isirayiri okuva mu buwaŋŋanguse,",{"lineBreak":true},"ne bazimba nate ebibuga ebyamenyebwa, babibeeremu.",{"lineBreak":true},"Balisimba ennimiro zaabwe ez’emizabbibu ne banywa wayini avaamu,",{"lineBreak":true},"era balisimba ennimiro balye ebibala byamu."]},{"type":"verse","number":15,"content":["Ndisimba Isirayiri mu nsi yaabwe,",{"lineBreak":true},"era tebaliggibwa nate",{"lineBreak":true},"mu nsi gye nabawa,”",{"lineBreak":true},"bw’ayogera Mukama Katonda wammwe."]}],"footnotes":[]}]}