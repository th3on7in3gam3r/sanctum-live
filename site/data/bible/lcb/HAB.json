{"id":"HAB","name":"Kaabakuuku","chapters":[{"number":1,"content":[{"type":"verse","number":1,"content":["Buno bwe bubaka bwa Mukama, Kaabakuuku nnabbi bwe yafuna."]},{"type":"heading","content":["Kaabakuuku Yeemulugunya olw’Obutali Bwenkanya"]},{"type":"verse","number":2,"content":["Ayi Mukama, ndituusa ddi okukukaabirira",{"lineBreak":true},"naye nga tompuliriza?",{"lineBreak":true},"Lwaki nkukaabirira nti, “Ebikolwa eby’obukambwe bimpitiriddeko,”",{"lineBreak":true},"naye n’otonnyamba?"]},{"type":"verse","number":3,"content":["Lwaki ondaga obutali bwenkanya",{"lineBreak":true},"era lwaki ogumiikiriza obukyamu?",{"lineBreak":true},"Kubanga okuzikiriza n’ebikolwa eby’obukambwe biri mu maaso gange,",{"lineBreak":true},"empaka n’ennyombo byeyongede."]},{"type":"verse","number":4,"content":["Amateeka kyegavudde gatagonderwa",{"lineBreak":true},"era n’obwenkanya ne butakolebwa.",{"lineBreak":true},"Ababi be basinga abatuukirivu obungi era babeebunguludde,",{"lineBreak":true},"n’obwenkanya ne bulinnyirirwa."]},{"type":"heading","content":["Okuddamu kwa Mukama"]},{"type":"verse","number":5,"content":["“Mutunuulire amawanga, mwetegereze. Mwewuunyize ddala nnyo.",{"lineBreak":true},"Kubanga ŋŋenda kukola omulimu mu nnaku zammwe",{"lineBreak":true},"gwe mutalikkiriza",{"lineBreak":true},"newaakubadde nga mugubuuliddwa."]},{"type":"verse","number":6,"content":["Kubanga laba, nkuyimusiza Abakaludaaya,",{"lineBreak":true},"eggwanga eryo eririna ettima era ekkambwe,",{"lineBreak":true},"ababunye ensi eno n’eri",{"lineBreak":true},"nga bawamba amawanga agatali gaabwe."]},{"type":"verse","number":7,"content":["Ba ntiisa, batiibwa,",{"lineBreak":true},"be beetekera amateeka gaabwe era be bagassa mu nkola,",{"lineBreak":true},"nga balwanirira ekitiibwa kyabwe."]},{"type":"verse","number":8,"content":["Embalaasi zaabwe zidduka okukira engo,",{"lineBreak":true},"era mu bukambwe zikira emisege egy’ekiro.",{"lineBreak":true},"Abasajja abeebagala embalaasi bava mu nsi ey’ewala",{"lineBreak":true},"era bajja beesaasaanyizza",{"lineBreak":true},"ne banguwa okutuuka ng’ensega bw’erumba ky’eneerya."]},{"type":"verse","number":9,"content":["Bajja n’eryanyi bonna,",{"lineBreak":true},"ebibinja byabwe birumba ng’embuyaga ey’omu ddungu;",{"lineBreak":true},"ne balyoka bayoola abawambe abangi ng’omusenyu."]},{"type":"verse","number":10,"content":["Weewaawo, basekerera bakabaka",{"lineBreak":true},"ne baduulira n’abakungu.",{"lineBreak":true},"Basekerera buli kibuga ekiriko ekigo",{"lineBreak":true},"ne bakituumako ebifunfugu ne balinnyira okwo, ne bakiwamba."]},{"type":"verse","number":11,"content":["Awo ne bayita nga bakunta ng’embuyaga;",{"lineBreak":true},"abantu bano omusango be gwasinga, eryanyi lyabwe ye katonda waabwe.”"]},{"type":"heading","content":["Kaabakuuku Yeemulugunya Ogwokubiri"]},{"type":"verse","number":12,"content":["Ayi Mukama toli wa mirembe na mirembe,",{"lineBreak":true},"ggwe Mukama Katonda wange, si ggwe Mutukuvu wange? Tetulifa.",{"lineBreak":true},"Ayi Mukama ggwe wabateekawo n’obawa amaanyi batusalire emisango.",{"lineBreak":true},"Era ggwe Olwazi, wabateekawo kubonereza."]},{"type":"verse","number":13,"content":["Amaaso go gajjudde obulongoofu tegatunula ku kibi,",{"lineBreak":true},"so toyinza kugumiikiriza bukyamu.",{"lineBreak":true},"Kale lwaki ggwe ogumiikiriza ab’enkwe,",{"lineBreak":true},"n’osirika ng’omubi amalirawo ddala",{"lineBreak":true},"omuntu amusinga obutuukirivu?"]},{"type":"verse","number":14,"content":["Kubanga abantu obafudde ng’ebyennyanja eby’omu nnyanja,",{"lineBreak":true},"ng’ebitonde eby’omu nnyanja ebitaliiko abifuga."]},{"type":"verse","number":15,"content":["Omulabe omubi abakwata bonna ng’eddobo,",{"lineBreak":true},"oluusi n’abawalula mu katimba ke,",{"lineBreak":true},"n’abakuŋŋaanya mu kiragala kye",{"lineBreak":true},"n’alyoka asanyuka n’ajaguza."]},{"type":"verse","number":16,"content":["Kyava awaayo ssaddaaka eri akatimba ke",{"lineBreak":true},"n’ayotereza n’ekiragala kye obubaane;",{"lineBreak":true},"akatimba ke kamuwa obulamu obw’okwejalabya,",{"lineBreak":true},"n’alya emmere ey’ekigagga."]},{"type":"verse","number":17,"content":["Kale, bwe batyo bwe banaalekebwa okutikkula obutimba bwabwe,",{"lineBreak":true},"n’okusaanyaawo amawanga awatali kusaasira?"]}],"footnotes":[]},{"number":2,"content":[{"type":"heading","content":["Obulamu eri Abatuukirivu"]},{"type":"verse","number":1,"content":["Kale ndiyimirira mu kifo kyange we ntera okubeera",{"lineBreak":true},"ntunule nga ndi waggulu eyo ku ggulumu",{"lineBreak":true},"nnindirire ky’aliŋŋamba,",{"lineBreak":true},"era ne kye ndimuddamu ekikwata ku kwemulugunya kw’abantu."]},{"type":"verse","number":2,"content":["Awo Mukama n’anziramu n’ayogera nti,",{"lineBreak":true},"“Wandiika okwolesebwa okwo ku bipande.",{"lineBreak":true},"Kuwandiike bulungi",{"lineBreak":true},"ate omubaka gwe banaatuma, akutwale bunnambiro."]},{"type":"verse","number":3,"content":["Kubanga okwolesebwa okwo kujja mu kiseera kyakwo ekigere.",{"lineBreak":true},"Kwogera ku by’enkomerero",{"lineBreak":true},"ate si kwa bulimba.",{"lineBreak":true},"Bwe kunaaba ng’okuluddewo, mukulindirire,",{"lineBreak":true},"kujja kutuukirira, tekugya kulwa."]},{"type":"verse","number":4,"content":["“Laba oyo ow’emmeeme eteri nnongoofu wa kugwa,",{"lineBreak":true},"naye omutuukirivu aliba mulamu olw’obwesigwa bwe.”"]},{"type":"heading","content":["Akabi eri Aboonoonyi"]},{"type":"verse","number":5,"content":["Weewaawo, omwenge mulimba",{"lineBreak":true},"guleetera omuntu amalala, ate taguwummulako.",{"lineBreak":true},"Ate olwokubanga gwa mululu ng’emagombe, mu butakkuta gufaanana okufa.",{"lineBreak":true},"Era okufaanana ng’olumbe, tegukkuta,",{"lineBreak":true},"amawanga gonna gugeekuŋŋanyizaako",{"lineBreak":true},"ne gugafuula abasibe."]},{"type":"verse","number":6,"content":["“Bano bonna si be balimugererako engero bamusekerere nga bagamba nti,",{"lineBreak":true},"“ ‘Zimusanze oyo eyeyongeza ebitali bibye!",{"lineBreak":true},"Oyo eyeetuumako obugagga obuva mu nguzi!’"]},{"type":"verse","number":7,"content":["Abakubanja tebalikuyimukirako nga tomanyiridde,",{"lineBreak":true},"era tebalizuukuka ne bakweraliikiriza?",{"lineBreak":true},"Oliba togudde mu mikono gyabwe?"]},{"type":"verse","number":8,"content":["Kubanga onyaze amawanga mangi,",{"lineBreak":true},"abantu abasigaddewo balikunyaga;",{"lineBreak":true},"Oyiye omusaayi gw’abantu,",{"lineBreak":true},"n’oyonoona ensi n’ebibuga n’abantu bonna ababibeeramu.”"]},{"type":"verse","number":9,"content":["Zimusanze oyo azimbira amaka ge ku bikolwa ebibi,",{"lineBreak":true},"azimba ekisu kye waggulu,",{"lineBreak":true},"okwekuuma obutatuukwako kabi!"]},{"type":"verse","number":10,"content":["Wategeka okuzikirira kw’abantu bangi,",{"lineBreak":true},"n’oswaza ennyumba yo ne weefiiriza obulamu bwo."]},{"type":"verse","number":11,"content":["Amayinja g’oku bbugwe galikaaba,",{"lineBreak":true},"n’emikiikiro gy’ebibajje girikyasanguza."]},{"type":"verse","number":12,"content":["Zimusanze oyo azimba ekibuga n’omusaayi,",{"lineBreak":true},"atandika ekibuga n’obutali butuukirivu."]},{"type":"verse","number":13,"content":["Tekyategekebwa Mukama ow’Eggye",{"lineBreak":true},"nti okutegana kw’abantu nku buku za muliro,",{"lineBreak":true},"n’amawanga geemalamu ensa olw’ebintu ebitaliimu?"]},{"type":"verse","number":14,"content":["Kubanga ensi erijjula okumanya ekitiibwa kya Mukama,",{"lineBreak":true},"ng’amazzi bwe ganjaala ku nnyanja."]},{"type":"verse","number":15,"content":["Zimusanze oyo awa baliraanwa be ekitamiiza",{"lineBreak":true},"n’akibafukira okuva mu kita n’abawa banywe okutuusa lwe batamiira",{"lineBreak":true},"asobole okutunuulira ensonyi zaabwe!"]},{"type":"verse","number":16,"content":["Olijjuzibwa ensonyi mu kifo ky’ekitiibwa.",{"lineBreak":true},"Naawe olinywa n’oswala.",{"lineBreak":true},"Ekikompe eky’omu mukono gwa Mukama ogwa ddyo kirikyusibwa kidde gy’oli,",{"lineBreak":true},"n’ensonyi ez’obuwemu zisaanikire ekitiibwa kyo."]},{"type":"verse","number":17,"content":["Ebikolwa eby’obukambwe bye watuusa ku Lebanooni,",{"lineBreak":true},"n’okutta ensolo, birikutiisa.",{"lineBreak":true},"Osse abantu",{"lineBreak":true},"n’ozikkiriza ensi n’ebibuga n’abantu ababibeeramu."]},{"type":"verse","number":18,"content":["“Ekifaananyi ekyole kigasa ki? Anti kibajje bubazzi.",{"lineBreak":true},"Oba ekifaananyi eky’ekyuma, ekisomesa obulimba?",{"lineBreak":true},"Kubanga omuweesi yeesiga mirimu gya mikono gye",{"lineBreak":true},"nga akola ebifaananyi ebitayogera!"]},{"type":"verse","number":19,"content":["Zimusanze oyo agamba omuti nti, ‘Lamuka;’",{"lineBreak":true},"agamba ejjinja nti, ‘Golokoka!’",{"lineBreak":true},"Kino kisobola okuluŋŋamya?",{"lineBreak":true},"Kibikiddwa zaabu ne ffeeza,",{"lineBreak":true},"so tekiriimu bulamu n’akatono."]},{"type":"verse","number":20,"content":["Naye Mukama ali mu yeekaalu ye entukuvu:",{"lineBreak":true},"ensi zonna zisiriikirire mu maaso ge.”"]}],"footnotes":[]},{"number":3,"content":[{"type":"heading","content":["Okusaba kwa Kaabakuuku"]},{"type":"hebrew_subtitle","content":["Okusaba kwa nnabbi Kaabakuuku, okw’Ekisigiyonosi."]},{"type":"verse","number":2,"content":["Ayi Mukama, mpulidde ebigambo byo;",{"lineBreak":true},"mpulidde ettutumu lyo Ayi Mukama, ne ntya.",{"lineBreak":true},"Bizze buggya mu nnaku zaffe,",{"lineBreak":true},"bimanyise mu biro bino,",{"lineBreak":true},"era mu busungu jjukira okusaasira."]},{"type":"verse","number":3,"content":["Katonda yajja ng’ava e Temani,",{"lineBreak":true},"Omutukuvu oyo ng’ava ku lusozi Palani.",{"lineBreak":true},"Ekitiibwa kye kyatimbibwa ku ggulu,",{"lineBreak":true},"ensi n’eryoka ejjula ettendo lye."]},{"type":"verse","number":4,"content":["Okumasamasa kwe ne kulyoka kubeera ng’enjuba evaayo.",{"lineBreak":true},"Ebimyanso byayakanga okuva mu mukono gwe,",{"lineBreak":true},"era omwo mwe mwasinziiranga amaanyi ge ag’ekitalo."]},{"type":"verse","number":5,"content":["Kawumpuli ye yakulembera,",{"lineBreak":true},"Endwadde endala zinaamutta ne zigoberera."]},{"type":"verse","number":6,"content":["Yayimirira n’anyeenyanyeenya ensi;",{"lineBreak":true},"Yatunula n’akankanya amawanga.",{"lineBreak":true},"Ensozi ez’edda za merenguka,",{"lineBreak":true},"obusozi obw’edda ne buggwaawo. Engeri ze, za mirembe na mirembe."]},{"type":"verse","number":7,"content":["Nalaba eweema z’e Kusani nga ziri mu nnaku:",{"lineBreak":true},"n’entimbe ez’ensi ya Midiyaani nga zijugumira."]},{"type":"verse","number":8,"content":["Ayi Mukama, wanyiigira emigga?",{"lineBreak":true},"Obusungu bwo bwali ku bugga obutono?",{"lineBreak":true},"Wanyiigira ennyanja",{"lineBreak":true},"bwe weebagala embalaasi zo,",{"lineBreak":true},"n’olinnya ku magaali go ag’obuwanguzi?"]},{"type":"verse","number":9,"content":["Wasowolayo akasaale ko,",{"lineBreak":true},"wategeka okulasa obusaale;",{"lineBreak":true},"ensi n’ogyawulayawulamu n’emigga."]},{"type":"verse","number":10,"content":["Ensozi zaakulaba, ne zeenyogootola;",{"lineBreak":true},"Amataba ne gayitawo mbiro,",{"lineBreak":true},"obuziba bw’ennyanja ne buwuluguma,",{"lineBreak":true},"ne busitula amayengo gaayo waggulu."]},{"type":"verse","number":11,"content":["Enjuba n’omwezi ne biyimirira butengerera mu bifo byabyo,",{"lineBreak":true},"olw’okumyansa kw’obusaale bwo nga buwenyuka,",{"lineBreak":true},"n’olw’okumyansa kw’effumu lyo eritemagana."]},{"type":"verse","number":12,"content":["Watambula okuyita mu nsi ng’ojjudde ekiruyi,",{"lineBreak":true},"wasambirirasambirira amawanga mu busungu bwo."]},{"type":"verse","number":13,"content":["Wavaayo oleetere abantu bo obulokozi,",{"lineBreak":true},"olokole gwe wafukako amafuta;",{"lineBreak":true},"Wabetenta omukulembeze w’ensi ekola ebibi,",{"lineBreak":true},"ng’omwerulira ddala okuva ku mutwe okutuuka ku bigere."]},{"type":"verse","number":14,"content":["Wafumita omutwe gwe n’effumu lye ye,",{"lineBreak":true},"abalwanyi be bwe baavaayo okutugoba,",{"lineBreak":true},"nga bali ng’abanaatumalawo,",{"lineBreak":true},"ffe abaali baweddemu essuubi nga twekwese."]},{"type":"verse","number":15,"content":["Walinnyirira ennyanja n’embalaasi zo,",{"lineBreak":true},"n’otabangula amazzi amangi."]},{"type":"heading","content":["Okusanyukira mu Mukama"]},{"type":"verse","number":16,"content":["Nawulira, n’omutima gwange ne gukankana",{"lineBreak":true},"n’emimwa gyange gijugumira olw’eddoboozi eryo;",{"lineBreak":true},"Obuvundu ne buyingira mu magumba gange,",{"lineBreak":true},"amagulu gange ne gakankana.",{"lineBreak":true},"Naye nnaalindirira n’obugumiikiriza olunaku olw’okulabiramu ennaku",{"lineBreak":true},"bwe lulijjira eggwanga eritulumba."]},{"type":"verse","number":17,"content":["Wadde omutiini tegutojjera,",{"lineBreak":true},"so n’emizabbibu nga tegiriiko bibala,",{"lineBreak":true},"amakungula g’emizeeyituuni ne gabula,",{"lineBreak":true},"ennimiro ne zitabala mmere n’akamu,",{"lineBreak":true},"endiga nga ziweddemu mu kisibo,",{"lineBreak":true},"nga n’ente tezikyalimu mu biraalo,"]},{"type":"verse","number":18,"content":["kyokka ndijaguliza Mukama,",{"lineBreak":true},"ne nsanyukira mu Katonda Omulokozi wange."]},{"type":"verse","number":19,"content":["Mukama Katonda, ge maanyi gange;",{"lineBreak":true},"afuula ebigere byange okuba ng’eby’empeewo,",{"lineBreak":true},"era ansobozesa okutambulira mu bifo ebigulumivu."]},{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi, ku bivuga byange ebirina enkoba."]}],"footnotes":[]}]}