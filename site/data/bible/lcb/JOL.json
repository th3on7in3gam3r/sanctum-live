{"id":"JOL","name":"Yoweeri","chapters":[{"number":1,"content":[{"type":"verse","number":1,"content":["Buno bwe bubaka bwa Mukama obwajjira Yoweeri mutabani wa Pesweri."]},{"type":"verse","number":2,"content":["Muwulirize mmwe abakadde ba Isirayiri,",{"lineBreak":true},"buli ali mu nsi naye awulirize.",{"lineBreak":true},"Kino kyali kibaddewo mu biseera byammwe,",{"lineBreak":true},"oba mu biseera bya bakitammwe?"]},{"type":"verse","number":3,"content":["Mukibuulire abaana bammwe,",{"lineBreak":true},"nabo balikibuulira abaana baabwe,",{"lineBreak":true},"nabo balikibuulira ab’emirembe egiriddawo."]},{"type":"verse","number":4,"content":["Ebibinja by’enzige ebisooka bye zitalidde,",{"lineBreak":true},"enzige eziddirira zibirumbye,",{"lineBreak":true},"ate ezo bye zireseewo,",{"lineBreak":true},"enzige ento bye ziridde,",{"lineBreak":true},"ate zino bye zireseewo,",{"lineBreak":true},"enzige endala ne zibizikiririza ddala byonna!"]},{"type":"verse","number":5,"content":["Muzuukuke, mmwe abatamiivu, mwekaabire amaziga;",{"lineBreak":true},"mukube ebiwoobe mmwe mwenna abanywi b’omwenge,",{"lineBreak":true},"mukube ebiwoobe kubanga akamwa kammwe",{"lineBreak":true},"katuuse okwerabira omwenge omusu."]},{"type":"verse","number":6,"content":["Eggwanga lirumbye ensi yange,",{"lineBreak":true},"ery’amaanyi ennyo era ery’abantu abatabalika.",{"lineBreak":true},"Amannyo gaalyo gali ng’ag’empologoma,",{"lineBreak":true},"n’amasongezo gaalyo ng’ag’empologoma enkazi."]},{"type":"verse","number":7,"content":["Eggwanga eryo lizikirizza emizabbibu gyange,",{"lineBreak":true},"ne limalawo emitiini gyange.",{"lineBreak":true},"Lisusumbudde ebikuta byagyo,",{"lineBreak":true},"byonna biri ku ttaka,",{"lineBreak":true},"amatabi gaagyo gasigadde gatukuuliridde."]},{"type":"verse","number":8,"content":["Mukungubage nga nnamwandu omuto afiiriddwa bba,",{"lineBreak":true},"ng’ayambadde ebibukutu olw’ennaku."]},{"type":"verse","number":9,"content":["Ebiweebwayo eby’emmere ey’empeke n’ebiweebwayo eby’okunywa",{"lineBreak":true},"tewakyali kirabikako mu nnyumba ya Mukama.",{"lineBreak":true},"Bakabona abaweerereza mu maaso ga Katonda",{"lineBreak":true},"bakungubaga."]},{"type":"verse","number":10,"content":["Ennimiro ziweddemu ebirime;",{"lineBreak":true},"ettaka likaze,",{"lineBreak":true},"Emmere ey’empeke eweddewo,",{"lineBreak":true},"omwenge omusu n’amafuta g’emizeeyituuni ne bibulira ddala."]},{"type":"verse","number":11,"content":["Mmwe abalimi mukwatibwe entiisa,",{"lineBreak":true},"mmwe abalima emizabbibu mukaabe.",{"lineBreak":true},"Mukaabire eŋŋaano ne sayiri,",{"lineBreak":true},"kubanga ebyandikunguddwa byonna biweddewo."]},{"type":"verse","number":12,"content":["Omuzabbibu gukaze",{"lineBreak":true},"n’omutiini guyongobedde.",{"lineBreak":true},"Omukomamawanga, n’olukindu ne apo",{"lineBreak":true},"n’emiti gyonna egy’omu nnimiro giwotose.",{"lineBreak":true},"Abantu tebakyalina ssanyu."]},{"type":"heading","content":["Abantu Bayitibwa Okwenenya"]},{"type":"verse","number":13,"content":["Mmwe bakabona, mwesibe mwambale ebibukutu mukungubage.",{"lineBreak":true},"Mmwe abaweereza ba Katonda wange ab’oku kyoto,",{"lineBreak":true},"mweyale wansi awali ekyoto,",{"lineBreak":true},"musule awo ekiro kyonna nga mukuba ebiwoobe,",{"lineBreak":true},"kubanga mu nnyumba ya Katonda wammwe temukyali kiweebwayo kyonna,",{"lineBreak":true},"eky’emmere ey’empeke oba eky’envinnyo."]},{"type":"verse","number":14,"content":["Mulangirire okusiiba okutukuvu",{"lineBreak":true},"n’okukuŋŋaana mu maaso ga Katonda.",{"lineBreak":true},"Muyite abakulu abakulembeze",{"lineBreak":true},"n’abantu bonna ababeera mu nsi,",{"lineBreak":true},"bajje mu nnyumba ya Mukama Katonda waabwe",{"lineBreak":true},"bamukaabirire."]},{"type":"verse","number":15,"content":["Zitusanze olw’olunaku luli!",{"lineBreak":true},"Kubanga olunaku lwa Mukama olw’entiisa lusembedde.",{"lineBreak":true},"Lulijja, ng’okuzikiriza",{"lineBreak":true},"okuva eri Ayinzabyonna."]},{"type":"verse","number":16,"content":["Emmere tetuweddeeko",{"lineBreak":true},"nga tulaba?",{"lineBreak":true},"Essanyu n’okujaguza",{"lineBreak":true},"mu nnyumba ya Katonda waffe tebikomye?"]},{"type":"verse","number":17,"content":["Ensigo ziwotokedde",{"lineBreak":true},"mu ttaka,",{"lineBreak":true},"amawanika makalu",{"lineBreak":true},"n’ebyagi by’emmere bikaze,",{"lineBreak":true},"kubanga emmere ey’empeke eweddewo."]},{"type":"verse","number":18,"content":["Ensolo nga zisinda!",{"lineBreak":true},"Amagana gabuliddwa amagezi;",{"lineBreak":true},"kubanga tewali muddo,",{"lineBreak":true},"n’endiga nazo zidooba."]},{"type":"verse","number":19,"content":["Ayi Mukama, Ggwe gwe nkaabirira,",{"lineBreak":true},"kubanga omuddo gwonna gumaliddwawo empiira,",{"lineBreak":true},"n’emiti gyonna egy’omu nnimiro",{"lineBreak":true},"nagyo giyidde."]},{"type":"verse","number":20,"content":["Ensolo ez’omu nsiko nazo zikukaabira okuziyamba,",{"lineBreak":true},"emigga gikalidde,",{"lineBreak":true},"ne gye ziriira, omuddo gwonna guyidde."]}],"footnotes":[]},{"number":2,"content":[{"type":"heading","content":["Okulabula ku Lunaku lwa Mukama Olujja"]},{"type":"verse","number":1,"content":["Bakabona mufuuyire ekkondeere mu Sayuuni.",{"lineBreak":true},"N’akagombe ak’okulabula kavugire ku lusozi lwange olutukuvu.",{"lineBreak":true},"Buli muntu yenna mu ggwanga akankane olw’entiisa,",{"lineBreak":true},"kubanga olunaku lwa Mukama lusembedde,",{"lineBreak":true},"era lunaatera okutuuka."]},{"type":"verse","number":2,"content":["Luliba olunaku olutaliiko ssanyu, olw’ekizikiza;",{"lineBreak":true},"olunaku olw’ebire ebingi n’ekizikiza ekikutte.",{"lineBreak":true},"Eggye ery’enzige ery’amaanyi ennyo,",{"lineBreak":true},"ng’ery’abantu abalwanyi ab’ekitalo, libuutikidde ensozi.",{"lineBreak":true},"Tewabangawo ggye lirifaanana mu biro byonna eby’edda,",{"lineBreak":true},"era teribaayo liryenkana mu mirembe gyonna egiriddawo."]},{"type":"verse","number":3,"content":["Enzige ezikulembedde zirya ng’omuliro ogwokya buli wantu,",{"lineBreak":true},"n’ezizivaako emabega nazo zibizikiririze ddala ng’ennimi z’omuliro.",{"lineBreak":true},"Mu maaso gye ziraga ensi erabika bulungi ng’ennimiro ya Adeni,",{"lineBreak":true},"naye gye ziva buli kimu zikiridde;",{"lineBreak":true},"ensi yonna zigirese nga ddungu jjereere."]},{"type":"verse","number":4,"content":["Zifaanana ng’embalaasi,",{"lineBreak":true},"era zidduka ng’embalaasi ez’entalo."]},{"type":"verse","number":5,"content":["Zigenda zibuuka ku nsozi",{"lineBreak":true},"nga zikekera ng’amagaali agasikibwa embalaasi bwe gakekera;",{"lineBreak":true},"ne ziwuuma nga bwe zitulikatulika ng’omuliro ogwokya ebisubi ebikalu; era nga",{"lineBreak":true},"ziri ng’eggye eddene mu lutalo eryetegekedde okulumba omulabe."]},{"type":"verse","number":6,"content":["Abantu abazirabyeko nga zisembera bali mu bulumi bungi,",{"lineBreak":true},"era bonna beeraliikirivu."]},{"type":"verse","number":7,"content":["Zirumba n’amaanyi ng’eggye ery’abalwanyi,",{"lineBreak":true},"ne ziwalampa ebisenge ng’abajaasi.",{"lineBreak":true},"Zikumbira mu nnyiriri zaazo nga zitereera bulungi",{"lineBreak":true},"awatali kuwaba n’akamu."]},{"type":"verse","number":8,"content":["Tezirinnyaganako,",{"lineBreak":true},"buli emu ekumbira mu kkubo lyayo.",{"lineBreak":true},"Ziwaguza mu buli kyakulwanyisa kyonna,",{"lineBreak":true},"ne watabaawo kisobola kuziziyiza."]},{"type":"verse","number":9,"content":["Zifubutuka ne zigwira ekibuga.",{"lineBreak":true},"Zikiwalampa ne zibuna bbugwe waakyo.",{"lineBreak":true},"Zirinnya amayumba",{"lineBreak":true},"ne ziyingirira mu madirisa ng’ababbi bwe bakola."]},{"type":"verse","number":10,"content":["Zikankanya ensi",{"lineBreak":true},"era n’eggulu ne lijugumira.",{"lineBreak":true},"Zibuutikira enjuba n’omwezi,",{"lineBreak":true},"era n’emmunyeenye tezikyayaka."]},{"type":"verse","number":11,"content":["Mukama akulembera eggye lye",{"lineBreak":true},"n’eddoboozi eribwatuuka.",{"lineBreak":true},"Eggye lya Mukama ddene nnyo era lya maanyi.",{"lineBreak":true},"Abalirimu abatuukiriza ebiragiro bye ba maanyi.",{"lineBreak":true},"Kubanga olunaku lwa Mukama lukulu",{"lineBreak":true},"era lwa ntiisa nnyo.",{"lineBreak":true},"Ani ayinza okulugumira?"]},{"type":"heading","content":["Abantu Bayitibwa Okwenenya"]},{"type":"verse","number":12,"content":["Mukama kyava agamba nti,",{"lineBreak":true},"“Mukomeewo gye ndi n’omutima gwammwe gwonna.",{"lineBreak":true},"Mukomeewo n’okusiiba n’okukaaba awamu n’okukungubaga.”"]},{"type":"verse","number":13,"content":["Muyuze emitima gyammwe",{"lineBreak":true},"so si byambalo byammwe.",{"lineBreak":true},"Mudde eri Mukama Katonda wammwe,",{"lineBreak":true},"kubanga ajjudde ekisa n’okusaasira,",{"lineBreak":true},"era tasunguwala mangu; ajjudde okwagala okutaggwaawo;",{"lineBreak":true},"n’abandisaanidde okubonerezebwa abasonyiwa."]},{"type":"verse","number":14,"content":["Ani amanyi obanga anaakyuka n’abasonyiwa,",{"lineBreak":true},"n’abawa omukisa gwe",{"lineBreak":true},"ne musobola n’okuwaayo eri Mukama Katonda wammwe",{"lineBreak":true},"ekiweebwayo eky’emmere enkalu, n’ekiweebwayo eky’ekyokunywa?"]},{"type":"verse","number":15,"content":["Mufuuyire ekkondeere mu Sayuuni,",{"lineBreak":true},"mulangirire okusiiba okutukuvu.",{"lineBreak":true},"Muyite olukuŋŋaana olussaamu Katonda ekitiibwa."]},{"type":"verse","number":16,"content":["Mukuŋŋaanye abantu bonna.",{"lineBreak":true},"Mutukuze ekibiina ekyo ekikuŋŋaanye.",{"lineBreak":true},"Muyite abakulu abakulembeze.",{"lineBreak":true},"Muleete abaana abato",{"lineBreak":true},"n’abo abakyali ku mabeere.",{"lineBreak":true},"N’oyo eyakawasa aveeyo mu kisenge kye,",{"lineBreak":true},"n’eyakafumbirwa naye aveeyo gy’ali."]},{"type":"verse","number":17,"content":["Bakabona abaweereza ba Mukama",{"lineBreak":true},"bayimirire wakati w’ekisasi kya yeekaalu n’ekyoto,",{"lineBreak":true},"bakaabirire Mukama nga bamusaba nti, “Saasira abantu bo, Ayi Mukama;",{"lineBreak":true},"abantu b’obusika bwo tobaleka kugwa mu mikono gya bannamawanga okubafuga",{"lineBreak":true},"era n’okubasekerera.",{"lineBreak":true},"Bannamawanga baleme kuduula nga boogera nti,",{"lineBreak":true},"‘Katonda waabwe ali ludda wa?’ ”"]},{"type":"heading","content":["Mukama Asaasira Abantu Be"]},{"type":"verse","number":18,"content":["Awo Mukama n’akwatirwa ensi ye ekisa,",{"lineBreak":true},"n’asaasira abantu be."]},{"type":"verse","number":19,"content":["N’ayanukula abantu be nti,",{"lineBreak":true},"“Muwulirize, nzija kubaweereza emmere enkalu, n’envinnyo, n’amafuta,",{"lineBreak":true},"ebimala okubakkusiza ddala,",{"lineBreak":true},"era siriddayo kubaleka, ne mufuuka ekivume,",{"lineBreak":true},"bannaggwanga amalala ne babasekerera."]},{"type":"verse","number":20,"content":["“Ndibagobako eggye ery’omu bukiikakkono",{"lineBreak":true},"ne ndigobera mu ddungu ery’ewala ennyo.",{"lineBreak":true},"Ekibinja ekikulembeddemu ndikigobera mu nnyanja ey’Ebuvanjuba,",{"lineBreak":true},"n’ekibinja eky’emabega ndikigobera mu nnyanja ey’Ebugwanjuba.",{"lineBreak":true},"Ekivundu n’okuwunya birituuka wala",{"lineBreak":true},"okusinga ebyo byonna bye libakoze.”"]},{"type":"verse","number":21,"content":["Mwe abali mu nsi, temutya.",{"lineBreak":true},"Musanyuke era mujaguze;",{"lineBreak":true},"kubanga Mukama abakoledde ebikulu."]},{"type":"verse","number":22,"content":["Nammwe ensolo ez’omu nsiko temutya;",{"lineBreak":true},"kubanga omuddo gwonna mu nsiko gusibukidde.",{"lineBreak":true},"Emiti gibaze ebibala byagyo,",{"lineBreak":true},"era emitiini n’emizabbibu nagyo gibaze ebibala bingi."]},{"type":"verse","number":23,"content":["Musanyuke mmwe abaana ba Sayuuni;",{"lineBreak":true},"mujagulize Mukama Katonda wammwe.",{"lineBreak":true},"Kubanga abawadde",{"lineBreak":true},"enkuba esooka mu butuukirivu.",{"lineBreak":true},"Era abawadde enkuba nnyingi esooka n’esembayo",{"lineBreak":true},"mu mwaka ng’obw’edda."]},{"type":"verse","number":24,"content":["Amawuuliro gammwe galijjula eŋŋaano,",{"lineBreak":true},"n’amasogolero gammwe galijjula envinnyo n’amafuta n’okubooga ne gabooga."]},{"type":"verse","number":25,"content":["“Ndibaddizaawo byonna enzige bye zaalya mu myaka egyo.",{"lineBreak":true},"Lyali ggye lyange ery’amaanyi lye nabasindikira nga lirimu lusejjera,",{"lineBreak":true},"n’enzige ezisala obusazi,",{"lineBreak":true},"awamu n’ezo ezizikiririza ddala."]},{"type":"verse","number":26,"content":["Kale, munaabanga n’ebyokulya bingi nga bwe muneetaaganga.",{"lineBreak":true},"Munaatenderezanga erinnya lya Mukama Katonda wammwe",{"lineBreak":true},"abakoledde ebintu ebirungi bwe bityo.",{"lineBreak":true},"Era abantu bange tebakyaddayo kuswazibwa."]},{"type":"verse","number":27,"content":["Mulimanya nga ndi wakati mu Isirayiri,",{"lineBreak":true},"era nga Nze, Mukama, Nze Katonda wammwe,",{"lineBreak":true},"so tewali mulala;",{"lineBreak":true},"n’abantu bange tebakyaddayo kuswazibwa."]},{"type":"heading","content":["Mukama Afuka Omwoyo We ku Bantu Be"]},{"type":"verse","number":28,"content":["“Awo olulituuka oluvannyuma lw’ebyo,",{"lineBreak":true},"ndifuka Omwoyo wange ku bantu bonna.",{"lineBreak":true},"Batabani bammwe ne bawala bammwe balitegeeza eby’omu maaso;",{"lineBreak":true},"abakadde baliroota ebirooto,",{"lineBreak":true},"n’abavubuka bammwe balyolesebwa."]},{"type":"verse","number":29,"content":["Mu biro ebyo",{"lineBreak":true},"ndifuka Omwoyo wange ku baweereza bange abasajja n’abakazi."]},{"type":"verse","number":30,"content":["Era ndyolesa ebyamagero mu ggulu",{"lineBreak":true},"ne ku nsi:",{"lineBreak":true},"omusaayi n’omuliro n’ekikoomi eky’omukka."]},{"type":"verse","number":31,"content":["Enjuba erifuuka ekizikiza,",{"lineBreak":true},"n’omwezi gulimyuka ng’omusaayi,",{"lineBreak":true},"olunaku lwa Mukama olukulu era olw’entiisa nga terunnatuuka."]},{"type":"verse","number":32,"content":["Awo olulituuka buli alikoowoola",{"lineBreak":true},"erinnya lya Mukama okusaasirwa alirokoka.",{"lineBreak":true},"Kubanga mu lusozi Sayuuni ne mu Yerusaalemi",{"lineBreak":true},"walibaawo abaliwona",{"lineBreak":true},"nga Mukama bw’ayogedde,",{"lineBreak":true},"ne mu abo abalifikkawo",{"lineBreak":true},"mulibaamu abo Mukama b’aliyita.”"]}],"footnotes":[]},{"number":3,"content":[{"type":"heading","content":["Abalabe ba Isirayiri Basalirwa Omusango"]},{"type":"verse","number":1,"content":["“Mu nnaku ezo, era mu biseera ebyo,",{"lineBreak":true},"Yuda n’ekibuga Yerusaalemi ndibiddiza emikisa gyabyo nga bwe gyabanga edda."]},{"type":"verse","number":2,"content":["Ndikuŋŋaanya abamawanga bonna",{"lineBreak":true},"ne mbaserengesa mu kiwonvu Yekosafaati,",{"lineBreak":true},"ne mbasalira omusango",{"lineBreak":true},"olwa byonna bye baakola abantu bange Abayisirayiri ab’obusika bwange.",{"lineBreak":true},"Kubanga baasaasaanya Abayisirayiri mu mawanga,",{"lineBreak":true},"ne bagabana ensi yange."]},{"type":"verse","number":3,"content":["Baagabana abantu bange nga babakubirako obululu;",{"lineBreak":true},"ne batunda abalenzi olw’abakazi bamalaaya,",{"lineBreak":true},"n’abawala ne babatundamu omwenge",{"lineBreak":true},"ne beenywera."]},{"type":"verse","number":4,"content":["“Mwe Ttuulo ne Sidoni n’enjuyi zonna ez’Abafirisuuti, mmwe b’ani ku Nze? Nnina kye nabakola kye mugezaako okwesasuza? Bwe munaaba nga mugezaako kwesasuza, ebikolwa byammwe nzija kubibakyusizaako mangwago."]},{"type":"verse","number":5,"content":["Kubanga mwatwala effeeza yange ne zaabu yange n’ebintu byange eby’omuwendo omungi ne mubissa mu masabo gammwe."]},{"type":"verse","number":6,"content":["Mwatwala abantu b’omu Yuda ne mu Yerusaalemi ne mubatunza Abayonaani."]},{"type":"verse","number":7,"content":["“Laba, ndibaggyayo mu mawanga gye mwabatunda; mmwe mbakole nga bwe mwabakola."]},{"type":"verse","number":8,"content":["Batabani bammwe ne bawala bammwe ndibaguza batabani ba Yuda, nabo balibaguza abantu ab’omu ggwanga ery’ewala ennyo, ery’e Seba.” Ebyo Mukama y’abyogedde."]},{"type":"heading","content":["Bakabona Balangirira Omusango eri Abaamawanga"]},{"type":"verse","number":9,"content":["Bakabona mulangirire mu mawanga bwe muti nti,",{"lineBreak":true},"Mwetegekere olutalo!",{"lineBreak":true},"Muyite abalwanyi bammwe ab’amaanyi,",{"lineBreak":true},"buli mulwanyi yenna asembere ajje mu lutalo."]},{"type":"verse","number":10,"content":["Enkumbi zammwe muziweeseemu ebitala,",{"lineBreak":true},"n’obwambe bwammwe mubuweeseemu amafumu;",{"lineBreak":true},"omunafu agambe nti,",{"lineBreak":true},"“Ndi wa maanyi.”"]},{"type":"verse","number":11,"content":["Mujje mangu mwe mwenna abamawanga agatwetoolodde,",{"lineBreak":true},"mukuŋŋaanire mu kiwonvu.",{"lineBreak":true},"Ayi Mukama, weereza eggye lyo libalumbe."]},{"type":"verse","number":12,"content":["“Amawanga geeteeketeeke",{"lineBreak":true},"gajje mu kiwonvu ekya Yekosafaati;",{"lineBreak":true},"kubanga eyo gye ndisinzira",{"lineBreak":true},"ne nsalira amawanga gonna ageetoolodde wano omusango."]},{"type":"verse","number":13,"content":["Kozesa oluwabyo lwo,",{"lineBreak":true},"kubanga ekiseera eky’amakungula kituuse.",{"lineBreak":true},"Mujje mubabetente nga bwe mulinnyirira emizabbibu mu ssogolero",{"lineBreak":true},"okutuusa envinnyo lw’ekulukuta,",{"lineBreak":true},"ekibi kyabwe kinene nnyo.”"]},{"type":"verse","number":14,"content":["Abantu bukadde na bukadde",{"lineBreak":true},"abali mu kiwonvu eky’okusalirwamu omusango!",{"lineBreak":true},"Kubanga olunaku lwa Mukama lusembedde",{"lineBreak":true},"lwaliramulirako mu kiwonvu eky’okusalirwamu omusango."]},{"type":"verse","number":15,"content":["Ekizikiza kibuutikidde enjuba n’omwezi,",{"lineBreak":true},"n’emmunyeenye tezikyayaka."]},{"type":"verse","number":16,"content":["Mukama aliwuluguma ng’ayima ku Sayuuni;",{"lineBreak":true},"alibwatuka n’eddoboozi lye ng’asinziira mu Yerusaalemi.",{"lineBreak":true},"Eggulu n’ensi birikankana.",{"lineBreak":true},"Naye Mukama aliba ekiddukiro ky’abantu be,",{"lineBreak":true},"era ekigo ky’abaana ba Isirayiri eky’amaanyi."]},{"type":"verse","number":17,"content":["“Kale mulimanya nga Nze Mukama Katonda wammwe,",{"lineBreak":true},"abeera ku lusozi lwange olutukuvu Sayuuni.",{"lineBreak":true},"Era Yerusaalemi kinaabeeranga kitukuvu,",{"lineBreak":true},"nga ne bannamawanga tebakyakirumba."]},{"type":"verse","number":18,"content":["“Olunaku luli bwe lulituuka, ensozi ziritonnyesa wayini omuggya,",{"lineBreak":true},"n’obusozi bulikulukusa amata,",{"lineBreak":true},"n’emigga gyonna egya Yuda emikalu girikulukusa amazzi.",{"lineBreak":true},"Ensulo eriva mu nnyumba ya Mukama",{"lineBreak":true},"n’efukirira ekiwonvu kya Sittimu."]},{"type":"verse","number":19,"content":["Misiri erifuuka amatongo",{"lineBreak":true},"n’ensi ya Edomu erifuuka ddungu jjereere",{"lineBreak":true},"olw’ebikolobero bye baakola ku bantu ba Yuda,",{"lineBreak":true},"ensi mwe battira abantu abatalina musango."]},{"type":"verse","number":20,"content":["Naye mu Yuda mulibeeramu abantu ennaku zonna,",{"lineBreak":true},"ne Yerusaalemi kiribeerawo emirembe gyonna."]},{"type":"verse","number":21,"content":["Ndyesasuza olw’omusaayi ogw’abo abattibwa,",{"lineBreak":true},"era teriba mutemu asonyiyibwa.",{"lineBreak":true},"Kubanga Mukama abeera mu Sayuuni.”"]}],"footnotes":[]}]}