{"id":"LAM","name":"Okukungubaga","chapters":[{"number":1,"content":[{"type":"heading","content":["Yerusaalemi Kifuuse Matongo"]},{"type":"verse","number":1,"content":["Ekibuga ekyajjulanga abantu nga kyabuliddwa!",{"lineBreak":true},"Ekyabanga eky’amaanyi mu mawanga,",{"lineBreak":true},"nga kifuuse nga nnamwandu!",{"lineBreak":true},"Eyali kabaka omukazi ng’alina amasaza,",{"lineBreak":true},"afuuse omuddu omukazi."]},{"type":"verse","number":2,"content":["Ekiro akaaba nnyo nnyini,",{"lineBreak":true},"n’amaziga ne gakulukuta ku matama ge.",{"lineBreak":true},"Mu baganzi be bonna,",{"lineBreak":true},"talina n’omu amubeesabeesa.",{"lineBreak":true},"Mikwano gye bonna bamuliddemu olukwe,",{"lineBreak":true},"bafuuse balabe be."]},{"type":"verse","number":3,"content":["Yuda agenze mu buwaŋŋanguse",{"lineBreak":true},"oluvannyuma lw’okubonaabona n’okukozesebwa n’obukambwe ng’omuddu.",{"lineBreak":true},"Kati abeera mu bannamawanga,",{"lineBreak":true},"talaba kifo kya kuwummuliramu.",{"lineBreak":true},"Bonna abamunoonya bamusanga",{"lineBreak":true},"mu nnaku ye."]},{"type":"verse","number":4,"content":["Enguudo za Sayuuni zikungubaga,",{"lineBreak":true},"kubanga tewali n’omu ajja ku mbaga zaakyo ezaalagibwa.",{"lineBreak":true},"Emiryango gye gyonna girekeddwa awo,",{"lineBreak":true},"bakabona be, basinda;",{"lineBreak":true},"bawala be abaweereza bali mu buyinike,",{"lineBreak":true},"naye yennyini ali mu nnaku."]},{"type":"verse","number":5,"content":["Abamuyigganya bafuuse bakama be;",{"lineBreak":true},"abalabe be beeyagala,",{"lineBreak":true},"kubanga Mukama amuleeseeko ennaku,",{"lineBreak":true},"olw’ebibi bye ebingi.",{"lineBreak":true},"Abaana be batwalibbwa mu buwaŋŋanguse,",{"lineBreak":true},"bawambiddwa omulabe."]},{"type":"verse","number":6,"content":["Ekitiibwa kyonna ekyali ku muwala wa Sayuuni",{"lineBreak":true},"kimuweddeko,",{"lineBreak":true},"abalangira be bafuuse ng’ennangaazi",{"lineBreak":true},"ezibuliddwa omuddo;",{"lineBreak":true},"mu bunafu,",{"lineBreak":true},"badduse ababagoba."]},{"type":"verse","number":7,"content":["Mu nnaku ez’okubonaabona kwe ng’asagaasagana,",{"lineBreak":true},"Yerusaalemi ajjukira ebintu eby’omuwendo byonna",{"lineBreak":true},"bye yalinanga mu nnaku ez’edda.",{"lineBreak":true},"Abantu be bwe baagwa mu mikono gy’omulabe,",{"lineBreak":true},"tewaali n’omu amubeera;",{"lineBreak":true},"abalabe be ne bamutunuulira",{"lineBreak":true},"ne bamusekerera olw’okugwa kwe."]},{"type":"verse","number":8,"content":["Yerusaalemi yayonoona nnyo nnyini,",{"lineBreak":true},"bw’atyo n’afuuka atali mulongoofu.",{"lineBreak":true},"Bonna abaamussangamu ekitiibwa bamunyooma,",{"lineBreak":true},"kubanga balabye bw’asigalidde awo;",{"lineBreak":true},"ye yennyini asinda,",{"lineBreak":true},"era akwatibwa ensonyi."]},{"type":"verse","number":9,"content":["Obutali bulongoofu bwe bwali mu birenge bye;",{"lineBreak":true},"teyassaayo mwoyo ku bulamu bwe obw’ebiseera ebijja.",{"lineBreak":true},"Okugwa kwe kwali kwa kyewuunyo;",{"lineBreak":true},"tewaali n’omu amubeesabeesa.",{"lineBreak":true},"“Ayi Mukama, tunuulira okubonaabona kwange,",{"lineBreak":true},"kubanga omulabe awangudde.”"]},{"type":"verse","number":10,"content":["Omulabe yagololera omukono",{"lineBreak":true},"ku bintu bya Yerusaalemi byonna eby’omuwendo;",{"lineBreak":true},"yalaba amawanga amakaafiiri",{"lineBreak":true},"nga gayingira awatukuvu we,",{"lineBreak":true},"beebo be wali ogaanye",{"lineBreak":true},"okuyingira mu kuŋŋaaniro lyo."]},{"type":"verse","number":11,"content":["Abantu be bonna basinda",{"lineBreak":true},"nga bwe banoonya ekyokulya;",{"lineBreak":true},"eby’obugagga byabwe babiwanyisaamu emmere,",{"lineBreak":true},"okusobola okuba abalamu.",{"lineBreak":true},"“Laba, Ayi Mukama Katonda, onziseeko omwoyo",{"lineBreak":true},"kubanga nnyoomebwa.”"]},{"type":"verse","number":12,"content":["“Mmwe tekibakwatako, mmwe mwenna abayitawo?",{"lineBreak":true},"mwetegereze mulabe",{"lineBreak":true},"obanga waliwo obuyinike obwenkana,",{"lineBreak":true},"obwantukako,",{"lineBreak":true},"Mukama bwe yanteekako",{"lineBreak":true},"ku lunaku olw’obusungu bwe obungi."]},{"type":"verse","number":13,"content":["“Yaweereza omuliro okuva waggulu,",{"lineBreak":true},"ne gukka mu magumba gange.",{"lineBreak":true},"Yatega ebigere byange akatimba,",{"lineBreak":true},"n’anzizaayo emabega.",{"lineBreak":true},"Yandeka mpuubadde,",{"lineBreak":true},"nga nzirise olunaku lwonna."]},{"type":"verse","number":14,"content":["“Ebibi byange binfuukidde ekikoligo;",{"lineBreak":true},"bisibiddwa ne binywezebwa omukono gwe.",{"lineBreak":true},"Binzitoowerera mu bulago,",{"lineBreak":true},"era bimmazeemu amaanyi.",{"lineBreak":true},"Mukama ampaddeyo mu mikono gy’abo",{"lineBreak":true},"be siyinza kugumiikiriza."]},{"type":"verse","number":15,"content":["“Mukama anyoomye",{"lineBreak":true},"abalwanyi abazira bonna abaali nange;",{"lineBreak":true},"akuŋŋaanyizza eggye okunwanyisa,",{"lineBreak":true},"okuzikiriza abavubuka bange.",{"lineBreak":true},"Mukama alinnyiridde Omuwala Embeerera owa Yuda,",{"lineBreak":true},"ng’omuntu bw’asambirira ezabbibu mu lyato ng’asogola."]},{"type":"verse","number":16,"content":["“Kyenva nkaaba,",{"lineBreak":true},"amaaso gange ne gajjula amaziga,",{"lineBreak":true},"kubanga tewali n’omu andi kumpi okumbeesabeesa,",{"lineBreak":true},"ayinza okunzizaamu amaanyi.",{"lineBreak":true},"Abaana bange banakuwavu",{"lineBreak":true},"kubanga omulabe awangudde.”"]},{"type":"verse","number":17,"content":["Sayuuni agolola emikono gye,",{"lineBreak":true},"naye tewali n’omu amudduukirira.",{"lineBreak":true},"Mukama awadde ekiragiro ku Yakobo",{"lineBreak":true},"baliraanwa be babeere balabe be;",{"lineBreak":true},"Yerusaalemi afuuse",{"lineBreak":true},"ekintu ekitali kirongoofu wakati mu bo."]},{"type":"verse","number":18,"content":["“Mukama mutuukirivu,",{"lineBreak":true},"newaakubadde nga najeemera ekiragiro kye.",{"lineBreak":true},"Muwulirize mmwe amawanga gonna,",{"lineBreak":true},"mutunuulire okubonaabona kwange;",{"lineBreak":true},"Abavubuka bange ne bawala bange",{"lineBreak":true},"batwalibbwa mu busibe."]},{"type":"verse","number":19,"content":["“Nakoowoola bannange bannyambe,",{"lineBreak":true},"naye tebanfaako;",{"lineBreak":true},"bakabona bange n’abakadde b’ekibuga kyange",{"lineBreak":true},"bazikiririra mu kibuga",{"lineBreak":true},"nga banoonya ekyokulya",{"lineBreak":true},"baddemu amaanyi."]},{"type":"verse","number":20,"content":["“Laba, Ayi Mukama Katonda bwe ndi omunakuwavu!",{"lineBreak":true},"Ndi mu kubonaabona,",{"lineBreak":true},"n’omutima gwange teguteredde",{"lineBreak":true},"kubanga njeemye nnyo ekiyitiridde.",{"lineBreak":true},"Ebweru ekitala kirindiridde okunsanyaawo,",{"lineBreak":true},"ne mu nnyumba mulimu kufa kwereere."]},{"type":"verse","number":21,"content":["“Abantu bawulidde okusinda kwange,",{"lineBreak":true},"naye tewali n’omu ananyamba.",{"lineBreak":true},"Abalabe bange bonna bawulidde okusinda kwange;",{"lineBreak":true},"basanyukidde ekyo ky’okoze.",{"lineBreak":true},"Olunaku lwe walangirira,",{"lineBreak":true},"lubatuukeko, babeere nga nze."]},{"type":"verse","number":22,"content":["“Obabonereze olw’obutali butuukirivu bwabwe bwonna,",{"lineBreak":true},"nga nze bwe wambonereza.",{"lineBreak":true},"Okusinda kwange kungi",{"lineBreak":true},"n’omutima gwange guzirika.”"]}],"footnotes":[]},{"number":2,"content":[{"type":"verse","number":1,"content":["Obusungu bwa Mukama nga bubuubuukidde ku Muwala wa Sayuuni",{"lineBreak":true},"ne bumussa wansi w’ekire!",{"lineBreak":true},"Ekitiibwa kya Isirayiri, Mukama akissizza wansi",{"lineBreak":true},"okuva mu ggulu okutuuka ku nsi;",{"lineBreak":true},"ne yeerabira entebe ey’ebigere bye",{"lineBreak":true},"ku lunaku lwe yasunguwalirako."]},{"type":"verse","number":2,"content":["Mukama azikirizza",{"lineBreak":true},"abatuula mu Yakobo bonna awatali kubasaasira;",{"lineBreak":true},"mu busungu bwe amenye",{"lineBreak":true},"ebigo eby’amaanyi eby’omuwala wa Yuda;",{"lineBreak":true},"assizza wansi obwakabaka bwe n’abakungu be",{"lineBreak":true},"n’abamalamu ekitiibwa."]},{"type":"verse","number":3,"content":["Mu busungu obungi",{"lineBreak":true},"amaanyi gonna aga Isirayiri agakendeezezza;",{"lineBreak":true},"bw’alabye omulabe ng’asembera,",{"lineBreak":true},"n’aggyawo omukono gwe ogwa ddyo;",{"lineBreak":true},"anyiigidde Yakobo okufaanana ng’omuliro",{"lineBreak":true},"bwe gubumbujja ne gwokya buli ekiguliraanye."]},{"type":"verse","number":4,"content":["Anaanudde omutego gwe okufaanana nga ogw’omulabe,",{"lineBreak":true},"era omukono gwe ogwa ddyo mweteefuteefu.",{"lineBreak":true},"Azikirizza ebyo byonna ebisanyusa amaaso",{"lineBreak":true},"mu weema ey’omuwala wa Sayuuni,",{"lineBreak":true},"okufaanana ng’omulabe bwe yandikoze;",{"lineBreak":true},"obusungu bwe bubuubuuka ng’omuliro."]},{"type":"verse","number":5,"content":["Mukama afuuse ng’omulabe;",{"lineBreak":true},"azikirizza Isirayiri,",{"lineBreak":true},"n’azikiriza embiri ze,",{"lineBreak":true},"n’azikiriza n’ebifo bye eby’amaanyi.",{"lineBreak":true},"Aleetedde muwala wa Yuda",{"lineBreak":true},"okweyongera okukaaba n’okukungubaga."]},{"type":"verse","number":6,"content":["Asaanyizzaawo eweema ye n’efaanana ng’ennimiro,",{"lineBreak":true},"era azikirizza n’ekifo kye eky’Okukuŋŋaanirangamu.",{"lineBreak":true},"Mukama yeerabizza Sayuuni",{"lineBreak":true},"embaga ze entukuvu ne ssabbiiti,",{"lineBreak":true},"era mu busungu bwe obungi",{"lineBreak":true},"anyoomye kabaka ne kabona."]},{"type":"verse","number":7,"content":["Mukama atamiddwa ekyoto kye,",{"lineBreak":true},"n’alekulira n’ekifo kye ekitukuvu.",{"lineBreak":true},"Awaddeyo bbugwe w’embiri ze eri omulabe;",{"lineBreak":true},"era baleekaanidde mu nnyumba ya Mukama,",{"lineBreak":true},"ne baleetamu oluyoogaano",{"lineBreak":true},"nga ku lunaku olw’embaga entukuvu."]},{"type":"verse","number":8,"content":["Mukama yamalirira okumenya",{"lineBreak":true},"bbugwe eyeetoolodde muwala wa Sayuuni,",{"lineBreak":true},"n’agolola omuguwa ogupima,",{"lineBreak":true},"Omukono gwe ne guteewala kuzikiriza.",{"lineBreak":true},"Yaleetera enkomera ne bbugwe okukungubaga,",{"lineBreak":true},"byonna ne biggweerera."]},{"type":"verse","number":9,"content":["Emiryango gye gisse mu ttaka,",{"lineBreak":true},"n’emitayimbwa gyagyo agimenye n’agyonoona.",{"lineBreak":true},"Kabaka we n’abakungu be baawaŋŋangusizibwa,",{"lineBreak":true},"eteri mateeka gaabwe agabafuga,",{"lineBreak":true},"era ne bannabbi be tebakyafuna",{"lineBreak":true},"kwolesebwa kuva eri Mukama."]},{"type":"verse","number":10,"content":["Abakadde b’Omuwala wa Sayuuni",{"lineBreak":true},"batuula wansi ku ttaka nga basiriikiridde;",{"lineBreak":true},"bayiye enfuufu ku mitwe gyabwe",{"lineBreak":true},"era beesibye ebibukutu;",{"lineBreak":true},"n’abawala ba Yerusaalemi",{"lineBreak":true},"bakotese emitwe gyabwe."]},{"type":"verse","number":11,"content":["Amaaso gange gakooye olw’okukaaba",{"lineBreak":true},"n’emmeeme yange enyiikadde",{"lineBreak":true},"n’omutima gwange gulumwa",{"lineBreak":true},"olw’okuzikirizibwa kw’abantu bange,",{"lineBreak":true},"n’olw’abaana abato n’abaana abawere okuzirikira",{"lineBreak":true},"wakati mu nguudo ez’omu kibuga."]},{"type":"verse","number":12,"content":["Bakaabirira bannyaabwe nga bwe boogera nti,",{"lineBreak":true},"“Omugaati n’envinnyo biri ludda wa?”",{"lineBreak":true},"nga bwe bazirika okufaanana ng’abaliko ebiwundu",{"lineBreak":true},"mu nguudo ez’ekibuga,",{"lineBreak":true},"nga bwe bakaabira",{"lineBreak":true},"mu bifuba bya bannyaabwe."]},{"type":"verse","number":13,"content":["Nnyinza kugamba ki,",{"lineBreak":true},"era kiki kye nnyinza okukugeraageranyaako",{"lineBreak":true},"ggwe Omuwala wa Yerusaalemi?",{"lineBreak":true},"Kiki kye nnyinza okukufaananya,",{"lineBreak":true},"okukusanyusa ggwe",{"lineBreak":true},"Omuwala Embeerera owa Sayuuni?",{"lineBreak":true},"Ekiwundu kyo kinene nnyo,",{"lineBreak":true},"kale ani ayinza okukiwonya?"]},{"type":"verse","number":14,"content":["Okwolesebwa bannabbi bo kwe baafuna,",{"lineBreak":true},"kwali kwa bulimba era kwa butaliimu;",{"lineBreak":true},"tebaakutegeeza obutali butuukirivu bwo",{"lineBreak":true},"okukuwonya obusibe.",{"lineBreak":true},"Engero ze baabanyumizanga",{"lineBreak":true},"zaali za bulimba era eziwabya."]},{"type":"verse","number":15,"content":["Bonna abayitawo",{"lineBreak":true},"babakubira mu ngalo",{"lineBreak":true},"ne bafuuwa empa ne banyeenyeza",{"lineBreak":true},"omuwala wa Yerusaalemi emitwe gyabwe nga boogera nti,",{"lineBreak":true},"“Kino kye kibuga ekyayitibwanga",{"lineBreak":true},"ekituukiridde,",{"lineBreak":true},"era essanyu ly’ensi zonna?”"]},{"type":"verse","number":16,"content":["Abalabe bo bonna",{"lineBreak":true},"baasaamiridde nga beewuunya;",{"lineBreak":true},"nga bafuuwa empa, era baluma amannyo",{"lineBreak":true},"nga boogera nti, “Tumuzikirizza.",{"lineBreak":true},"Luno lwe lunaku lwe twalindirira,",{"lineBreak":true},"kaakano lutuukiridde, era tululabye.”"]},{"type":"verse","number":17,"content":["Mukama akoze kye yateekateeka,",{"lineBreak":true},"era atuukirizza ekigambo kye",{"lineBreak":true},"kye yalagira mu nnaku ez’edda.",{"lineBreak":true},"Akuzikirizza awatali kukusaasira,",{"lineBreak":true},"aleetedde omulabe wo okukusekerera,",{"lineBreak":true},"n’amaanyi g’abalabe bo agagulumizza."]},{"type":"verse","number":18,"content":["Kaabirira Mukama",{"lineBreak":true},"n’eddoboozi ery’omwanguka",{"lineBreak":true},"ggwe Omuwala wa Sayuuni.",{"lineBreak":true},"Leka amaziga go gakulukute ng’omugga",{"lineBreak":true},"emisana n’ekiro.",{"lineBreak":true},"Teweewummuza so toganya",{"lineBreak":true},"maaso go kuwummula."]},{"type":"verse","number":19,"content":["Golokoka, okaabe ekiro",{"lineBreak":true},"obudde nga bwa kaziba;",{"lineBreak":true},"Fuka emmeeme yo ng’amazzi",{"lineBreak":true},"mu maaso ga Mukama.",{"lineBreak":true},"Yimusa emikono gyo gy’ali,",{"lineBreak":true},"olw’obulamu bw’abaana bo abato",{"lineBreak":true},"abazirise olw’enjala",{"lineBreak":true},"mu buli luguudo."]},{"type":"verse","number":20,"content":["“Tunula, Ayi Mukama Katonda osaasire!",{"lineBreak":true},"Ani gwe wali obonerezza bw’otyo?",{"lineBreak":true},"Ddala, abakyala balye ebibala by’embuto zaabwe,",{"lineBreak":true},"abaana be bakuzizza?",{"lineBreak":true},"Ddala, bakabona ne bannabbi battibwe",{"lineBreak":true},"mu watukuvu wa Mukama?"]},{"type":"verse","number":21,"content":["“Abato n’abakulu bonna bafiiridde wamu",{"lineBreak":true},"mu nfuufu ey’enguudo;",{"lineBreak":true},"abavubuka bange ne bawala bange",{"lineBreak":true},"battiddwa n’ekitala;",{"lineBreak":true},"obattidde ku lunaku olw’obusungu bwo,",{"lineBreak":true},"era obasse awatali kusaasira."]},{"type":"verse","number":22,"content":["“Nga bw’oyita abantu ku lunaku olw’embaga,",{"lineBreak":true},"bw’otyo bw’ompitidde ebikemo ku njuyi zonna;",{"lineBreak":true},"era ku lunaku olw’obusungu bwa Mukama,",{"lineBreak":true},"tewali n’omu eyasimattuka newaakubadde eyasigalawo;",{"lineBreak":true},"abo be nalabirira ne nkuza,",{"lineBreak":true},"omulabe wange be yazikiriza.”"]}],"footnotes":[]},{"number":3,"content":[{"type":"verse","number":1,"content":["Nze muntu eyakangavvulwa",{"lineBreak":true},"n’omuggo ogw’obusungu bwe."]},{"type":"verse","number":2,"content":["Angobye mu maaso ge n’antambuliza",{"lineBreak":true},"mu kizikiza, awatali kitangaala;"]},{"type":"verse","number":3,"content":["ddala, omukono gwe gunnwanyisizza",{"lineBreak":true},"emirundi egiddiriŋŋanwa olunaku lwonna."]},{"type":"verse","number":4,"content":["Akaddiyizza omubiri gwange n’eddiba lyange",{"lineBreak":true},"era amenye n’amagumba gange."]},{"type":"verse","number":5,"content":["Antaayizza n’anzijuza",{"lineBreak":true},"obulumi n’okubonaabona."]},{"type":"verse","number":6,"content":["Antadde mu kizikiza",{"lineBreak":true},"ng’abafu abaafa edda."]},{"type":"verse","number":7,"content":["Ankomedde n’okuyinza ne siyinza kudduka,",{"lineBreak":true},"ansibye enjegere ezizitowa."]},{"type":"verse","number":8,"content":["Ne bwe mukoowoola ne mukaabira nga mmusaba anyambe,",{"lineBreak":true},"okusaba kwange akuggalira bweru."]},{"type":"verse","number":9,"content":["Anteeredde amayinja mu kkubo lyange",{"lineBreak":true},"era akyamizza amakubo gange."]},{"type":"verse","number":10,"content":["Ng’eddubu bwe liteega,",{"lineBreak":true},"n’empologoma bwe yeekweka"]},{"type":"verse","number":11,"content":["yansikambula n’anziggya mu kkubo lyange n’antaagulataagula",{"lineBreak":true},"n’andeka awo nga sirina anyamba."]},{"type":"verse","number":12,"content":["Yanaanuula omutego gwe,",{"lineBreak":true},"n’anteekawo okuba ssabbaawa ey’obusaale bwe."]},{"type":"verse","number":13,"content":["Yafumita omutima gwange",{"lineBreak":true},"n’obusaale okuva mu mufuko gwe."]},{"type":"verse","number":14,"content":["Nafuuka ekisekererwa eri abantu bonna,",{"lineBreak":true},"era bannyooma nga bannyimbirira okuzibya obudde."]},{"type":"verse","number":15,"content":["Anzijuzza ebikaawa",{"lineBreak":true},"era ampadde ekikompe eky’obubalagaze nkinywe."]},{"type":"verse","number":16,"content":["Ampadde oluyinjayinja okululya amannyo gange ne gamenyeka;",{"lineBreak":true},"anninnyiridde mu nfuufu."]},{"type":"verse","number":17,"content":["Emmeeme yange terina mirembe,",{"lineBreak":true},"n’okujjukira sijjukira bugagga bwe bufaanana."]},{"type":"verse","number":18,"content":["Era njogera nti, “Ekitiibwa kyange kigenze,",{"lineBreak":true},"n’essuubi lyonna lye nalina mu Mukama limpeddeko.”"]},{"type":"verse","number":19,"content":["Nzijukira okubonaabona kwange n’okuwankawanka kwange,",{"lineBreak":true},"n’obulumi n’obubalagaze."]},{"type":"verse","number":20,"content":["Mbijjukira bulungi",{"lineBreak":true},"era bwe mbirowoozaako omutima gwange gulumwa."]},{"type":"verse","number":21,"content":["Ebyo byonna mbijjukira,",{"lineBreak":true},"kyenvudde mbeera n’essuubi."]},{"type":"verse","number":22,"content":["Olw’okwagala kwa Mukama okutaggwaawo,",{"lineBreak":true},"tetulimalibwawo, kubanga ekisa kye tekiggwaawo."]},{"type":"verse","number":23,"content":["Buli lukya ekisa kyo kiba kiggya;",{"lineBreak":true},"n’obwesigwa bwo bwa lubeerera."]},{"type":"verse","number":24,"content":["Njogera mu mutima gwange nti, “Mukama gwe mugabo gwange,",{"lineBreak":true},"kyenaava mbeera n’essuubi mu ye.”"]},{"type":"verse","number":25,"content":["Mukama mulungi eri abo abamulinamu essuubi,",{"lineBreak":true},"eri oyo amunoonya."]},{"type":"verse","number":26,"content":["Kirungi omuntu okulindirira",{"lineBreak":true},"obulokozi bwa Mukama n’obukkakkamu."]},{"type":"verse","number":27,"content":["Kirungi omuntu okwetikka ekikoligo kye",{"lineBreak":true},"mu buvubuka bwe."]},{"type":"verse","number":28,"content":["Atuulenga yekka mu kasirise",{"lineBreak":true},"kubanga Mukama y’akimwambiseemu."]},{"type":"verse","number":29,"content":["Leka akweke amaaso ge mu nfuufu, mpozi wanaabaawo essuubi."]},{"type":"verse","number":30,"content":["Leka aweeyo oluba lwe okukubibwa,",{"lineBreak":true},"era amalibwe n’okuvumibwa."]},{"type":"verse","number":31,"content":["Kubanga Mukama taligobera bantu bweru",{"lineBreak":true},"ebbanga lyonna."]},{"type":"verse","number":32,"content":["Newaakubadde ng’aleeta obulumi, aliraga ekisa",{"lineBreak":true},"kubanga okwagala kwe kungi nnyo tekuggwaawo."]},{"type":"verse","number":33,"content":["Tagenderera kuleeta bulumi",{"lineBreak":true},"newaakubadde okubonaabona ku baana ba bantu."]},{"type":"verse","number":34,"content":["Mukama akkiriziganya",{"lineBreak":true},"n’okulinnyirira abasibe,"]},{"type":"verse","number":35,"content":["n’okuggyako omuntu obwetwaze bwe",{"lineBreak":true},"mu maaso g’Oyo Ali Waggulu Ennyo,"]},{"type":"verse","number":36,"content":["oba n’obutaba na bwenkanya eri omuntu?"]},{"type":"verse","number":37,"content":["Ani ayinza okwogera ekintu ne kituukirira,",{"lineBreak":true},"Mukama nga takiragidde?"]},{"type":"verse","number":38,"content":["Mu kamwa k’oyo Ali Waggulu Ennyo,",{"lineBreak":true},"si mmwe muva ebigambo eby’okubeerwa n’eby’okubonereza?"]},{"type":"verse","number":39,"content":["Lwaki omuntu omulamu yeemulugunya,",{"lineBreak":true},"bw’abonerezebwa olw’ebibi bye?"]},{"type":"verse","number":40,"content":["Twekebere engeri zaffe, era tuzeetegereze,",{"lineBreak":true},"tudde eri Mukama."]},{"type":"verse","number":41,"content":["Tuyimuse emitima gyaffe n’emikono gyaffe",{"lineBreak":true},"eri Katonda mu ggulu, twogere nti,"]},{"type":"verse","number":42,"content":["“Twayonoona ne tujeema,",{"lineBreak":true},"tokyerabiranga era tonatusonyiwa."]},{"type":"verse","number":43,"content":["“Ojjudde obusungu n’otugobaganya,",{"lineBreak":true},"n’otutta awatali kutusaasira."]},{"type":"verse","number":44,"content":["Weebisseeko ekire,",{"lineBreak":true},"waleme okubaawo okusaba n’okumu okutuuka gy’oli."]},{"type":"verse","number":45,"content":["Otufudde obusa n’ebisasiro",{"lineBreak":true},"mu mawanga."]},{"type":"verse","number":46,"content":["“Abalabe baffe bonna batwogerako",{"lineBreak":true},"ebigambo ebibi."]},{"type":"verse","number":47,"content":["Tubonyeebonye olw’entiisa n’emitego",{"lineBreak":true},"n’okunyagibwa n’okuzikirizibwa.”"]},{"type":"verse","number":48,"content":["Amaaso gange gakulukuta emigga gy’amaziga",{"lineBreak":true},"olw’okuzikirira kw’abantu bange."]},{"type":"verse","number":49,"content":["Era amaaso gange ganeeyongeranga okukulukuta amaziga",{"lineBreak":true},"awatali kusirika,"]},{"type":"verse","number":50,"content":["okutuusa Mukama lw’alisinzira",{"lineBreak":true},"mu ggulu n’alaba."]},{"type":"verse","number":51,"content":["Bye ndaba bireeta ennaku ku mutima gwange,",{"lineBreak":true},"olw’ebyo ebyatuuka ku bawala b’ekibuga kyange."]},{"type":"verse","number":52,"content":["Abalabe bange banjigganya olutata",{"lineBreak":true},"ne baba ng’abayigga ennyonyi."]},{"type":"verse","number":53,"content":["Bagezaako okuzikiririza obulamu bwange mu bunnya,",{"lineBreak":true},"ne bankasuukirira amayinja;"]},{"type":"verse","number":54,"content":["amazzi gaabikka omutwe gwange,",{"lineBreak":true},"ne ndowooza nti, nsanyeewo."]},{"type":"verse","number":55,"content":["“Nakoowoola erinnya lyo, Ayi Mukama,",{"lineBreak":true},"nga ndi mu bunnya wansi ennyo;"]},{"type":"verse","number":56,"content":["wawulira okwegayirira kwange: toziba matu go",{"lineBreak":true},"eri okukaaba kwange.”"]},{"type":"verse","number":57,"content":["Bwe nakukoowoola wansemberera",{"lineBreak":true},"n’oyogera nti, “Totya!”"]},{"type":"verse","number":58,"content":["Mukama watunula mu nsonga yange,",{"lineBreak":true},"era n’onunula obulamu bwange."]},{"type":"verse","number":59,"content":["Ayi Mukama, walaba ebibi bye bankola,",{"lineBreak":true},"obasalire omusango nga bwe kibagwanira."]},{"type":"verse","number":60,"content":["Walaba bwe bampalana,",{"lineBreak":true},"n’enkwe zaabwe zonna ze bansalira."]},{"type":"verse","number":61,"content":["Wawulira bye banvuma, Ayi Mukama Katonda,",{"lineBreak":true},"n’enkwe zaabwe zonna ze bansalira,"]},{"type":"verse","number":62,"content":["obwama n’ebirowoozo eby’abalabe bange",{"lineBreak":true},"bye bantesaako obudde okuziba."]},{"type":"verse","number":63,"content":["Batunuulire mu kutuula kwabwe ne mu kuyimirira kwabwe;",{"lineBreak":true},"bannyooma nga bwe bannyimbirira."]},{"type":"verse","number":64,"content":["Obasasule nga bwe kibagwanira Ayi Mukama Katonda,",{"lineBreak":true},"olw’ebikolwa eby’emikono gyabwe."]},{"type":"verse","number":65,"content":["Osseeko ekibikka ku mitima gyabwe,",{"lineBreak":true},"n’ekikolimo kyo kibabeereko."]},{"type":"verse","number":66,"content":["Obayigganye mu busungu bwo obazikirize",{"lineBreak":true},"ng’osinziira mu ggulu lya Mukama Katonda."]}],"footnotes":[]},{"number":4,"content":[{"type":"verse","number":1,"content":["Zaabu ng’ettalazze!",{"lineBreak":true},"Zaabu ennungi ng’efuuse!",{"lineBreak":true},"Amayinja ag’omuwendo gasaasaanye",{"lineBreak":true},"buli luguudo we lutandikira."]},{"type":"verse","number":2,"content":["Abaana ba Sayuuni ab’omuwendo",{"lineBreak":true},"abaali beenkana nga zaabu ennungi,",{"lineBreak":true},"kaakano bali ng’ensuwa ez’ebbumba,",{"lineBreak":true},"omulimu gw’emikono gy’omubumbi."]},{"type":"verse","number":3,"content":["Ebibe biyonsa",{"lineBreak":true},"abaana baabyo,",{"lineBreak":true},"naye abantu bange bafuuse ng’abatalina kisa,",{"lineBreak":true},"bafaanana nga bammaaya mu ddungu."]},{"type":"verse","number":4,"content":["Olw’ennyonta omwana ayonka gy’alina,",{"lineBreak":true},"olulimi lwe lukwatira ku kibuno ky’akamwa ke;",{"lineBreak":true},"abaana basaba emmere",{"lineBreak":true},"naye tewali n’omu agibawa."]},{"type":"verse","number":5,"content":["Abaalyanga ebiwoomerera",{"lineBreak":true},"basabiriza ku nguudo;",{"lineBreak":true},"n’abo abaakuzibwa ng’abambala engoye ezinekaaneka",{"lineBreak":true},"bali ku ntuumu ez’ebisasiro."]},{"type":"verse","number":6,"content":["Ekibonerezo ky’abantu bange",{"lineBreak":true},"kisinga ekya Sodomu,",{"lineBreak":true},"ekyawambibwa mu kaseera akatono,",{"lineBreak":true},"nga tewali n’omu azze kukibeera."]},{"type":"verse","number":7,"content":["Abalangira baabwe baatukula nnyo okusinga omuzira,",{"lineBreak":true},"nga beeru okusinga amata;",{"lineBreak":true},"n’emibiri gyabwe nga mimyufu okusinga amayinja amatwakaavu,",{"lineBreak":true},"era banyirivu nga safiro."]},{"type":"verse","number":8,"content":["Naye kaakano badduggala okusinga enziro,",{"lineBreak":true},"era tebakyasobola kutegeerekeka mu nguudo.",{"lineBreak":true},"Olususu lwabwe lukalidde ku magumba gaabwe;",{"lineBreak":true},"lukaze ng’ekiti ekikalu."]},{"type":"verse","number":9,"content":["Abafa ekitala bafa bulungi",{"lineBreak":true},"okusinga abafa enjala,",{"lineBreak":true},"kubanga abafa enjala bayongobera ne baggwaawo",{"lineBreak":true},"olw’obutaba na mmere mu nnimiro."]},{"type":"verse","number":10,"content":["Abakazi ab’ekisa abaagala abaana",{"lineBreak":true},"bafumbye abaana baabwe;",{"lineBreak":true},"abaana abaafuuka emmere",{"lineBreak":true},"abantu bange bwe baazikirizibwa."]},{"type":"verse","number":11,"content":["Mukama akituukirizza mu busungu bwe obungi,",{"lineBreak":true},"era abayiyeeko obusungu bwe obungi.",{"lineBreak":true},"Yakoleeza omuliro mu Sayuuni",{"lineBreak":true},"ogwayokya emisingi gyakyo."]},{"type":"verse","number":12,"content":["Bakabaka b’ensi",{"lineBreak":true},"n’abantu ab’ensi endala tebakkiriza,",{"lineBreak":true},"nti abalabe n’ababakyawa baliyingira",{"lineBreak":true},"mu wankaaki wa Yerusaalemi."]},{"type":"verse","number":13,"content":["Ebyo byabatuukako olw’ebibi bya bannabbi be,",{"lineBreak":true},"n’olw’obutali butuukirivu bwa bakabona be,",{"lineBreak":true},"abaayiwa omusaayi",{"lineBreak":true},"gw’abatuukirivu abaababeerangamu."]},{"type":"verse","number":14,"content":["Badoobera mu nguudo",{"lineBreak":true},"nga bamuzibe;",{"lineBreak":true},"bajjudde omusaayi",{"lineBreak":true},"so tewali ayaŋŋanga okukwata ku byambalo byabwe."]},{"type":"verse","number":15,"content":["Abantu baabagobaganya nga boogera nti, “Muveewo, mmwe abatali balongoofu!",{"lineBreak":true},"Muviireewo ddala, so temutukwatako!”",{"lineBreak":true},"Bwe baafuuka emmombooze,",{"lineBreak":true},"amawanga gabagobaganya nga boogera nti,",{"lineBreak":true},"“Tebakyasaana kubeera wano.”"]},{"type":"verse","number":16,"content":["Mukama yennyini abasaasaanyizza,",{"lineBreak":true},"takyabafaako.",{"lineBreak":true},"Bakabona tebakyassibwamu kitiibwa,",{"lineBreak":true},"newaakubadde abakadde okuweebwa ebifo eby’oku mwanjo."]},{"type":"verse","number":17,"content":["Amaaso gaffe gakooye",{"lineBreak":true},"olw’okulindirira okubeerwa okutajja;",{"lineBreak":true},"nga tulindirira",{"lineBreak":true},"eggwanga eriyinza okutulokola."]},{"type":"verse","number":18,"content":["Baatucocca",{"lineBreak":true},"ne batulemesa okutambulira mu nguudo zaffe;",{"lineBreak":true},"enkomerero yaffe n’eba kumpi,",{"lineBreak":true},"n’ennaku zaffe ne ziggwaayo."]},{"type":"verse","number":19,"content":["Abaatuyiganyanga baatusinga embiro",{"lineBreak":true},"okusinga n’empungu ez’omu bbanga.",{"lineBreak":true},"Baatugobera mu nsozi",{"lineBreak":true},"ne batuteegera mu ddungu."]},{"type":"verse","number":20,"content":["Oyo Mukama gwe yafukako amafuta",{"lineBreak":true},"yagwa mu mitego gyabwe.",{"lineBreak":true},"Twalowooza nga tulikwekebwa mu kisiikirize kye",{"lineBreak":true},"ne tubeeranga mu mawanga."]},{"type":"verse","number":21,"content":["Sanyuka ojaguze, ggwe Omuwala wa Edomu,",{"lineBreak":true},"abeera mu nsi ya Uzi;",{"lineBreak":true},"naye lumu olinywa ku kikompe",{"lineBreak":true},"n’otamiira ne weeyambula."]},{"type":"verse","number":22,"content":["Ggwe Muwala wa Sayuuni, ekibonerezo kyo kikomye awo,",{"lineBreak":true},"talikwongerayo mu busibe.",{"lineBreak":true},"Naye ggwe omuwala wa Edomu, Mukama alikubonereza,",{"lineBreak":true},"n’ayanika ekibi kyo mu lujjudde."]}],"footnotes":[]},{"number":5,"content":[{"type":"verse","number":1,"content":["Jjukira Ayi Mukama ekitutuuseeko.",{"lineBreak":true},"Tunula olabe ennaku yaffe."]},{"type":"verse","number":2,"content":["Omugabo gwaffe guweereddwa bannamawanga,",{"lineBreak":true},"n’amaka gaffe gatwaliddwa abatali ba mu nnyumba."]},{"type":"verse","number":3,"content":["Tufuuse bamulekwa abatalina bakitaabwe,",{"lineBreak":true},"ne bannyaffe bafuuse bannamwandu."]},{"type":"verse","number":4,"content":["Tusasulira amazzi ge tunywa;",{"lineBreak":true},"n’enku tuteekwa okuzigula."]},{"type":"verse","number":5,"content":["Abatucocca batugobaganya;",{"lineBreak":true},"tukooye ate nga tetulina wa kuwummulira."]},{"type":"verse","number":6,"content":["Twakola endagaano ne Misiri n’Abasuuli",{"lineBreak":true},"okutufuniranga ku mmere."]},{"type":"verse","number":7,"content":["Bajjajjaffe baayonoona, ne bafa,",{"lineBreak":true},"naye tubonerezebwa olw’ebikolwa byabwe ebitaali bya butuukirivu."]},{"type":"verse","number":8,"content":["Abaddu be batufuga,",{"lineBreak":true},"tewali n’omu ayinza okutulokola mu mukono gwabwe."]},{"type":"verse","number":9,"content":["Tuba kumpi n’okuttibwa nga tunoonya emmere,",{"lineBreak":true},"olw’ekitala ekiri mu ddungu."]},{"type":"verse","number":10,"content":["Olususu lwaffe luddugadde ng’enziro",{"lineBreak":true},"olw’enjala ennyingi."]},{"type":"verse","number":11,"content":["Abakyala ba Sayuuni,",{"lineBreak":true},"n’abawala embeerera ab’omu bibuga bya Yuda bakwatiddwa olw’amaanyi."]},{"type":"verse","number":12,"content":["Abalangira bawanikibbwa baleebeetera ku mikono gyabwe",{"lineBreak":true},"n’abakadde tewali abassaamu kitiibwa."]},{"type":"verse","number":13,"content":["Abavubuka bawalirizibwa okusa emmere ku jjinja ne ku lubengo,",{"lineBreak":true},"n’abalenzi batagala nga beetisse entuumu z’enku."]},{"type":"verse","number":14,"content":["Abakadde tebakyatuula mu wankaaki w’ekibuga,",{"lineBreak":true},"n’abavubuka tebakyayimba."]},{"type":"verse","number":15,"content":["Emitima gyaffe tegikyasanyuka,",{"lineBreak":true},"n’okuzina kwaffe kufuuse kukungubaga."]},{"type":"verse","number":16,"content":["Engule egudde okuva ku mitwe gyaffe.",{"lineBreak":true},"Zitusanze kubanga twonoonye!"]},{"type":"verse","number":17,"content":["Emitima gyaffe kyegivudde gizirika,",{"lineBreak":true},"era n’amaaso gaffe kyegavudde gayimbaala."]},{"type":"verse","number":18,"content":["Olw’okuba nga olusozi Sayuuni lulekeddwa nga lwereere,",{"lineBreak":true},"ebibe kyebivudde bitambulirako."]},{"type":"verse","number":19,"content":["Ggwe, Ayi Mukama obeerera ennaku zonna;",{"lineBreak":true},"entebe yo ey’obwakabaka ya mirembe na mirembe."]},{"type":"verse","number":20,"content":["Lwaki otwelabiririra ddala okumala ennaku ezo zonna?",{"lineBreak":true},"Tuddiremu, Ayi Mukama, tudde gy’oli."]},{"type":"verse","number":21,"content":["Tukomyewo gy’oli Ayi Mukama,",{"lineBreak":true},"otuzze buggya ng’edda;"]},{"type":"verse","number":22,"content":["wabula ng’otusuulidde ddala,",{"lineBreak":true},"era ng’otusunguwalidde nnyo nnyini obutayagala na kutuddiramu."]}],"footnotes":[]}]}