{"id":"MIC","name":"Mikka","chapters":[{"number":1,"content":[{"type":"verse","number":1,"content":["Mu mirembe Yuda gye yagenda efugibwa bakabaka bano: Yosamu, ne Akazi, ne Keezeekiya, Mikka eyali Omumolasuuti, yafuna obubaka obuva eri Mukama, obukwata ku kibuga Samaliya ne Yerusaalemi."]},{"type":"verse","number":2,"content":["Muwulire mmwe abantu mwenna,",{"lineBreak":true},"muwulire mmwe ebintu byonna ebiri mu nsi, ne bonna abagirimu,",{"lineBreak":true},"Mukama Ayinzabyonna asinziira mu yeekaalu ye entukuvu,",{"lineBreak":true},"ng’alina by’abalumiriza."]},{"type":"verse","number":3,"content":["Mulabe, Mukama ajja ng’ava mu ggulu ku ntebe ye",{"lineBreak":true},"ng’akka ku nsi ng’atambulira ku nsozi waggulu."]},{"type":"verse","number":4,"content":["N’ensozi zirisaanuukira wansi w’ebigere bye",{"lineBreak":true},"era n’ebiwonvu ne byatika ne bisaanuuka",{"lineBreak":true},"ng’ebisenge by’emizindu by’enjuki ebyokeddwa omuliro,",{"lineBreak":true},"ng’amazzi g’ekiyiriro bwe gakulukuta ku lusozi nga gayirira ku bbangabanga."]},{"type":"verse","number":5,"content":["Bino byonna biribeerawo olw’okwonoona kwa Yakobo,",{"lineBreak":true},"olw’ebibi by’ennyumba ya Isirayiri.",{"lineBreak":true},"Ekibi kya Yakobo kye kiruwa?",{"lineBreak":true},"Si ye Samaliya?",{"lineBreak":true},"Kifo ki ekigulumivu ekya Yuda?",{"lineBreak":true},"Si Yerusaalemi?"]},{"type":"verse","number":6,"content":["“Noolwekyo nzija kubetenta Samaliya ngifuule ebifunfugu,",{"lineBreak":true},"kifuuke nga ennimiro ey’okusimbamu emizabbibu.",{"lineBreak":true},"Ndiyiwa amayinja gaakyo mu kiwonvu",{"lineBreak":true},"N’emisingi gyakyo ne ngireka nga gyasamye."]},{"type":"verse","number":7,"content":["Bakatonda baakyo bonna be basinza, balisekulwasekulwa;",{"lineBreak":true},"ebintu byonna ebyaweebwayo ng’ebirabo mu yeekaalu biriggya omuliro;",{"lineBreak":true},"ndizikiriza bakatonda baakyo bonna be beekolera.",{"lineBreak":true},"Ng’ebirabo ebyo bwe byafunibwa mu bwenzi,",{"lineBreak":true},"bwe bityo bwe biritwalibwa mu bwenzi ne bikozesebwa.”"]},{"type":"heading","content":["Okukaaba n’Okukungubaga"]},{"type":"verse","number":8,"content":["Kyendiva nkaaba ne nkuba ebiwoobe,",{"lineBreak":true},"ne ntambula nga sambadde ngatto, era nga ndi bukunya.",{"lineBreak":true},"Ndikaaba ng’ekibe,",{"lineBreak":true},"ne nkuba ebiwoobe ng’abaana b’ekiwuugulu."]},{"type":"verse","number":9,"content":["Ekiwundu kye tekiwonyezeka,",{"lineBreak":true},"ne Yuda ky’alwadde.",{"lineBreak":true},"Kituukidde ddala ku mulyango gw’abantu bange,",{"lineBreak":true},"ne ku Yerusaalemi yennyini."]},{"type":"heading","content":["Omulabe Asemberera Yerusaalemi"]},{"type":"verse","number":10,"content":["Temukibuulira mu Gaasi,",{"lineBreak":true},"temukaaba maziga n’akatono.",{"lineBreak":true},"Mwevulungulire mu nfuufu",{"lineBreak":true},"mu Besuleyafula."]},{"type":"verse","number":11,"content":["Muyiteewo nga muli bwereere nga muswadde,",{"lineBreak":true},"mmwe ababeera mu Safiri.",{"lineBreak":true},"Ababeera mu Zanani",{"lineBreak":true},"tebalifuluma.",{"lineBreak":true},"Beswezeeri ekuba ebiwoobe,",{"lineBreak":true},"kubanga tokyalinayo buddukiro."]},{"type":"verse","number":12,"content":["Abo ab’omu Malosi bali mu kulumwa okw’amaanyi",{"lineBreak":true},"nga balindirira okubeerwa,",{"lineBreak":true},"kubanga ekibonoobono kivudde eri Mukama,",{"lineBreak":true},"ne kituuka ne ku mulyango gwa Yerusaalemi."]},{"type":"verse","number":13,"content":["Mwanguwe okusiba amagaali ku mbalaasi",{"lineBreak":true},"mmwe ababeera mu Lakisi.",{"lineBreak":true},"Mmwe nsibuko y’ekibi",{"lineBreak":true},"mu Bawala ba Sayuuni,",{"lineBreak":true},"kubanga ebibi bya Isirayiri byasangibwa mu mmwe."]},{"type":"verse","number":14,"content":["Noolwekyo muligabira Molesesu eky’e Gaasi",{"lineBreak":true},"ebirabo ebimusiibula.",{"lineBreak":true},"Ebibuga by’e Akuzibu birikakasibwa nga bya bulimba",{"lineBreak":true},"eri bakabaka ba Isirayiri."]},{"type":"verse","number":15,"content":["Mmwe abantu b’omu Malesa,",{"lineBreak":true},"ndibasindikira alibawangula n’abafuga.",{"lineBreak":true},"Oyo ekitiibwa kya Isirayiri",{"lineBreak":true},"alijja mu Adulamu."]},{"type":"verse","number":16,"content":["Mukungubage, n’emitwe mugimwe",{"lineBreak":true},"olw’abaana bammwe be mwesiimisa;",{"lineBreak":true},"mumwe enviiri zammwe nga mukungubaga, emitwe gyammwe gibe ng’egy’ensega,",{"lineBreak":true},"kubanga abaana bammwe balibaggyibwako ne batwalibwa mu buwaŋŋanguse."]}],"footnotes":[]},{"number":2,"content":[{"type":"verse","number":1,"content":["Zibasanze mmwe abateesa okukola ebitali bya butuukirivu",{"lineBreak":true},"era abateesa okukola ebibi nga bali ku buliri bwabwe;",{"lineBreak":true},"Obudde bwe bukya ne batuukiriza entegeka zaabwe,",{"lineBreak":true},"kubanga kiri mu nteekateeka yaabwe."]},{"type":"verse","number":2,"content":["Beegomba ebyalo ne babitwala,",{"lineBreak":true},"ne beegomba ennyumba nazo ne bazitwala.",{"lineBreak":true},"Banyigiriza omuntu ne batwala amaka ge olw’amaanyi,",{"lineBreak":true},"ne bamubbako ebyobusika bwe."]},{"type":"verse","number":3,"content":["Mukama kyava agamba nti,",{"lineBreak":true},"“Laba, ndireeta akabi ku bantu abo,",{"lineBreak":true},"ke mutagenda kweggyamu.",{"lineBreak":true},"Temuliddayo kubeera n’amalala nate",{"lineBreak":true},"kubanga kiriba kiseera kya mitawaana."]},{"type":"verse","number":4,"content":["Olwo abantu balikusekerera;",{"lineBreak":true},"Balikuyeeyereza nga bayimba oluyimba luno olw’okukungubaga nti:",{"lineBreak":true},"‘Tugwereddewo ddala;",{"lineBreak":true},"ebintu by’abantu bange bigabanyizibbwamu.",{"lineBreak":true},"Mukama anziggirako ddala ettaka lyange,",{"lineBreak":true},"n’aliwa abo abatulyamu enkwe.’ ”"]},{"type":"verse","number":5,"content":["Noolwekyo tewalisigalawo muntu n’omu mu kuŋŋaaniro lya Mukama,",{"lineBreak":true},"aligabanyaamu ettaka ku bululu."]},{"type":"verse","number":6,"content":["Bannabbi baabwe boogera nti, “Temuwa bunnabbi,",{"lineBreak":true},"Temuwa bunnabbi ku bintu ebyo;",{"lineBreak":true},"tewali kabi kagenda kututuukako.”"]},{"type":"verse","number":7,"content":["Ekyo kye ky’okuddamu ggwe ennyumba ya Yakobo?",{"lineBreak":true},"Olowooza Omwoyo wa Mukama asunguwalira bwereere, si lwa bulungi bwo?",{"lineBreak":true},"Ebigambo bye tebiba birungi eri abo abakola obulungi?"]},{"type":"verse","number":8,"content":["Ennaku zino abantu bange bannyimukiddeko",{"lineBreak":true},"ng’omulabe.",{"lineBreak":true},"Basika ne bambula eminagiro emirungi",{"lineBreak":true},"ne baggigya ku migongo gy’abayise ababa beetambulira mu mirembe,",{"lineBreak":true},"ng’abasajja abakomawo okuva mu lutabaalo."]},{"type":"verse","number":9,"content":["Bakazi b’abantu bange mubagoba",{"lineBreak":true},"mu mayumba gaabwe amalungi,",{"lineBreak":true},"abaana baabwe ne mubaggyirako ddala buli mukisa",{"lineBreak":true},"oguva eri Katonda."]},{"type":"verse","number":10,"content":["Muyimuke mugende,",{"lineBreak":true},"kubanga kino tekikyali kiwummulo kyammwe;",{"lineBreak":true},"olw’ebikolwa ebibi bye mukijjuzza,",{"lineBreak":true},"kyonoonese obutaddayo kuddaabirizika."]},{"type":"verse","number":11,"content":["Omuntu bw’ajja n’omwoyo ogw’obulimba, n’agamba nti,",{"lineBreak":true},"“Ka mbabuulire ku ssanyu ly’omwenge gwe baagala era gwe banoonya,”",{"lineBreak":true},"oyo y’aba nnabbi w’abantu abo."]},{"type":"verse","number":12,"content":["“Ddala ddala ndibakuŋŋaanya mwenna, ggwe Yakobo;",{"lineBreak":true},"ndikuŋŋaanya abo abaasigalawo ku Isirayiri.",{"lineBreak":true},"Ndibakuŋŋaanya ng’akuŋŋaanya endiga ez’omu ddundiro,",{"lineBreak":true},"ng’ekisibo mu ddundiro lyakyo,",{"lineBreak":true},"ekifo kirijjula abantu."]},{"type":"verse","number":13,"content":["Oyo aggulawo ekkubo alibakulembera okubaggya mu buwaŋŋanguse,",{"lineBreak":true},"abayise mu mulyango abafulumye.",{"lineBreak":true},"Era kabaka waabwe alibakulembera,",{"lineBreak":true},"Mukama alibakulembera.”"]}],"footnotes":[]},{"number":3,"content":[{"type":"heading","content":["Ekibi kya Isirayiri"]},{"type":"verse","number":1,"content":["Ne ndyoka ŋŋamba nti,",{"lineBreak":true},"“Muwulire mmwe abakulembeze ba Yakobo,",{"lineBreak":true},"mmwe abafuzi b’ennyumba ya Isirayiri.",{"lineBreak":true},"Si mmwe mwandisaanidde okumanya obwenkanya,"]},{"type":"verse","number":2,"content":["mmwe abakyawa ekirungi ne mwagala ekibi;",{"lineBreak":true},"mmwe ababaagako abantu bange eddiba",{"lineBreak":true},"ne mubaggyako ennyama ku magumba?"]},{"type":"verse","number":3,"content":["Mulya ennyama yaabwe,",{"lineBreak":true},"ne mubabaagako eddiba,",{"lineBreak":true},"amagumba gaabwe ne mugamenyaamenya,",{"lineBreak":true},"era ne mubasalaasala ng’ennyama",{"lineBreak":true},"eneefumbibwa mu nsaka.”"]},{"type":"verse","number":4,"content":["Balikoowoola Mukama,",{"lineBreak":true},"naye talibaanukula.",{"lineBreak":true},"Mu biro ebyo alibakweka amaaso ge",{"lineBreak":true},"olw’ebibi bye bakoze."]},{"type":"verse","number":5,"content":["Bw’atyo bw’ayogera Mukama nti,",{"lineBreak":true},"“Bannabbi ababuzaabuza abantu",{"lineBreak":true},"balangirira nti, ‘Mirembe,’ eri oyo abaliisa,",{"lineBreak":true},"naye oyo atabaliisa bamuggulako olutalo."]},{"type":"verse","number":6,"content":["Noolwekyo ekiro kiribajjira, awatali kwolesebwa,",{"lineBreak":true},"n’enzikiza ebajjire awatali kulagulwa.",{"lineBreak":true},"Enjuba erigwa nga bannabbi balaba,",{"lineBreak":true},"n’obudde bubazibirire."]},{"type":"verse","number":7,"content":["Abalabi baliswazibwa",{"lineBreak":true},"n’abalaguzi bakwatibwe ensonyi.",{"lineBreak":true},"Bonna balibikka amaaso gaabwe",{"lineBreak":true},"kubanga Katonda tabaanukula.”"]},{"type":"verse","number":8,"content":["Naye nze, nzijjudde amaanyi",{"lineBreak":true},"n’Omwoyo wa Mukama,",{"lineBreak":true},"okwekaliriza ensonga n’obuvumu,",{"lineBreak":true},"njasanguze eri Yakobo olw’ebikolwa bye ebibi by’akola,",{"lineBreak":true},"olw’ekibi kya Isirayiri."]},{"type":"verse","number":9,"content":["Mumpulirize mmwe abakulembeze b’ennyumba ya Yakobo,",{"lineBreak":true},"Mmwe abafuzi b’ennyumba ya Isirayiri,",{"lineBreak":true},"Mmwe abanyooma obwenkanya",{"lineBreak":true},"Ne mukyusa ekituufu ne mukifuula ekikyamu;"]},{"type":"verse","number":10,"content":["mmwe abazimbidde Sayuuni ku musaayi,",{"lineBreak":true},"Ne Yerusaalemi ne mugizimbira ku butali butuukirivu."]},{"type":"verse","number":11,"content":["Abakulembeze be, balya enguzi ne basala omusango nga beekubiira,",{"lineBreak":true},"bakabona be, baggya ensimbi ku bantu balyoke bayigirize,",{"lineBreak":true},"ne bannabbi be, baagala okuwa obunnabbi nga bamaze kusasulwa.",{"lineBreak":true},"Kyokka bajuliza Mukama nga boogera nti,",{"lineBreak":true},"“Mukama tali naffe?",{"lineBreak":true},"Tewali kinaatutuukako.”"]},{"type":"verse","number":12,"content":["Noolwekyo ku lwammwe,",{"lineBreak":true},"Sayuuni eririmibwa ng’ennimiro,",{"lineBreak":true},"ne Yerusaalemi erifuuka ntuumu ya bifunfugu,",{"lineBreak":true},"n’akasozi okuli yeekaalu kafuuke ng’akabira akakutte."]}],"footnotes":[]},{"number":4,"content":[{"type":"heading","content":["Obufuzi bwa Mukama eri Amawanga Gonna"]},{"type":"verse","number":1,"content":["Mu nnaku ez’oluvannyuma",{"lineBreak":true},"olusozi lw’ennyumba ya Mukama luligulumizibwa",{"lineBreak":true},"okusinga ensozi zonna;",{"lineBreak":true},"lulisitulibwa waggulu okusukkuluma ku busozi,",{"lineBreak":true},"era abantu balisimba ennyiriri nga balaga gye luli."]},{"type":"verse","number":2,"content":["Amawanga mangi galiragayo ne googera nti,",{"lineBreak":true},"“Mujje twambuke ku lusozi lwa Mukama,",{"lineBreak":true},"mu nnyumba ya Katonda wa Yakobo.",{"lineBreak":true},"Alituyigiriza by’ayagala",{"lineBreak":true},"tulyoke tutambulire mu makubo ge.”",{"lineBreak":true},"Alisinziira mu Sayuuni okuwa abantu etteeka lye,",{"lineBreak":true},"n’ekigambo kya Mukama kiriva mu Yerusaalemi."]},{"type":"verse","number":3,"content":["Aliramula amawanga",{"lineBreak":true},"atereeze ensonga wakati w’amawanga gakirimaanyi ag’ewala.",{"lineBreak":true},"Baliddira ebitala byabwe ne babiweesaamu enkumbi,",{"lineBreak":true},"n’amafumu gaabwe ne bagaweesaamu ebiwabyo.",{"lineBreak":true},"Eggwanga teririyimusa kitala ku ggwanga linnaalyo,",{"lineBreak":true},"so tebalyetegeka kulwana ntalo nate."]},{"type":"verse","number":4,"content":["Buli muntu aliba mu ddembe wansi w’omuzabbibu gwe",{"lineBreak":true},"ne mu mutiini gwe.",{"lineBreak":true},"Tewalibaawo abatiisa",{"lineBreak":true},"kubanga akamwa ka Mukama Ayinzabyonna ke kakyogedde."]},{"type":"verse","number":5,"content":["Newaakubadde nga amawanga gonna",{"lineBreak":true},"galigoberera bakatonda baago,",{"lineBreak":true},"naye ffe tunaatambuliranga mu linnya lya Mukama",{"lineBreak":true},"Katonda waffe emirembe n’emirembe."]},{"type":"heading","content":["Isirayiri Ewona Obusibe"]},{"type":"verse","number":6,"content":["“Ku lunaku olwo,” bw’ayogera Mukama,",{"lineBreak":true},"“Ndikuŋŋaanya abalema,",{"lineBreak":true},"n’abo abaawaŋŋangusibwa",{"lineBreak":true},"n’abo abali mu nnaku."]},{"type":"verse","number":7,"content":["Abalema ndibafuula abalonde,",{"lineBreak":true},"n’abo be nagoba, mbafuule eggwanga ery’amaanyi.",{"lineBreak":true},"Mukama alibafugira mu Lusozi Sayuuni",{"lineBreak":true},"okuva ku lunaku olwo okutuusa emirembe gyonna."]},{"type":"verse","number":8,"content":["Ggwe omunaala oguyimirirwamu okulabirira endiga,",{"lineBreak":true},"ggwe ekigo eky’amaanyi ekya Muwala wa Sayuuni,",{"lineBreak":true},"ekitiibwa kyo eky’edda kirikuddira,",{"lineBreak":true},"n’obwakabaka ne bukomawo eri Muwala wa Sayuuni.”"]},{"type":"verse","number":9,"content":["Naye kaakano kiki ekibakaabya ennyo bwe mutyo?",{"lineBreak":true},"Temulina kabaka abakulembera?",{"lineBreak":true},"Omuwi w’amagezi wammwe yafa,",{"lineBreak":true},"ennaku eryoke ebakwate ng’omukazi alumwa okuzaala?"]},{"type":"verse","number":10,"content":["Lumwa, weenyoole ggwe Omuwala wa Sayuuni",{"lineBreak":true},"ng’omukazi alumwa okuzaala.",{"lineBreak":true},"Kubanga kaakano oteekwa okuva mu kibuga",{"lineBreak":true},"ogende obeere ku ttale.",{"lineBreak":true},"Mulitwalibwa mu buwaŋŋanguse mu Babulooni,",{"lineBreak":true},"era eyo gye ndibalokolera.",{"lineBreak":true},"Ndibanunulira eyo",{"lineBreak":true},"okuva mu mukono gw’omulabe."]},{"type":"verse","number":11,"content":["Kyokka kaakano amawanga mangi",{"lineBreak":true},"gakuŋŋaanye okubalwanyisa.",{"lineBreak":true},"Boogera nti, Ayonoonebwe,",{"lineBreak":true},"n’amaaso gaffe geelolere Sayuuni."]},{"type":"verse","number":12,"content":["Naye tebamanyi",{"lineBreak":true},"birowoozo bya Mukama;",{"lineBreak":true},"tebategeera kuteesa kwe;",{"lineBreak":true},"oyo akuŋŋaanya abalabe be ng’ebinywa by’eŋŋaano bwe bikuŋŋaanyizibwa mu gguuliro."]},{"type":"verse","number":13,"content":["“Golokoka otandike okusa ggwe Omuwala wa Sayuuni,",{"lineBreak":true},"kubanga ejjembe lyo ndirifuula ekyuma;",{"lineBreak":true},"ndikuwa ebigere eby’ekyuma eky’ekikomo",{"lineBreak":true},"era olibetenta amawanga mangi.”",{"lineBreak":true},"Amagoba gaabwe n’ebintu byabwe bye bafunye mu makubo amakyamu olibiwaayo eri Mukama,",{"lineBreak":true},"n’obugagga bwabwe n’obuwaayo eri Mukama w’ensi zonna."]}],"footnotes":[]},{"number":5,"content":[{"type":"heading","content":["Omufuzi Ava mu Besirekemu"]},{"type":"verse","number":1,"content":["Kuŋŋaanya amaggye go, ggwe ekibuga ekirina amaggye,",{"lineBreak":true},"kubanga tulumbiddwa.",{"lineBreak":true},"Omukulembeze wa Isirayiri",{"lineBreak":true},"balimukuba omuggo ku luba."]},{"type":"verse","number":2,"content":["“Naye ggwe Besirekemu Efulasa,",{"lineBreak":true},"newaakubadde ng’oli mutono mu bika bya Yuda,",{"lineBreak":true},"mu ggwe mwe muliva alibeera",{"lineBreak":true},"omufuzi wange mu Isirayiri.",{"lineBreak":true},"Oyo yaliwo okuva edda n’edda,",{"lineBreak":true},"ng’ensi tennabaawo.”"]},{"type":"verse","number":3,"content":["Mukama kyaliva awaayo Isirayiri eri abalabe baayo",{"lineBreak":true},"okutuusa omukyala alumwa okuzaala lwalizaala omwana,",{"lineBreak":true},"era baganda be abaasigalawo ne balyoka bakomawo",{"lineBreak":true},"eri bannaabwe mu Isirayiri."]},{"type":"verse","number":4,"content":["Aliyimirira n’anyweera n’aliisa ekisibo kye",{"lineBreak":true},"mu maanyi ga Mukama,",{"lineBreak":true},"mu kitiibwa ky’erinnya lya Mukama Katonda we.",{"lineBreak":true},"Era abantu be tebalibaako abateganya, kubanga aliba mukulu",{"lineBreak":true},"okutuusa ku nkomerero y’ensi."]},{"type":"verse","number":5,"content":["Omukulu oyo aliba mirembe gyabwe.",{"lineBreak":true},"Omwasuli bw’alirumba ensi yaffe",{"lineBreak":true},"n’abuna ebigo byaffe,",{"lineBreak":true},"tulimuyimbulira abasumba musanvu,",{"lineBreak":true},"n’abakulembeze munaana."]},{"type":"verse","number":6,"content":["Abo be balifuga ensi ya Asuli n’ekitala",{"lineBreak":true},"era ensi ya Nimuloodi nayo bagyonoone.",{"lineBreak":true},"Naye alitulokola eri Omwasuli",{"lineBreak":true},"bw’alitulumba mu nsi yaffe",{"lineBreak":true},"era bw’aliyingira mu nsalo zaffe."]},{"type":"verse","number":7,"content":["Abantu ba Isirayiri abalisigalawo balibeera",{"lineBreak":true},"wakati mu mawanga agabeetoolodde,",{"lineBreak":true},"babe ng’omusulo oguva eri Mukama,",{"lineBreak":true},"ng’obukubakuba obutonnyeredde ku muddo",{"lineBreak":true},"obutalindirira muntu",{"lineBreak":true},"oba abaana b’abantu."]},{"type":"verse","number":8,"content":["Ng’empologoma bw’ebeera n’ensolo endala ez’omu nsiko,",{"lineBreak":true},"abantu abaasigalawo aba Yakobo balibeera mu mawanga mangi agabeetoolodde;",{"lineBreak":true},"ate era ng’empologoma ento mu bisibo by’endiga,",{"lineBreak":true},"bw’egenda n’eyitamu n’etaagulataagula",{"lineBreak":true},"ne wataba n’omu aziwonya."]},{"type":"verse","number":9,"content":["Omukono gwo guliwangula abalabe bo,",{"lineBreak":true},"ne bonna abakuyigganya balizikirizibwa."]},{"type":"verse","number":10,"content":["“Ku lunaku olwo,” bw’ayogera Mukama,",{"lineBreak":true},"“Ndizikiriza embalaasi zo",{"lineBreak":true},"ne nsanyaawo n’amagaali go."]},{"type":"verse","number":11,"content":["Ndizikiriza ebibuga eby’omu nsi yo",{"lineBreak":true},"era mmenyemenye n’ebigo byo byonna."]},{"type":"verse","number":12,"content":["Obulogo bwo ndibumalawo",{"lineBreak":true},"era toliddayo kukolima nate."]},{"type":"verse","number":13,"content":["N’ebibumbe bye musinza ndibizikiriza.",{"lineBreak":true},"Ne nziggyawo n’amayinja ge mwawonga;",{"lineBreak":true},"temuliddayo nate kuvuunamira bakatonda",{"lineBreak":true},"be mwekoledde n’emikono gyammwe."]},{"type":"verse","number":14,"content":["Era ndisigula Baasera okuva mu mmwe,",{"lineBreak":true},"ebibuga byammwe n’embizikiriza."]},{"type":"verse","number":15,"content":["Era ndyesasuza ku mawanga agataŋŋondedde",{"lineBreak":true},"n’obusungu n’ekiruyi.”"]}],"footnotes":[]},{"number":6,"content":[{"type":"verse","number":1,"content":["Muwulire Mukama by’ayogera ng’agamba nti,",{"lineBreak":true},"“Muyimuke leero tuwoze ensonga zammwe mu maaso g’ensozi,",{"lineBreak":true},"n’obusozi buwulire bye mugamba."]},{"type":"verse","number":2,"content":["“Kaakano mmwe ensozi muwulire Mukama ky’abavunaana;",{"lineBreak":true},"nammwe emisingi gy’ensi egy’olubeerera muwulire.",{"lineBreak":true},"Mukama alina ensonga ku bantu be",{"lineBreak":true},"era agenda kuwawabira Isirayiri."]},{"type":"verse","number":3,"content":["“Mmwe abantu bange kiki kye nnali mbakoze?",{"lineBreak":true},"Nnali mbazitooweredde? Munziremu."]},{"type":"verse","number":4,"content":["Nabaggya mu nsi ye Misiri",{"lineBreak":true},"ne mbanunula mu nsi ey’obuddu,",{"lineBreak":true},"ne mbawa Musa,",{"lineBreak":true},"ne Alooni ne Miryamu okubakulembera."]},{"type":"verse","number":5,"content":["Mmwe abantu bange mujjukire",{"lineBreak":true},"ekigendererwa kya Balaki kabaka wa Mowaabu",{"lineBreak":true},"n’ebigambo, Balamu omwana wa Byoli bye yayogera.",{"lineBreak":true},"Mujjukire bye nabakolera okuva e Sittimu okutuuka e Girugaali",{"lineBreak":true},"mulyoke mumanye ebikolwa bya Mukama eby’obutuukirivu.”"]},{"type":"verse","number":6,"content":["Mwebuuza nti kiki kye nnaaleeta mu maaso ga Mukama",{"lineBreak":true},"nvuuname mu maaso ga Katonda agulumizibwa?",{"lineBreak":true},"Mmusemberere n’ebiweebwayo ebyokebwa,",{"lineBreak":true},"n’ennyana ezaakamala omwaka ogumu?"]},{"type":"verse","number":7,"content":["Mukama alisiima endiga eza sseddume olukumi,",{"lineBreak":true},"oba emitwalo gy’emigga gy’amafuta?",{"lineBreak":true},"Mpeeyo omwana wange omubereberye olw’ebibi byange,",{"lineBreak":true},"nga mpaayo ekibala ky’omubiri gwange olw’ekibi eky’emmeeme yange?"]},{"type":"verse","number":8,"content":["Mukama akulaze, ggwe omuntu, ekirungi ky’oteekwa okukola.",{"lineBreak":true},"Kaakano, Mukama kiki ky’akwetaaza,",{"lineBreak":true},"okuggyako okukola eby’ensonga, okuba n’ekisa",{"lineBreak":true},"era n’okutambulira mu buwombeefu ne Katonda wo."]},{"type":"verse","number":9,"content":["Wuliriza, Mukama akoowoola ekibuga mu ddoboozi ery’omwanguka.",{"lineBreak":true},"“Kya magezi ddala okutya erinnya lye,",{"lineBreak":true},"n’okussaayo omwoyo eri okukangavvula n’eri oyo akangavvula."]},{"type":"verse","number":10,"content":["Nnyinza okwerabira eby’obugagga bye mwefunira,",{"lineBreak":true},"mmwe ennyumba erina obutali butuukirivu,",{"lineBreak":true},"erina n’ekigera ekitatuuka eky’omuzizo?"]},{"type":"verse","number":11,"content":["Nnyinza okusonyiwa omuntu alina ebigera ebitatuuse,",{"lineBreak":true},"alina ensawo ez’ebipimo eby’obulimba?"]},{"type":"verse","number":12,"content":["Abagagga baakyo bakambwe",{"lineBreak":true},"n’abatuuze baamu balimba",{"lineBreak":true},"n’ennimi zaabwe tezoogera mazima."]},{"type":"verse","number":13,"content":["Nange kyenvudde ntandika okukuzikiriza,",{"lineBreak":true},"nkumalewo olw’ebibi byo."]},{"type":"verse","number":14,"content":["Onoolyanga, naye n’otokutta,",{"lineBreak":true},"era olubuto lwo lulisigala lutokota nga lukubanja.",{"lineBreak":true},"Oligezaako okukuŋŋaanya, weeterekere, naye tolibaako na kimu ky’otereka",{"lineBreak":true},"kubanga byonna ndibiwaayo eri ekitala."]},{"type":"verse","number":15,"content":["Olisiga naye tolikungula,",{"lineBreak":true},"oligezaako okusogola emizeeyituuni weggyiremu amafuta naye tolifuna mafuta gamala kusaabako,",{"lineBreak":true},"olisogola emizabbibu naye toliggyamu kyakunywa."]},{"type":"verse","number":16,"content":["Olw’okuba ng’okolera ku biragiro bya Omuli",{"lineBreak":true},"n’ogoberera n’ebikolwa byonna eby’ennyumba ya Akabu",{"lineBreak":true},"n’ogoberera n’emizizo gyabwe,",{"lineBreak":true},"kyendiva nkufuula ekifulukwa,",{"lineBreak":true},"n’abantu bo bonna babeere eky’okuduulirwa",{"lineBreak":true},"era olibaako ekivume ky’amawanga.”"]}],"footnotes":[]},{"number":7,"content":[{"type":"verse","number":1,"content":["Ddala zinsanze nze.",{"lineBreak":true},"Ndi ng’omuntu akungula ebibala",{"lineBreak":true},"okuva mu bifo eby’enjawulo eby’ennimiro y’emizabbibu;",{"lineBreak":true},"tewali kirimba kya mizabbibu kulyako,",{"lineBreak":true},"wadde emizeeyituuni egisooka okwengera gye njagala ennyo."]},{"type":"verse","number":2,"content":["Abantu abatya Katonda, baweddewo mu nsi;",{"lineBreak":true},"tewali n’omu mulongoofu asigaddewo.",{"lineBreak":true},"Bonna banoonya okuyiwa omusaayi,",{"lineBreak":true},"buli omu anoonya okutega muganda we ekitimba."]},{"type":"verse","number":3,"content":["Emikono gyabwe gyombi mikugu mu kukola ebibi;",{"lineBreak":true},"omufuzi asaba ebirabo,",{"lineBreak":true},"n’omulamuzi alya enguzi,",{"lineBreak":true},"n’ab’amaanyi mu nsi, beekolera kye baagala",{"lineBreak":true},"nga basala enkwe."]},{"type":"verse","number":4,"content":["Mu abo bonna asingamu obulungi, afaanana ng’omweramannyo;",{"lineBreak":true},"asingamu ku mazima y’asinga olukomera lw’amaggwa obubi.",{"lineBreak":true},"Naye olunaku lw’abakuumi bammwe lutuuse,",{"lineBreak":true},"era kino kye kiseera eky’okutabukatabuka."]},{"type":"verse","number":5,"content":["Tewesiga muntu n’omu,",{"lineBreak":true},"wadde mukwano gwo,",{"lineBreak":true},"newaakubadde mukazi wo,",{"lineBreak":true},"Weegendereze by’oyogera."]},{"type":"verse","number":6,"content":["Kubanga omulenzi agaya kitaawe,",{"lineBreak":true},"n’omwana alwanyisa nnyina,",{"lineBreak":true},"muka mwana n’alwanyisa nnyazaala we.",{"lineBreak":true},"Abalabe b’omuntu, bantu be, ab’omu nju ye bennyini."]},{"type":"verse","number":7,"content":["Naye nze nnindirira Mukama nga nnina essuubi,",{"lineBreak":true},"nnindirira Katonda Omulokozi wange;",{"lineBreak":true},"Katonda wange anampulira."]},{"type":"verse","number":8,"content":["Tonjeeyereza ggwe omulabe wange,",{"lineBreak":true},"kubanga wadde ngudde, nnaayimuka.",{"lineBreak":true},"Ne bwe naatuula mu kizikiza,",{"lineBreak":true},"Mukama anaabeera ekitangaala kyange."]},{"type":"verse","number":9,"content":["Nnaagumikirizanga Mukama bw’anaabanga ambonereza,",{"lineBreak":true},"kubanga nnyonoonye mu maaso ge,",{"lineBreak":true},"okutuusa lw’alimpolereza,",{"lineBreak":true},"n’anziza buggya.",{"lineBreak":true},"Alindeeta mu kitangaala,",{"lineBreak":true},"era ndiraba obutuukirivu bwe."]},{"type":"verse","number":10,"content":["Olwo omulabe wange alikiraba,",{"lineBreak":true},"n’aswala,",{"lineBreak":true},"oyo eyanjeeyerezanga ng’agamba nti,",{"lineBreak":true},"“Ali ludda wa Mukama Katonda wo?”",{"lineBreak":true},"Ndisanyuka ng’agudde,",{"lineBreak":true},"era alirinnyirirwa ng’ebitoomi eby’omu nguudo."]},{"type":"verse","number":11,"content":["Olunaku olw’okuzimba bbugwe wo lulituuka,",{"lineBreak":true},"olunaku olw’okugaziya ensalo yo."]},{"type":"verse","number":12,"content":["Mu biro ebyo abantu balijja gy’oli",{"lineBreak":true},"nga bava mu Bwasuli ne mu bibuga by’e Misiri,",{"lineBreak":true},"n’okuva e Misiri okutuuka ku mugga Fulaati,",{"lineBreak":true},"n’okuva ku nnyanja emu okutuuka ku nnyanja endala,",{"lineBreak":true},"n’okuva ku lusozi olumu okutuuka ku lusozi olulala."]},{"type":"verse","number":13,"content":["Ensi erifuuka matongo,",{"lineBreak":true},"olw’ebikolwa by’abantu abagibeeramu."]},{"type":"heading","content":["Okusaba n’Okutendereza"]},{"type":"verse","number":14,"content":["Lunda abantu bo n’omuggo gwo,",{"lineBreak":true},"ekisibo kye weeroboza,",{"lineBreak":true},"ababeera bokka mu kibira",{"lineBreak":true},"mu malundiro amagimu.",{"lineBreak":true},"Baleke baliire mu Basani ne Gireyaadi, nga mu biseera eby’edda."]},{"type":"verse","number":15,"content":["Nga bwe kyali mu nnaku ze mwaviiramu mu Misiri,",{"lineBreak":true},"nzija kubalaga ebikulu eby’ekitalo."]},{"type":"verse","number":16,"content":["Amawanga galikiraba ne gakwatibwa ensonyi,",{"lineBreak":true},"ne gamalibwamu amaanyi.",{"lineBreak":true},"Abantu baago balikwata ku mimwa gyabwe",{"lineBreak":true},"n’amatu gaabwe ne gaziba."]},{"type":"verse","number":17,"content":["Balirya enfuufu ng’omusota,",{"lineBreak":true},"ng’ebisolo ebyewalula.",{"lineBreak":true},"Balifuluma obunnya bwabwe nga bakankana",{"lineBreak":true},"ne bakyuka okudda eri Mukama Katonda waffe, ne babatya."]},{"type":"verse","number":18,"content":["Katonda ki omulala ali nga ggwe,",{"lineBreak":true},"asonyiwa ekibi era n’asonyiwa ebyonoono byabo",{"lineBreak":true},"abaasigalawo ku bantu be?",{"lineBreak":true},"Obusungu bwe tebubeerera emirembe gyonna,",{"lineBreak":true},"naye asanyukira okusaasira."]},{"type":"verse","number":19,"content":["Alikyuka n’atukwatirwa ekisa nate; alirinnyirira ebibi byaffe,",{"lineBreak":true},"n’asuula ebyonoono byaffe byonna mu buziba bw’ennyanja."]},{"type":"verse","number":20,"content":["Olikola eby’amazima bye wasuubiza Yakobo,",{"lineBreak":true},"n’ebyekisa bye wasuubiza Ibulayimu,",{"lineBreak":true},"nga bwe weeyama eri bajjajjaffe",{"lineBreak":true},"okuva mu nnaku ez’edda."]}],"footnotes":[]}]}