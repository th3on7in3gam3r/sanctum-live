{"id":"NAM","name":"Nakkumu","chapters":[{"number":1,"content":[{"type":"verse","number":1,"content":["Kuno kwe kwolesebwa Katonda kwe yalaga Nakkumu, Omwerukoosi okukwata ku bibambulira ebyali bijjira Nineeve."]},{"type":"heading","content":["Obusungu bwa Mukama ku Nineeve"]},{"type":"verse","number":2,"content":["Katonda wa buggya era Mukama awalana eggwanga.",{"lineBreak":true},"Mukama awalana eggwanga era ajudde ekiruyi.",{"lineBreak":true},"Mukama yeesasuza ku balabe be",{"lineBreak":true},"era aterekera abamuwakanya obusungu bwe."]},{"type":"verse","number":3,"content":["Mukama tatera kusunguwala, ate nga wa maanyi mangi",{"lineBreak":true},"era tayinza n’akatono butabonereza oyo gwe gusinze.",{"lineBreak":true},"Ekkubo lye liri mu mpewo ey’akazimu ne mu kibuyaga,",{"lineBreak":true},"n’ebire ye nfuufu y’ebigere bye."]},{"type":"verse","number":4,"content":["Akangavvula ennyanja n’agikaza",{"lineBreak":true},"era akaza emigga gyonna,",{"lineBreak":true},"ennimiro ez’omu Basani zikala, olusozi Kalumeeri lwonna lukayuse,",{"lineBreak":true},"n’ebimuli bya Lebanooni biwotose."]},{"type":"verse","number":5,"content":["Ensozi zikankanira mu maaso ga Katonda,",{"lineBreak":true},"obusozi ne busaanuuka,",{"lineBreak":true},"ettaka ne lyatikayatika mu maaso ge,",{"lineBreak":true},"ensi n’ekankana n’abantu bonna abagirimu."]},{"type":"verse","number":6,"content":["Ani ayinza okuyimirira mu maaso ge ng’asunguwadde?",{"lineBreak":true},"Ani ayinza okugumira obusungu bwe obw’amaanyi?",{"lineBreak":true},"Ekiruyi kye kibuubuuka ng’omuliro,",{"lineBreak":true},"n’enjazi n’eziyatikayatika."]},{"type":"verse","number":7,"content":["Mukama mulungi,",{"lineBreak":true},"kiddukiro mu kiseera eky’okulabiramu ennaku,",{"lineBreak":true},"era alabirira abo bonna abamwesiga."]},{"type":"verse","number":8,"content":["Naye alisaanyaawo abalabe be mu mataba amazibu,",{"lineBreak":true},"ekizikiza kiribawondera."]},{"type":"verse","number":9,"content":["Buli kye mwekobaana okukola Mukama,",{"lineBreak":true},"alikikomya.",{"lineBreak":true},"Akabi tekalijja mulundi gwakubiri."]},{"type":"verse","number":10,"content":["Kubanga baliba ng’amaggwa agakwataganye,",{"lineBreak":true},"era nga batamidde,",{"lineBreak":true},"balyoke bookebwe omuliro ng’ekisambu ekikalu."]},{"type":"verse","number":11,"content":["Mu ggwe Nineeve muvuddemu omuntu",{"lineBreak":true},"alowooza akabi",{"lineBreak":true},"era ateesa ebibi ku Mukama."]},{"type":"verse","number":12,"content":["Bw’ati bw’ayogera Mukama nti,",{"lineBreak":true},"“Newaakubadde nga balina be bakolagana nabo bangi, ate nga bangi,",{"lineBreak":true},"balizikirizibwa ne baggwaawo.",{"lineBreak":true},"Newaakubadde nga mbabonereza mmwe abantu bange,",{"lineBreak":true},"siriddayo kukikola nate."]},{"type":"verse","number":13,"content":["Kaakano nzija kumenya ekikoligo kyabwe nkibaggyeko",{"lineBreak":true},"era n’ebibasibye nnaabikutulakutula.”"]},{"type":"verse","number":14,"content":["Kino Mukama ky’alagidde ekikwata ku Nineeve:",{"lineBreak":true},"“Erinnya lyo terikyayala nate.",{"lineBreak":true},"Ndizikiriza ekifaananyi ekyole n’ekifaananyi ekisaanuuse",{"lineBreak":true},"ebiri mu masabo g’abakatonda bo;",{"lineBreak":true},"ndisima entaana yo",{"lineBreak":true},"kubanga oyinze obugwagwa.”"]},{"type":"verse","number":15,"content":["Yimusa amaaso, tunula ku nsozi, laba,",{"lineBreak":true},"ebigere ebirungi eby’oyo aleese amawulire amalungi,",{"lineBreak":true},"alangirira emirembe.",{"lineBreak":true},"Ggwe Yuda kwata embaga zo entukuvu,",{"lineBreak":true},"era otuukirize obweyamo bwo;",{"lineBreak":true},"omubi kaakano takyakulumba,",{"lineBreak":true},"azikiririzibbwa ddala, tolimulaba nate."]}],"footnotes":[]},{"number":2,"content":[{"type":"heading","content":["Okugwa kwa Nineeve"]},{"type":"verse","number":1,"content":["Nineeve, olumbiddwa omulabe;",{"lineBreak":true},"kuuma ekigo,",{"lineBreak":true},"Kuuma ekkubo,",{"lineBreak":true},"weesibire ddala onywere mu kiwato,",{"lineBreak":true},"kuŋŋaanya amaanyi go gonna."]},{"type":"verse","number":2,"content":["Kubanga Mukama alizzaawo ekitiibwa kya Yakobo,",{"lineBreak":true},"kibe ng’ekitiibwa kya Isirayiri,",{"lineBreak":true},"newaakubadde ng’abazikiriza baabasaanyawo,",{"lineBreak":true},"ne boonoona emizabbibu gyabwe."]},{"type":"verse","number":3,"content":["Engabo z’eggye erikutabadde zonna myufu",{"lineBreak":true},"n’engoye ze bambadde nazo bwe zityo.",{"lineBreak":true},"Amagaali g’ebyuuma gamasamasa",{"lineBreak":true},"ku lunaku lwe gategekebwa,",{"lineBreak":true},"era n’amafumu gagalulwa mu ngeri ey’entiisa!"]},{"type":"verse","number":4,"content":["Amagaali g’abalwanyi gatayira mu nguudo,",{"lineBreak":true},"gadda eno n’eri,",{"lineBreak":true},"galabika ng’emimuli egyaka,",{"lineBreak":true},"gamyansa ng’eggulu."]},{"type":"verse","number":5,"content":["Omuduumizi bw’ayita abalwanyi be",{"lineBreak":true},"bajja bagwirana.",{"lineBreak":true},"Badduka mbiro ku bbugwe w’ekibuga",{"lineBreak":true},"we beetegekera okwerwanako."]},{"type":"verse","number":6,"content":["Enzigi ez’omugga zigguddwawo,",{"lineBreak":true},"amazzi ne gasaanyaawo olubiri."]},{"type":"verse","number":7,"content":["Etteeka lyayisibwa ku kibuga",{"lineBreak":true},"nti kiriwaŋŋangusibwa,",{"lineBreak":true},"abaddu abakazi bakungubaga ng’amayiba,",{"lineBreak":true},"nga bwe beekuba mu bifuba."]},{"type":"verse","number":8,"content":["Ab’omu Nineeve bafaanana ng’ekidiba",{"lineBreak":true},"eky’amazzi agakalira.",{"lineBreak":true},"Wadde nga babakoowoola nti, “Muyimirire, muyimirire!”",{"lineBreak":true},"bo beeyongerayo bweyongezi."]},{"type":"verse","number":9,"content":["Ffeeza yaakyo temugirekaawo,",{"lineBreak":true},"ne zaabu nayo mugitwalire ddala,",{"lineBreak":true},"omunyago teguggwaayo,",{"lineBreak":true},"eby’obugagga byakyo ebitabalika ebirungi ddala."]},{"type":"verse","number":10,"content":["Ekibuga kisigadde kyangaala!",{"lineBreak":true},"Abantu bonna emitima gibeewanise, emibiri gibakankana,",{"lineBreak":true},"amaviivi gabakubagana, basiiwuuse ne mu maaso."]},{"type":"verse","number":11,"content":["Eri ludda wa empuku y’empologoma,",{"lineBreak":true},"ekifo we ziriisiza empologoma zaazo ento,",{"lineBreak":true},"empologoma ensajja, n’enkazi,",{"lineBreak":true},"n’ento we zaatambuliranga nga tewali kizikanga?"]},{"type":"verse","number":12,"content":["Empologoma ensajja yayigganga ennyama y’abaana ebamala,",{"lineBreak":true},"n’enkazi n’ezittira eyaazo,",{"lineBreak":true},"n’ejjuza empuku n’omuyiggo,",{"lineBreak":true},"ne mu bisulo ne mujjula ennyama."]},{"type":"verse","number":13,"content":["“Laba nze Mukama ow’Eggye",{"lineBreak":true},"nkwolekedde,",{"lineBreak":true},"era ndyokya amagaali go gonna ne ganyooka,",{"lineBreak":true},"n’ekitala kirizikiriza empologoma zo ento.",{"lineBreak":true},"Era tolifuna munyago mulala nate ku nsi,",{"lineBreak":true},"n’eddoboozi ly’ababaka bo",{"lineBreak":true},"teririddayo kuwulirwa.”"]}],"footnotes":[]},{"number":3,"content":[{"type":"heading","content":["Ebibi bya Nineeve"]},{"type":"verse","number":1,"content":["Zikusanze ggwe ekibuga eky’omusaayi!",{"lineBreak":true},"Kyonna ekijjudde eby’obulimba",{"lineBreak":true},"n’obunyazi,",{"lineBreak":true},"ekitaggwaamu banyagiddwa."]},{"type":"verse","number":2,"content":["Muwulire okuvuga kw’embooko,",{"lineBreak":true},"n’okuvuuma kwa namuziga z’amagaali",{"lineBreak":true},"n’ebigere by’embalaasi nga bwe bivuga",{"lineBreak":true},"n’amagaali nga gakubaganira mu nguudo!"]},{"type":"verse","number":3,"content":["Laba eggye ery’embalaasi erirumba,",{"lineBreak":true},"n’ebitala ebitemagana,",{"lineBreak":true},"n’amafumu agamyansa.",{"lineBreak":true},"Abatuukiddwako ebisago nga bayitirivu,",{"lineBreak":true},"ne ntuumu ennene ez’emirambo",{"lineBreak":true},"egitamanyiddwa muwendo;",{"lineBreak":true},"abantu bagirinnyirira."]},{"type":"verse","number":4,"content":["Bino byonna biri bityo kubanga Nineeve yeeweerayo ddala okwetunda eri abalabe ba Katonda obutasalako, nga malaaya omukulu,",{"lineBreak":true},"kye kibuga ekikyaamu ekitali kyesigwa ekyawubisa ebirala, omukulu w’obufumu,",{"lineBreak":true},"ekyafuula amawanga abaddu baakyo olw’obwamalaaya bwakyo,",{"lineBreak":true},"n’olw’obulogo bwakyo."]},{"type":"verse","number":5,"content":["“Laba nkwolekedde,” bw’ayogera Mukama ow’Eggye,",{"lineBreak":true},"“era nditikka engoye zo ne zidda ku mutwe gwo.",{"lineBreak":true},"Ensi zonna ziriraba obwereere bwo",{"lineBreak":true},"n’obwakabaka bwonna bulabe ensonyi zo."]},{"type":"verse","number":6,"content":["Ndikukanyugira kazambi,",{"lineBreak":true},"era ndikufuula ekyenyinyalwa",{"lineBreak":true},"ne nkufuula eky’okwelolera."]},{"type":"verse","number":7,"content":["Awo bonna abalikutunuulira balikwesamba ne bagamba nti,",{"lineBreak":true},"‘Nineeve kifuuse matongo, ani anakikungubagira?’",{"lineBreak":true},"Abalikikubagiza baliva wa?”"]},{"type":"verse","number":8,"content":["Ggwe Nineeve ggw’osinga Tebesi",{"lineBreak":true},"ekyali kizimbiddwa ku mugga Kiyira",{"lineBreak":true},"ng’amazzi gakyetoolodde okukikuuma ku njuyi zonna?",{"lineBreak":true},"Olukomera lwakyo gwali mugga",{"lineBreak":true},"era amazzi ge gaali bbugwe waakyo."]},{"type":"verse","number":9,"content":["Esiyopya ne Misiri ze zaakiwagiranga.",{"lineBreak":true},"Ate nga Abapuuti",{"noteId":1},"n’ab’omu Libiya nabo nga bakiyamba."]},{"type":"verse","number":10,"content":["Kyawambibwa, ne kitwalibwa mu buwaŋŋanguse.",{"lineBreak":true},"Abaana bwakyo abawere babetentebwa mu ntandikwa ya buli luguudo.",{"lineBreak":true},"Abakungu baakyo baakubirwa obululu,",{"lineBreak":true},"n’abasajja be ab’amaanyi baasibibwa mu njegere."]},{"type":"verse","number":11,"content":["Nineeve naawe olitamiira,",{"lineBreak":true},"olyekweka",{"lineBreak":true},"ng’onoonya obuddukiro owone omulabe wo."]},{"type":"verse","number":12,"content":["Ebigo byo byonna biri ng’emitiini",{"lineBreak":true},"egiriko ebibala ebisooka okwengera;",{"lineBreak":true},"bwe ginyeenyezebwa",{"lineBreak":true},"ne bigwa mu kamwa k’oyo anaabirya."]},{"type":"verse","number":13,"content":["Laba abalwanyi bammwe balinafuwa",{"lineBreak":true},"ne batiitiira ng’abakazi.",{"lineBreak":true},"Enzigi z’ensi yo",{"lineBreak":true},"nzigule eri abalabe bo.",{"lineBreak":true},"Era omuliro gwokezza emikiikiro gyazo."]},{"type":"verse","number":14,"content":["Weenyweze bajja kukulumba!",{"lineBreak":true},"Weeterekere ku mazzi g’onoonywako.",{"lineBreak":true},"Nyweza ebisenge byo.",{"lineBreak":true},"Noonya ettaka olisambe",{"lineBreak":true},"oddaabirize ekisenge eky’amatoffaali."]},{"type":"verse","number":15,"content":["Omuliro gulikulya,",{"lineBreak":true},"ekitala kirikuzikiriza.",{"lineBreak":true},"Wenna oliriibwa ng’enzige bwe zirya ebirime.",{"lineBreak":true},"Mweyongere obungi ng’enseenene,",{"lineBreak":true},"mwale ng’enzige."]},{"type":"verse","number":16,"content":["Mwongedde ku bungi bwa basuubuzi bammwe",{"lineBreak":true},"okusinga emmunyeenye ez’oku ggulu.",{"lineBreak":true},"Naye ensi baligikaza okufaanana ng’enzige bwe zimalawo ensi",{"lineBreak":true},"ne ziryoka zibuuka."]},{"type":"verse","number":17,"content":["Abakuumi bammwe bali ng’enzige,",{"lineBreak":true},"n’abakungu bammwe ng’ebibinja by’enzige",{"lineBreak":true},"ezibeera ku bisenge ku lunaku olw’obutiti.",{"lineBreak":true},"Enjuba bw’evaayo zibuuka",{"lineBreak":true},"ne ziraga etamanyiddwa."]},{"type":"verse","number":18,"content":["Abasumba bo nga babongoota, ggwe kabaka wa Bwasuli,",{"lineBreak":true},"n’abakungu abeekitiibwa bagalamidde nga bawumuddeko.",{"lineBreak":true},"Abantu bo basaasaanira ku nsozi",{"lineBreak":true},"nga tewali n’omu abakuŋŋaanya."]},{"type":"verse","number":19,"content":["Tewali kisobola kuwonya",{"lineBreak":true},"kiwundu kyo ekinene bwe kityo.",{"lineBreak":true},"Bonna abawulira ebikuguddeko",{"lineBreak":true},"bakuba bukubi mu ngalo olw’okugwa kwo.",{"lineBreak":true},"Ani ataakosebwa",{"lineBreak":true},"olw’ettima lyo eringi?  Kubanga muntu ki ataatuusibwako bukambwe bwo obwa buli kakedde?"]}],"footnotes":[{"noteId":1,"text":"Abapuuti ne Abapuuli balabika nga baali bantu ba mu kitundu kye kimu. Puuti ye Libiya oba ekitundu ekyetoolodde n’okutuukira ddala ku Somaliya","caller":null,"verse":9}]}]}