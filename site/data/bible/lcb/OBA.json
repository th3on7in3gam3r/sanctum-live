{"id":"OBA","name":"Obadiya","chapters":[{"number":1,"content":[{"type":"verse","number":1,"content":["Kuno kwe kwolesebwa kwa Obadiya.     Mukama Ayinzabyonna kwe yamuwa ku bikwata ku nsi ya Edomu.",{"lineBreak":true},"Tuwulidde obubaka obuva eri Katonda,",{"lineBreak":true},"Katonda yaweereza omubaka eri amawanga n’obubaka buno nti,",{"lineBreak":true},"“Mugolokoke tulumbe Edomu tumulwanyise.”"]},{"type":"verse","number":2,"content":["“Laba, ndibafuula aba wansi ennyo mu mawanga,",{"lineBreak":true},"era olinyoomererwa ddala."]},{"type":"verse","number":3,"content":["Mwelimbye n’amalala agali mu mitima gyammwe,",{"lineBreak":true},"mmwe abasula mu mpuku ez’omu njazi,",{"lineBreak":true},"era ne muzimba amaka gammwe waggulu ku njazi.",{"lineBreak":true},"Mmwe aboogera nti,",{"lineBreak":true},"‘Ani alituwanulayo n’atussa wansi?’"]},{"type":"verse","number":4,"content":["Wadde nga mwewanika waggulu ng’empungu",{"lineBreak":true},"era ne muzimba ebisu byammwe wakati w’emmunyeenye,",{"lineBreak":true},"ndibawanulayo ne mbasuula wansi,”",{"lineBreak":true},"bw’ayogera Mukama."]},{"type":"verse","number":5,"content":["“Singa ababbi babajjira,",{"lineBreak":true},"n’abanyazi ne babalumba ekiro,",{"lineBreak":true},"akabi nga kaba kabatuuseeko.",{"lineBreak":true},"Tebandibabbyeko byonna bye baagala?",{"lineBreak":true},"Oba singa abanozi b’emizabbibu bakujjiridde,",{"lineBreak":true},"tebandireseeko obuzabbibu butono nnyo?"]},{"type":"verse","number":6,"content":["Esawu alinyagulurwa,",{"lineBreak":true},"eby’obugagga bye ebikusike birinyagibwa."]},{"type":"verse","number":7,"content":["Abaalagaana naawe balikusindiikiriza ku nsalo,",{"lineBreak":true},"Mikwano gyo balikulimbalimba ne bakuwangula;",{"lineBreak":true},"abo abalya emmere yo balikutega omutego,",{"lineBreak":true},"balikutega omutego kyokka toliguvumbula."]},{"type":"verse","number":8,"content":["“Ku lunaku olwo,",{"lineBreak":true},"sirizikiriza bagezi b’e Edomu,",{"lineBreak":true},"abantu ab’amagezi ababeera mu nsozi za Esawu?” bw’ayogera Mukama."]},{"type":"verse","number":9,"content":["“Abalwanyi bo abazira ggwe, Temani, balitya,",{"lineBreak":true},"era na buli muntu mu nsozi za Esawu",{"lineBreak":true},"alittibwa."]},{"type":"verse","number":10,"content":["Olw’ebikolwa eby’obukambwe ebyo bye wakola muganda wo Yakobo,",{"lineBreak":true},"oliswazibwa.",{"lineBreak":true},"Olizikirizibwa n’otaddayo kuwulirwa."]},{"type":"verse","number":11,"content":["Ku lunaku lwe wayimirira ku bbali n’otofaayo,",{"lineBreak":true},"nga banyaga obugagga bwa Isirayiri,",{"lineBreak":true},"ne bannaggwanga ne bayingira mu miryango gye,",{"lineBreak":true},"ne bakuba obululu okulaba atwala Yerusaalemi,",{"lineBreak":true},"wali omu ku bo."]},{"type":"verse","number":12,"content":["Tosaanye kusekerera muganda wo",{"lineBreak":true},"mu biseera bye eby’okulaba ennaku,",{"lineBreak":true},"wadde okusanyuka ku lunaku",{"lineBreak":true},"olw’okuzikirira kw’abantu ba Yuda,",{"lineBreak":true},"newaakubadde okwewaana ennyo",{"lineBreak":true},"ku lunaku lwe baatawaanyizibwa ennyo."]},{"type":"verse","number":13,"content":["Temukumba nga muyita mu miryango gy’abantu bange",{"lineBreak":true},"ku lunaku kwe baalabira obuyinike,",{"lineBreak":true},"wadde okubasekerera",{"lineBreak":true},"ku lunaku kwe baabonaabonera,",{"lineBreak":true},"newaakubadde okutwala obugagga bwabwe",{"lineBreak":true},"ku lunaku lwe baatuukibwako akabi."]},{"type":"verse","number":14,"content":["Temulindira mu masaŋŋanzira",{"lineBreak":true},"okutta abo abadduka,",{"lineBreak":true},"wadde okuwaayo abawonyeewo",{"lineBreak":true},"mu biro eby’okulabiramu ennaku."]},{"type":"verse","number":15,"content":["“Olunaku luli kumpi kwe ndisalira",{"lineBreak":true},"amawanga gonna omusango.",{"lineBreak":true},"Nga bwe mwakola abalala, nammwe bwe mulikolebwa.",{"lineBreak":true},"Ebikolwa byammwe biribaddira."]},{"type":"verse","number":16,"content":["Ng’abantu bange bwe baanywa ekikompe eky’ekibonerezo ku lusozi lwange olutukuvu",{"lineBreak":true},"n’amawanga ageetooloddewo bwe galikinywa obutakoma;",{"lineBreak":true},"balikinywa,",{"lineBreak":true},"babe ng’abataganywangako."]},{"type":"verse","number":17,"content":["Naye ku Lusozi Sayuuni baliwona,",{"lineBreak":true},"kubanga lutukuvu,",{"lineBreak":true},"n’ennyumba ya Yakobo",{"lineBreak":true},"eritwala omugabo gwabwe."]},{"type":"verse","number":18,"content":["Ennyumba ya Yakobo eriba omuliro,",{"lineBreak":true},"n’ennyumba ya Yusufu olulimi olw’omuliro.",{"lineBreak":true},"Ennyumba ya Esawu eriba bisusunku,",{"lineBreak":true},"era baligyokya n’eggwaawo.",{"lineBreak":true},"Tewaliba muntu wa nnyumba ya Esawu",{"lineBreak":true},"n’omu alisigalawo,",{"lineBreak":true},"kubanga Mukama akyogedde."]},{"type":"verse","number":19,"content":["“Abantu b’e Negebu balitwala",{"lineBreak":true},"olusozi Esawu,",{"lineBreak":true},"n’abantu ab’omu biwonvu balitwala",{"lineBreak":true},"ensi y’Abafirisuuti.",{"lineBreak":true},"Balyetwalira n’ennimiro ez’omu Efulayimu ne Samaliya,",{"lineBreak":true},"ne Benyamini ne yeetwalira Gireyaadi."]},{"type":"verse","number":20,"content":["Ekibiina ky’Abayisirayiri abaali mu buwaŋŋanguse e Kanani,",{"lineBreak":true},"balyetwalira ensi, okutuukira ddala ku Zalefaasi;",{"lineBreak":true},"abawaŋŋanguse abaava mu Yerusaalemi abali mu Sefalaadi,",{"lineBreak":true},"balyetwalira ebibuga mu Negebu."]},{"type":"verse","number":21,"content":["Abanunuzi balyambuka ku Lusozi Sayuuni,",{"lineBreak":true},"okufuga ensozi za Esawu.",{"lineBreak":true},"Obwakabaka buliba bwa Mukama.”"]}],"footnotes":[]}]}