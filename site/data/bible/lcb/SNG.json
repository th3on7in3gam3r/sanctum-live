{"id":"SNG","name":"Oluyimba","chapters":[{"number":1,"content":[{"type":"verse","number":1,"content":["Oluyimba lwa Sulemaani olusinga ennyimba zonna."]},{"type":"heading","content":["Omwagalwa"]},{"type":"verse","number":2,"content":["Leka annywegere n’emimwa gye",{"lineBreak":true},"kubanga okwagala kwo kusinga envinnyo,"]},{"type":"verse","number":3,"content":["n’amafuta go gawunya akaloosa akalungi;",{"lineBreak":true},"erinnya lyo liri ng’amafuta agattululwa,",{"lineBreak":true},"era abawala kyebava bakwagala."]},{"type":"verse","number":4,"content":["Baako ne gy’ontwala, yanguwa!",{"lineBreak":true},"Kabaka ansembezezza kumpi nnyo antutte mu bisenge bye.",{"lineBreak":true},"Tunaasanyuka ne tukujagulizaamu;",{"lineBreak":true},"era tunaatendereza okwagala kwo okusinga envinnyo.",{"lineBreak":true},"Nga batuufu okukwegomba!"]},{"type":"heading","content":["Abemikwano"]},{"type":"heading","content":["Omwagalwa"]},{"type":"verse","number":5,"content":["Ndi muddugavu, ndi mulungi,",{"lineBreak":true},"Mmwe abawala ba Yerusaalemi",{"lineBreak":true},"muli ng’eweema ez’e Kedali,",{"noteId":1},{"lineBreak":true},"era ng’entimbe za Sulemaani."]},{"type":"verse","number":6,"content":["Temuntunuulira kubanga ndi muddugavu,",{"lineBreak":true},"olw’okuba omusana gunjokezza.",{"lineBreak":true},"Batabani ba mmange baansunguwalira;",{"lineBreak":true},"ne bandagira okukuuma ennimiro ez’emizabbibu.",{"lineBreak":true},"Ennimiro yange ngigayaaliridde."]},{"type":"verse","number":7,"content":["Ntegeeza ggwe gwe njagala, gy’oliisiza ekisibo kyo,",{"lineBreak":true},"ne gy’owumuliza endiga zo mu ssaawa ez’omu ttuntu.",{"lineBreak":true},"Lwaki mbeera ng’omukazi eyeebisse amaaso",{"lineBreak":true},"nga nninaanye ebisibo eby’abanywanyi bo?"]},{"type":"heading","content":["Abemikwano"]},{"type":"verse","number":8,"content":["Bw’oba nga tomanyi, ggwe omukyala asinga bonna obulungi,",{"lineBreak":true},"goberera ekkubo endiga lye zikutte,",{"lineBreak":true},"ogende oliisize embuzi zo ento,",{"lineBreak":true},"okumpi n’eweema z’abasumba."]},{"type":"heading","content":["Owoomukwano"]},{"type":"verse","number":9,"content":["Omwagalwa wange,",{"lineBreak":true},"nkugeraageranya n’embalaasi esika amagaali ga Falaawo."]},{"type":"verse","number":10,"content":["Amatama go galabika bulungi ng’oyambadde ebikomo eby’oku matu,",{"lineBreak":true},"n’ensingo yo nerabika bulungi ng’erimu eby’omu bulago eby’omuwendo."]},{"type":"verse","number":11,"content":["Tunaakukolera eby’oku matu ebya zaabu,",{"lineBreak":true},"nga birina amapeesa aga ffeeza."]},{"type":"heading","content":["Omwagalwa"]},{"type":"verse","number":12,"content":["Kabaka bwe yali ng’atudde ku mmeeza ye,",{"lineBreak":true},"akawoowo kange ne kamuwunyira bulungi."]},{"type":"verse","number":13,"content":["Muganzi wange ali ng’ensawo eya kaloosa aka mooli",{"noteId":2},"gye ndi,",{"lineBreak":true},"ng’awummulidde mu kifuba kyange."]},{"type":"verse","number":14,"content":["Muganzi wange ali ng’ekiganda eky’ebimuli ebya kofera",{"noteId":3},{"lineBreak":true},"ebivudde mu nnimiro ez’emizabbibu ez’e Engedi.",{"noteId":4}]},{"type":"heading","content":["Owoomukwano"]},{"type":"verse","number":15,"content":["Laba, oli mubalagavu, omwagalwa wange",{"lineBreak":true},"oli mubalagavu olabika bulungi.",{"lineBreak":true},"Amaaso go mayiba."]},{"type":"heading","content":["Omwagalwa"]},{"type":"verse","number":16,"content":["Olabika bulungi muganzi wange,",{"lineBreak":true},"era onsanyusa.",{"lineBreak":true},"Ekitanda kyaffe kya muddo muto."]},{"type":"heading","content":["Owoomukwano"]},{"type":"verse","number":17,"content":["Emikiikiro gy’ennyumba yaffe mivule,",{"lineBreak":true},"n’enzooba zaffe nkanaga."]}],"footnotes":[{"noteId":1,"text":"Abantu b’e Kedali baali Bawalabu abaabeeranga mu bukiikaddyo obw’obuvanjuba wa Edomu. Baabeeranga mu weema ze baakolanga mu maliba g’embuzi enzirugavu.","caller":null,"verse":5},{"noteId":2,"text":"Mooli kaloosa kalungi nnyo akakolebwa okuva mu balusamu nga kasangibwa mu Esiyopya, ne mu Buyindi, ne mu nsi za Buwalabu. Mooli yakozesebwanga ng’obuwoowo mu biseera ebyo","caller":null,"verse":13},{"noteId":3,"text":"Kofera kimuli ky’akaloosa kalungi, era kikolebwamu obuwoowo.","caller":null,"verse":14},{"noteId":4,"text":"Engedi nsulo y’amazzi esangibwa ku luuyi olw’obugwanjuba bw’Ennyanja ey’Omunnyo, era we luli wamerawo ebimera ebyakaloosa bingi.","caller":null,"verse":14}]},{"number":2,"content":[{"type":"verse","number":1,"content":["Ndi kimuli kya looza ekya Saloni,",{"noteId":5},{"lineBreak":true},"eddanga ery’omu biwonvu."]},{"type":"heading","content":["Owoomukwano"]},{"type":"verse","number":2,"content":["Ng’eddanga mu maggwa,",{"lineBreak":true},"gwe njagala ennyo bw’ali bw’atyo mu baweereza abakazi."]},{"type":"heading","content":["Omwagalwa"]},{"type":"verse","number":3,"content":["Ng’omucungwa mu miti egy’omu kibira,",{"lineBreak":true},"aŋŋanza bw’ali bw’atyo mu bavubuka.",{"lineBreak":true},"Neesiima okutuula mu kisiikirize kye,",{"lineBreak":true},"n’ekibala kye kimpomera."]},{"type":"verse","number":4,"content":["Yantwala ku kijjulo,",{"lineBreak":true},"n’okwagala kwe ne ku mmaamira."]},{"type":"verse","number":5,"content":["Munzizeemu amaanyi n’ezabbibu enkalu,",{"lineBreak":true},"mumbuddeebudde n’emicungwa",{"lineBreak":true},"kubanga okwagala kunzirisizza."]},{"type":"verse","number":6,"content":["Omukono gwe ogwa kkono guli wansi wa mutwe gwange,",{"lineBreak":true},"n’omukono gwe ogwa ddyo gumpambatira."]},{"type":"verse","number":7,"content":["Mmwe abawala ba Yerusaalemi, mbakuutira,",{"lineBreak":true},"ng’empeewo n’enjaza ez’omu ttale,",{"lineBreak":true},"temusisimula newaakubadde okuzuukusa okwagala",{"lineBreak":true},"okutuusa nga kweyagalidde."]},{"type":"verse","number":8,"content":["Wuliriza omwagalwa wange,",{"lineBreak":true},"Laba, ajja",{"lineBreak":true},"ng’abuukirabuukira ku nsozi,",{"lineBreak":true},"ng’azinira ku busozi."]},{"type":"verse","number":9,"content":["Omwagalwa wange ali ng’empeewo oba ennangaazi ento.",{"lineBreak":true},"Laba ayimiridde emabega w’olukomera lwaffe,",{"lineBreak":true},"Alingiza mu madirisa,",{"lineBreak":true},"alabikira mu mulimu ogulukibwa ogw’omu ddirisa."]},{"type":"verse","number":10,"content":["Omwagalwa wange yaŋŋamba nti,",{"lineBreak":true},"“Golokoka, Owoomukwano,",{"lineBreak":true},"omulungi wange, ojje tugende,"]},{"type":"verse","number":11,"content":["kubanga laba ttoggo aweddeko,",{"lineBreak":true},"n’enkuba eweddeyo."]},{"type":"verse","number":12,"content":["Ebimuli bimulisizza,",{"lineBreak":true},"n’ebiro eby’okuyimba bituuse,",{"lineBreak":true},"era n’okukaaba kw’amayiba",{"lineBreak":true},"kuwulirwa mu nsi."]},{"type":"verse","number":13,"content":["Omutiini",{"noteId":6},"gubala ettiini zaagwo,",{"lineBreak":true},"n’emizabbibu gimulisizza ne gibunya akawoowo kaagyo.",{"lineBreak":true},"Golokoka Owoomukwano,",{"lineBreak":true},"omulungi wange ojje tugende.”"]},{"type":"heading","content":["Owoomukwano"]},{"type":"verse","number":14,"content":["Ggwe ejjiba lyange, eribeera mu njatika ez’omu njazi,",{"lineBreak":true},"mu bwekwekero obw’amayinja,",{"lineBreak":true},"ndaga amaaso go,",{"lineBreak":true},"ka mpulire eddoboozi lyo,",{"lineBreak":true},"kubanga eddoboozi lyo ddungi nnyo,",{"lineBreak":true},"n’amaaso go gasanyusa."]},{"type":"verse","number":15,"content":["Tukwatire ebibe,",{"lineBreak":true},"obube obutono,",{"lineBreak":true},"obwonoona ennimiro ez’emizabbibu,",{"lineBreak":true},"kubanga ennimiro zaffe ez’emizabbibu zimulisizza."]},{"type":"heading","content":["Omwagalwa"]},{"type":"verse","number":16,"content":["Muganzi wange, wange nzekka, era nange ndi wuwe;",{"lineBreak":true},"aliisiza ekisibo kye mu malanga,"]},{"type":"verse","number":17,"content":["okutuusa obudde nga bukedde",{"lineBreak":true},"n’ebisiikirize nga biddukidde ddala;",{"lineBreak":true},"okyuke omwagalwa wange obe ng’empeewo",{"lineBreak":true},"oba ennangaazi ento ku busozi obw’e Beseri."]}],"footnotes":[{"noteId":5,"text":"Ekimuli kya Looza ekya Saloni kimera ekisangibwa mu nsenyi z’omu bukiikaddyo bwa Kalumeeri.","caller":null,"verse":1},{"noteId":6,"text":"Emitiini mu Isirayiri gibala emirundi ebiri mu mwaka. Amakungula agasinga galingawo mu biseera ebya ttoggo","caller":null,"verse":13}]},{"number":3,"content":[{"type":"verse","number":1,"content":["Ekiro kyonna nga ndi ku kitanda kyange,",{"lineBreak":true},"nalindirira emmeeme yange gw’eyagala,",{"lineBreak":true},"ne munoonya naye saamulaba."]},{"type":"verse","number":2,"content":["Nnaagolokoka ne ntambulatambulako mu kibuga,",{"lineBreak":true},"mu nguudo ne mu bifo ebigazi;",{"lineBreak":true},"nanoonya emmeeme yange gw’eyagala,",{"lineBreak":true},"ne nnindirira naye saamulaba."]},{"type":"verse","number":3,"content":["Abakuumi b’ekibuga",{"lineBreak":true},"abaali balawuna mu kibuga, ne bansisinkana, ne mbabuuza nti,",{"lineBreak":true},"“Mundabidde ku oyo emmeeme yange gw’eyagala?”"]},{"type":"verse","number":4,"content":["Twali twakayisiŋŋanya,",{"lineBreak":true},"ne ndaba oyo emmeeme yange gw’eyagala.",{"lineBreak":true},"Ne munnywegera ne simuganya kugenda,",{"lineBreak":true},"okutuusa lwe namuleeta mu nnyumba ya mmange,",{"lineBreak":true},"ne mutwala mu kisenge ky’oyo eyanzaala."]},{"type":"verse","number":5,"content":["Mbakuutira mmwe abawala ba Yerusaalemi,",{"lineBreak":true},"ng’empeewo n’enjaza ez’oku ttale,",{"lineBreak":true},"temusisimula newaakubadde okuzuukusa okwagala",{"lineBreak":true},"okutuusa nga kwesiimidde."]},{"type":"verse","number":6,"content":["Ani oyo ajja ng’ava mu ddungu,",{"lineBreak":true},"afaanana ng’empagi ey’omukka,",{"lineBreak":true},"asaabye ebyakaloosa ebya mooli n’omugavu,",{"lineBreak":true},"okuva mu byakaloosa byonna eby’omusuubuzi?"]},{"type":"verse","number":7,"content":["Laba, kye kigaali kya Sulemaani,",{"lineBreak":true},"ekiwerekeddwako abasajja ab’amaanyi nga nkaaga,",{"lineBreak":true},"abalwanyi abazira abasingayo mu Isirayiri,"]},{"type":"verse","number":8,"content":["bonna balina ebitala,",{"lineBreak":true},"era bamanyirivu mu kulwana;",{"lineBreak":true},"buli omu n’ekitala kye mu kiwato kye,",{"lineBreak":true},"nga beetegekedde entiisa ey’ekiro."]},{"type":"verse","number":9,"content":["Kabaka Sulemaani yeekolera ekigaali",{"lineBreak":true},"eky’emiti egy’omu Lebanooni."]},{"type":"verse","number":10,"content":["Empagi zaakyo yazisiigako ffeeza,",{"lineBreak":true},"ne wansi waakyo nga wa zaabu,",{"lineBreak":true},"n’entebe yaamu ng’eriko olugoye lwa ffulungu;",{"lineBreak":true},"ne munda nga mwaliire bulungi n’okwagala,",{"lineBreak":true},"okw’abawala ba Yerusaalemi."]},{"type":"verse","number":11,"content":["Mufulume, mmwe abawala ba Sayuuni,",{"lineBreak":true},"mulabe ku Kabaka Sulemaani ng’ayambadde engule,",{"lineBreak":true},"engule nnyina gye yamutikkira",{"lineBreak":true},"ku lunaku olw’embaga ye,",{"lineBreak":true},"ku lunaku omutima gwe kwe gwasanyukira."]}],"footnotes":[]},{"number":4,"content":[{"type":"heading","content":["Owoomukwano"]},{"type":"verse","number":1,"content":["Ng’olabika bulungi, gwe njagala, laba ondabikidde bulungi.",{"lineBreak":true},"Amaaso go mayiba mu lugoye mw’ogabisse.",{"lineBreak":true},"Enviiri zo ziri ng’eggana ly’embuzi",{"lineBreak":true},"eziserengeta okuva ku lusozi Gireyaadi."]},{"type":"verse","number":2,"content":["Amannyo go gali ng’ekisibo ky’endiga nga kye zijje zisalibweko ebyoya,",{"lineBreak":true},"nga ziva okunaazibwa.",{"lineBreak":true},"Buli emu nnongo eri n’ennongo ginnaayo,",{"lineBreak":true},"so tewali eri yokka."]},{"type":"verse","number":3,"content":["Emimwa gyo giri ng’ewuzi ey’olugoye olutwakaavu;",{"lineBreak":true},"n’akamwa ko kandabikira bulungi.",{"lineBreak":true},"Amatama go mu lugoye lw’ogabisseeko",{"lineBreak":true},"gali ng’ekitundu ky’ekkomamawanga.",{"noteId":7}]},{"type":"verse","number":4,"content":["Ensingo yo eri ng’omulongooti gwa Dawudi,",{"lineBreak":true},"ogwatereezebwa obulungi;",{"lineBreak":true},"ne ku gwo nga kuliko engabo lukumi,",{"lineBreak":true},"zonna nga ngabo z’abasajja abalwanyi."]},{"type":"verse","number":5,"content":["Amabeere go gombi gali ng’abaana b’empeewo,",{"lineBreak":true},"ab’empeewo, nga balongo,",{"lineBreak":true},"abaliira mu malanga."]},{"type":"verse","number":6,"content":["Okutuusa obudde nga bukedde,",{"lineBreak":true},"n’ebisiikirize nga biweddewo,",{"lineBreak":true},"ndigenda ku lusozi olunene olwa mooli",{"lineBreak":true},"ne ku kasozi ak’omugavu."]},{"type":"verse","number":7,"content":["Ng’olabika bulungi wenna, omwagalwa wange,",{"lineBreak":true},"toliiko bbala na limu."]},{"type":"verse","number":8,"content":["Jjangu tuve mu Lebanooni, omugole wange,",{"lineBreak":true},"jjangu tuve mu Lebanooni.",{"lineBreak":true},"Lengera okuva ku ntikko ya Amana,",{"lineBreak":true},"n’okuva ku ntikko ya Seniri ne ku ntikko ya Kerumooni,",{"lineBreak":true},"n’okuva mu mpuku ey’empologoma,",{"lineBreak":true},"ne ku nsozi ez’engo."]},{"type":"verse","number":9,"content":["Osenzesenze omutima gwange,",{"lineBreak":true},"mwannyinaze, omugole wange;",{"lineBreak":true},"otutte omutima gwange, ne munye y’eriiso lyo gy’onkubye,",{"lineBreak":true},"n’omukuufu ogumu ogw’omu bulago bwo."]},{"type":"verse","number":10,"content":["Ng’okwagala kwo kulungi mwannyinaze, omugole wange,",{"lineBreak":true},"okwagala kwo nga kusinga nnyo envinnyo,",{"lineBreak":true},"n’akawoowo ak’amafuta go kasinga eby’akawoowo eby’engeri zonna obulungi."]},{"type":"verse","number":11,"content":["Emimwa gyo gitonnya obuwoomi ng’ebisenge eby’omubisi gw’enjuki, omugole wange;",{"lineBreak":true},"amata n’omubisi gw’enjuki biri wansi w’olulimi lwo.",{"lineBreak":true},"Akaloosa ak’ebyambalo byo kali ng’akawoowo ak’e Lebanooni."]},{"type":"verse","number":12,"content":["Oli nnimiro eyasimbibwa, mwannyinaze, omugole wange,",{"lineBreak":true},"era oli luzzi olwasibibwa",{"noteId":8},", ensulo eyateekebwako akabonero."]},{"type":"verse","number":13,"content":["Ebimera byo nnimiro ya mikomamawanga,",{"lineBreak":true},"erina ebibala byonna eby’omuwendo,",{"lineBreak":true},"ne kofera n’emiti egy’omugavu"]},{"type":"verse","number":14,"content":["n’omugavu ne kalikomu,",{"lineBreak":true},"ne kalamo ne kinamoni,",{"lineBreak":true},"n’emiti egy’ebika by’omugavu byonna,",{"lineBreak":true},"ne mooli ne alowe,",{"lineBreak":true},"wamu n’eby’akawoowo byonna ebisinga obulungi."]},{"type":"verse","number":15,"content":["Oli nsulo ya nnimiro,",{"lineBreak":true},"oluzzi olw’amazzi amalamu,",{"lineBreak":true},"olukulukuta okuva mu Lebanooni.",{"noteId":9}]},{"type":"heading","content":["Omwagalwa"]},{"type":"verse","number":16,"content":["Zuukuka gwe empewo ey’obukiikakkono,",{"lineBreak":true},"naawe empewo ey’obukiikaddyo jjangu.",{"noteId":10},{"lineBreak":true},"Mukuntire ku nnimiro yange,",{"lineBreak":true},"akaloosa, kaayo akalungi kasaasaane wonna,",{"lineBreak":true},"Muleke muganzi wange ajje mu nnimiro ye,",{"lineBreak":true},"alye ebibala byamu eby’omuwendo."]}],"footnotes":[{"noteId":7,"text":"Amakomamawanga mamyufu","caller":null,"verse":3},{"noteId":8,"text":"Enzizi zaasibibwanga okukuuma amazzi gaamu nga mayonjo.","caller":null,"verse":12},{"noteId":9,"text":"Ku ntikko y’Olusozi lwa Lebanooni lwalingako omuzira, ng’eyo amazzi gye gava ne gakola emigga egikulukuta amazzi agatakalira","caller":null,"verse":15},{"noteId":10,"text":"Empewo ey’obukiikakkono ereeta obunnyogovu era ereka ebibala biramu bulungi. Empewo ey’obukiikaddyo ereeta kibuguumirize, era eyengeza ebibala. Empewo ez’engeri zombi zireeta akawoowo akalungi mu nnimiro","caller":null,"verse":16}]},{"number":5,"content":[{"type":"heading","content":["Owoomukwano"]},{"type":"verse","number":1,"content":["Nzize mu nnimiro yange mwannyinaze, omugole wange;",{"lineBreak":true},"nkuŋŋaanyiza mooli yange n’eby’akawoowo byange.",{"lineBreak":true},"Ndidde ebisenge byange eby’omubisi gw’enjuki gwange ne nywa n’omubisi gwange,",{"lineBreak":true},"Nywedde wayini wange n’amata gange.",{"lineBreak":true},"Abemikwano mulye munywe, munywere ddala, mmwe abaagalana."]},{"type":"heading","content":["Abemikwano"]},{"type":"heading","content":["Omwagalwa"]},{"type":"verse","number":2,"content":["Nnali ngalamidde, ng’omutima gwange guwulira.",{"lineBreak":true},"Ne mpulira muganzi wange ng’akonkona, n’ayogera nti,",{"lineBreak":true},"“Nziguliraawo mwannyinaze, Owoomukwano, ejjiba lyange,",{"lineBreak":true},"owe wange ataliiko bbala,",{"lineBreak":true},"kubanga omutwe gwange gutobye omusulo,",{"lineBreak":true},"n’enviiri zange zibisiwadde olw’obunnyogovu.”"]},{"type":"verse","number":3,"content":["Nziggyeko ekkooti yange,",{"lineBreak":true},"nnaagyambala ntya nate?",{"lineBreak":true},"Nanaabye ebigere,",{"lineBreak":true},"nnaddayo ntya mu ttaka gye binaddugalira?"]},{"type":"verse","number":4,"content":["Muganzi wange bwe yakwata ku munyolo,",{"lineBreak":true},"omutima gwange ne gubuukabuuka."]},{"type":"verse","number":5,"content":["Ne ngolokoka okuggulirawo muganzi wange,",{"lineBreak":true},"emikono gyange nga gitonnya mooli,",{"lineBreak":true},"n’engalo zange nga zikulukuta mooli,",{"lineBreak":true},"ku minyolo gy’ekufulu."]},{"type":"verse","number":6,"content":["Ne ŋŋenda okuggulirawo muganzi wange,",{"lineBreak":true},"naye muganzi wange ng’avuddewo,",{"lineBreak":true},"yeetambulidde.",{"lineBreak":true},"Omutima gwange gwasanyuka bwe nnawulira eddoboozi lye.",{"lineBreak":true},"Ne munoonya naye n’ambula, ne mukoowoola naye nga taddamu."]},{"type":"verse","number":7,"content":["Abakuumi baansanga",{"lineBreak":true},"bwe baali nga balawuna mu kibuga;",{"lineBreak":true},"baankuba, ne bandeetako ebinuubule,",{"lineBreak":true},"ne batwala n’ekyambalo kyange,",{"lineBreak":true},"abasajja abo abakuuma bbugwe."]},{"type":"verse","number":8,"content":["Mmwe abawala ba Yerusaalemi,",{"lineBreak":true},"mbakuutira nti bwe mulaba ku muganzi wange,",{"lineBreak":true},"mumutegeeze ng’okwagala kwange",{"lineBreak":true},"gy’ali bwe kunzita."]},{"type":"heading","content":["Abemikwano"]},{"type":"verse","number":9,"content":["Owange, kiki muganzi wo ky’alina",{"lineBreak":true},"kyasinza abalungi abalala ggwe omukazi akira abalala obulungi?",{"lineBreak":true},"Kiki muganzi wo kyasinza abalala",{"lineBreak":true},"n’okutukuutira n’otukuutira bw’otyo?"]},{"type":"heading","content":["Omwagalwa"]},{"type":"verse","number":10,"content":["Muganzi wange alabika bulungi nnyo era mumyufu,",{"lineBreak":true},"atabula ne mu bantu omutwalo."]},{"type":"verse","number":11,"content":["Omutwe gwe gwa zaabu ennongoose ennyo;",{"lineBreak":true},"n’enviiri ze zirimu amayengo,",{"lineBreak":true},"era nzirugavu nga nnamuŋŋoona."]},{"type":"verse","number":12,"content":["Amaaso ge gali ng’amayiba",{"lineBreak":true},"ku mabbali g’emigga egy’amazzi,",{"lineBreak":true},"agaanaazibwa n’amata,",{"lineBreak":true},"ne gaba ng’amayinja ag’omuwendo omungi."]},{"type":"verse","number":13,"content":["Amatama ge gali ng’emisiri egy’obuwoowo,",{"lineBreak":true},"obuleeta akaloosa akalungi.",{"lineBreak":true},"Emimwa gye giri ng’amalanga",{"lineBreak":true},"agakulukuta mooli."]},{"type":"verse","number":14,"content":["Emikono gye giri ng’emitayimbwa egya zaabu",{"lineBreak":true},"egiteekebwamu amayinja ag’omuwendo.",{"lineBreak":true},"Omubiri gwe guli ng’amasanga",{"lineBreak":true},"amayooyote agatoneddwa ne safiro."]},{"type":"verse","number":15,"content":["Amagulu ge gali ng’empagi ez’amayinja aganyirira",{"lineBreak":true},"ezisimbibwa mu zaabu ennungi.",{"lineBreak":true},"Mu ndabika afaanana Lebanooni",{"lineBreak":true},"omulungi ng’emivule gyayo."]},{"type":"verse","number":16,"content":["Enjogera ye mpomerevu,",{"lineBreak":true},"weewaawo awamu n’ebyo byonna ayagalibwa.",{"lineBreak":true},"Ono ye muganzi wange, ye mukwano gwange;",{"lineBreak":true},"mmwe abawala ba Yerusaalemi."]}],"footnotes":[]},{"number":6,"content":[{"type":"heading","content":["Abemikwano"]},{"type":"verse","number":1,"content":["Muganzi wo alaze wa,",{"lineBreak":true},"ggwe akira abakyala bonna obulungi?",{"lineBreak":true},"Muganzi wo yakutte lya wa",{"lineBreak":true},"tumukunoonyezeeko?"]},{"type":"heading","content":["Omwagalwa"]},{"type":"verse","number":2,"content":["Muganzi wange aserengese mu nnimiro ye,",{"lineBreak":true},"mu misiri egy’ebirime ebyakaloosa,",{"lineBreak":true},"okulabirira ennimiro ye",{"lineBreak":true},"n’okunoga amalanga."]},{"type":"verse","number":3,"content":["Muganzi wange, wange, nange ndi wuwe;",{"lineBreak":true},"anoonyeza mu malanga."]},{"type":"heading","content":["Owoomukwano"]},{"type":"verse","number":4,"content":["Oli mubalagavu nga Tiruza,",{"noteId":11},{"lineBreak":true},"omwagalwa wange, omulungi nga Yerusaalemi,",{"lineBreak":true},"era ow’ekitiibwa ng’eggye eririna ebendera."]},{"type":"verse","number":5,"content":["Tontunuulira nnyo",{"lineBreak":true},"kubanga amaaso go gantawanya.",{"lineBreak":true},"Enviiri zo ziri ng’ekisibo eky’embuzi,",{"lineBreak":true},"eziserengeta okuva e Gireyaadi."]},{"type":"verse","number":6,"content":["Amannyo go gali ng’ekisibo eky’endiga",{"lineBreak":true},"eziva okunaazibwa;",{"lineBreak":true},"buli emu nnongo eri n’ennongo ginnaayo,",{"lineBreak":true},"so tewali eri yokka."]},{"type":"verse","number":7,"content":["Obwenyi bwo bw’obisse mu lugoye,",{"lineBreak":true},"buli ng’ebitundu by’amakomamawanga."]},{"type":"verse","number":8,"content":["Ne bwe walibeerawo bakabaka abakazi nkaaga,",{"lineBreak":true},"n’abazaana kinaana,",{"lineBreak":true},"n’abawala embeerera abatamanyiddwa muwendo,"]},{"type":"verse","number":9,"content":["ejjiba lyange, owange ataliiko bbala, ow’enjawulo,",{"lineBreak":true},"mwana muwala eyazaalibwa yekka, ayagalibwa ennyo nnyina",{"lineBreak":true},"okusinga abalala, y’ansingira mu bonna.",{"lineBreak":true},"Abawala baamulaba ne bamuyita wa mukisa;",{"lineBreak":true},"bakabaka abakazi n’abazaana baamutenda."]},{"type":"heading","content":["Abemikwano"]},{"type":"verse","number":10,"content":["Ani ono alabika ng’emmambya,",{"lineBreak":true},"omulungi ng’omwezi, atangalijja ng’enjuba,",{"lineBreak":true},"alina ekitiibwa ng’eky’emunnyeenye?"]},{"type":"heading","content":["Owoomukwano"]},{"type":"verse","number":11,"content":["Naserengeta mu nnimiro ey’emiti egy’ensigo okwetegereza",{"lineBreak":true},"okumulisa okw’ebimera eby’omu kiwonvu,",{"lineBreak":true},"okulaba omuzabbibu obanga gwamulisa,",{"lineBreak":true},"n’okulaba emikomamawanga oba nga gyamera."]},{"type":"verse","number":12,"content":["Bwe nnali nkyali awo",{"lineBreak":true},"emmeeme yange n’egenda eri amagaali ag’obwakabaka ag’omu bantu bange."]},{"type":"heading","content":["Abemikwano"]},{"type":"verse","number":13,"content":["Komawo, Komawo, ggwe Omusulamu;",{"lineBreak":true},"komawo, komawo tukutunuleko.",{"lineBreak":true},"Lwaki mutunuulira Omusulamu",{"lineBreak":true},"ng’abali ku mazina ga Makanayimu?"]},{"type":"heading","content":["Owoomukwano"]}],"footnotes":[{"noteId":11,"text":"Tiruza kyali kibuga kya dda mu Kanani ekyalondebwa Yerobowaamu mu 930-909 bc","caller":null,"verse":4}]},{"number":7,"content":[{"type":"verse","number":1,"content":["Ebigere byo nga birabika bulungi mu ngatto,",{"lineBreak":true},"ggwe omumbejja!",{"lineBreak":true},"Amagulu go gali ng’amayinja ag’omuwendo,",{"lineBreak":true},"omulimu gw’omuweesi omukalabakalaba."]},{"type":"verse","number":2,"content":["Ekkundi lyo kibya kyekulungirivu,",{"lineBreak":true},"ekitaggwaamu nvinnyo entabule obulungi.",{"lineBreak":true},"Ekiwato kyo ntuumu ya ŋŋaano",{"lineBreak":true},"eyeetooloddwa amalanga."]},{"type":"verse","number":3,"content":["Amabeere go gali ng’abaana b’empeewo,",{"lineBreak":true},"abalongo."]},{"type":"verse","number":4,"content":["Ensingo yo eri ng’omunaala ogw’amasanga.",{"lineBreak":true},"Amaaso go gali ng’ebidiba eby’omu Kesuboni",{"lineBreak":true},"ebiri ku mulyango ogw’e Basulabbimu.",{"lineBreak":true},"Ennyindo yo eri ng’omulongooti ogw’e Lebanooni",{"lineBreak":true},"ogwolekera Ddamasiko."]},{"type":"verse","number":5,"content":["Omutwe gwo gukuwoomera ng’olusozi Kalumeeri,",{"lineBreak":true},"n’enviiri zo ziranga emiguwa egy’effulungu;",{"lineBreak":true},"Kabaka asendebwasendebwa ebintu byakwo."]},{"type":"verse","number":6,"content":["Ng’olabika bulungi, ng’osanyusa",{"lineBreak":true},"ggwe omwagalwa n’obulungi bwo."]},{"type":"verse","number":7,"content":["Oli muwanvu ng’olukindu,",{"lineBreak":true},"n’amabeere go gali ng’ebirimba eby’ebibala byakwo."]},{"type":"verse","number":8,"content":["Nayogera nti, “Ndirinnya olukindu,",{"lineBreak":true},"era ndikwata ebibala byalwo.”",{"lineBreak":true},"Amabeere go gabeere ng’ebirimba eby’oku muzabbibu,",{"lineBreak":true},"n’akawoowo ak’omu kamwa ko ng’ebibala eby’omucungwa"]},{"type":"verse","number":9,"content":["n’akamwa ko nga nvinnyo esinga obulungi.",{"lineBreak":true},"Ne wayini amirwe bulungi muganzi wange,",{"lineBreak":true},"ng’akulukuta mpola mpola ku mimwa gy’abo abeebase."]},{"type":"heading","content":["Omwagalwa"]},{"type":"verse","number":10,"content":["Ndi wa muganzi wange,",{"lineBreak":true},"era naye anjagala nnyo."]},{"type":"verse","number":11,"content":["Jjangu, muganzi wange tugende ebweru w’ekibuga,",{"lineBreak":true},"tusuleko mu byalo."]},{"type":"verse","number":12,"content":["Tukeere tugende mu nnimiro z’emizabbibu,",{"lineBreak":true},"tulabe obanga emizabbibu gimulisizza,",{"lineBreak":true},"obanga n’ebimuli byagwo byanjuluzza,",{"lineBreak":true},"obanga n’emikomamawanga gimulisizza,",{"lineBreak":true},"era eyo gye nnaakulagira okwagala kwange."]},{"type":"verse","number":13,"content":["Amadudayimu",{"noteId":12},"gawunya akawoowo,",{"lineBreak":true},"ne ku miryango gyaffe waliwo ebibala ebisinga obulungi,",{"lineBreak":true},"Ebyakanogebwa awamu n’ebikadde,",{"lineBreak":true},"bye nkuterekedde muganzi wange."]}],"footnotes":[{"noteId":12,"text":"Amadudayimu gayamba mu by’okuzaala","caller":null,"verse":13}]},{"number":8,"content":[{"type":"verse","number":1,"content":["Singa wali muganda wange eyakuzibwa mmange",{"lineBreak":true},"era eyayonka amabeere ga mmange,",{"lineBreak":true},"nandikusanze ebweru",{"lineBreak":true},"nandikunywegedde",{"lineBreak":true},"ne wataba n’omu annyooma."]},{"type":"verse","number":2,"content":["Nandikukulembedde",{"lineBreak":true},"ne nkuleeta mu nnyumba ya mmange,",{"lineBreak":true},"oyo eyangigiriza.",{"lineBreak":true},"Nandikuwadde wayini okunywa ng’alimu ebyakaloosa,",{"lineBreak":true},"omubisi ogw’amakomamawanga gange."]},{"type":"verse","number":3,"content":["Omukono gwe ogwa kkono guli wansi wa mutwe gwange",{"lineBreak":true},"n’omukono gwe ogwa ddyo gumpambaatira."]},{"type":"verse","number":4,"content":["Mmwe abawala ba Yerusaalemi mbakuutira,",{"lineBreak":true},"temusiikuula newaakubadde okuzuukusa okwagala",{"lineBreak":true},"okutuusa ng’ekiseera ekituufu kituuse."]},{"type":"heading","content":["Abemikwano"]},{"type":"verse","number":5,"content":["Ani oyo gwe tulengera ng’ava mu ddungu",{"lineBreak":true},"nga yeesigamye muganzi we?",{"lineBreak":true},"Nakuzuukusa ng’oli wansi w’omuti ogw’omucungwa.",{"lineBreak":true},"Eyo maama wo gye yafunira olubuto era eyo",{"lineBreak":true},"maama wo gye yakuzaalira mu bulumi obungi."]},{"type":"heading","content":["Omwagalwa"]},{"type":"verse","number":6,"content":["Nteeka ng’akabonero ku mutima gwo,",{"lineBreak":true},"era ng’akabonero ku mukono gwo,",{"lineBreak":true},"kubanga okwagala kwa maanyi ng’okufa,",{"lineBreak":true},"obuggya bwakwo buli ng’obusungu obw’emagombe.",{"lineBreak":true},"Kwaka ng’ennimi ez’omuliro,",{"lineBreak":true},"omuliro ogwaka n’amaanyi ennyo."]},{"type":"verse","number":7,"content":["Amazzi amangi tegamalaawo nnyonta ya kwagala",{"lineBreak":true},"n’emigga tegiyinza kukumalawo.",{"lineBreak":true},"Singa omuntu awaayo",{"lineBreak":true},"obugagga bwe bwonna obw’ennyumba ye okufuna okwagala,",{"lineBreak":true},"asekererwa nnyo."]},{"type":"heading","content":["Abemikwano"]},{"type":"verse","number":8,"content":["Tulina muto waffe",{"lineBreak":true},"atannamera mabeere,",{"lineBreak":true},"naye tulikola tutya",{"lineBreak":true},"bw’alituuka okwogerezebwa?"]},{"type":"verse","number":9,"content":["Singa abadde bbugwe",{"lineBreak":true},"twandimuzimbyeko eminaala egya ffeeza,",{"lineBreak":true},"singa abadde luggi",{"lineBreak":true},"twandimuggalidde na mivule."]},{"type":"heading","content":["Omwagalwa"]},{"type":"verse","number":10,"content":["Ndi bbugwe",{"lineBreak":true},"era n’amabeere gange gali ng’ekitikkiro,",{"lineBreak":true},"noolwekyo mu maaso ge,",{"lineBreak":true},"mmufuukidde aleeta emirembe."]},{"type":"verse","number":11,"content":["Sulemaani yalina ennimiro y’emizabbibu e Baaluka Kamooni,",{"lineBreak":true},"n’agisigira abalimi.",{"lineBreak":true},"Buli omu ku bo yamusalira",{"lineBreak":true},"ebitundu bya ffeeza lukumi."]},{"type":"verse","number":12,"content":["Ennimiro yange ey’emizabbibu, yange,",{"lineBreak":true},"ebitundu olukumi bibyo ggwe Sulemaani,",{"lineBreak":true},"ebitundu ebikumi bibiri by’abo abalabirira ennimiro."]},{"type":"heading","content":["Owoomukwano"]},{"type":"verse","number":13,"content":["Ggwe abeera mu nnimiro",{"lineBreak":true},"ne mikwano gyo nga weebali,",{"lineBreak":true},"ka mpulire eddoboozi lyo."]},{"type":"heading","content":["Omwagalwa"]},{"type":"verse","number":14,"content":["Yanguwa okuvaayo eyo,",{"lineBreak":true},"odduke mangu ng’empeewo",{"lineBreak":true},"oba ng’ennangaazi ento,",{"lineBreak":true},"oddukire ku nsozi ezijjudde ebyakaloosa."]}],"footnotes":[]}]}