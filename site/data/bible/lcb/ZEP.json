{"id":"ZEP","name":"Zeffaniya","chapters":[{"number":1,"content":[{"type":"verse","number":1,"content":["Ekigambo kya Mukama ekyajjira Zeffaniya mutabani wa Kuusi, muzzukulu wa Gedaliya, muzzukulu wa Amaliya, muzzukulu wa Keezeekiya, mu mirembe gya Yosiya mutabani wa Amoni, Kabaka wa Yuda."]},{"type":"heading","content":["Okulabula kw’Omusango n’Okuzikirizibwa kwa Yuda"]},{"type":"verse","number":2,"content":["“Ndizikiririza ddala byonna okuva ku nsi,” bw’ayogera Mukama."]},{"type":"verse","number":3,"content":["“Ndizikiriza abantu wamu n’ensolo;",{"lineBreak":true},"ndizikiriza ebinyonyi eby’omu bbanga",{"lineBreak":true},"n’ebyennyanja;",{"lineBreak":true},"ababi balisigaza ntuumu ya kafakalimbo;",{"lineBreak":true},"bwe ndimalawo abantu okuva ku nsi,”",{"lineBreak":true},"bw’ayogera Mukama."]},{"type":"verse","number":4,"content":["Ndigololera ku Yuda omukono gwange,",{"lineBreak":true},"era ne ku abo bonna abali mu Yerusaalemi;",{"lineBreak":true},"era ekitundu kya Baali ekifisseewo n’ennyumba ya Bakemali,",{"lineBreak":true},"bakabona abasinza ebifaananyi, ndibazikiriza okuva mu kifo kino,"]},{"type":"verse","number":5,"content":["abo abavuunamira eggye ery’omu ggulu",{"lineBreak":true},"ku nnyumba waggulu,",{"lineBreak":true},"ne balisinza n’abo abalayira mu linnya lya Mukama,",{"lineBreak":true},"ate nga balayira ne mu linnya lya Malukamu,"]},{"type":"verse","number":6,"content":["abo abadda emabega obutagoberera Mukama,",{"lineBreak":true},"wadde abo abatamunoonya newaakubadde okumwebuuzaako."]},{"type":"verse","number":7,"content":["Siriikirira awali Mukama Katonda,",{"lineBreak":true},"kubanga olunaku lwa Mukama luli kumpi.",{"lineBreak":true},"Mukama ategese ssaddaaka,",{"lineBreak":true},"era atukuzizza abagenyi be."]},{"type":"verse","number":8,"content":["Ku lunaku olwa ssaddaaka ya Mukama,",{"lineBreak":true},"ndibonereza abakungu",{"lineBreak":true},"n’abaana ba Kabaka,",{"lineBreak":true},"n’abo bonna abambadde",{"lineBreak":true},"ebyambalo ebitasaana."]},{"type":"verse","number":9,"content":["Awo ku lunaku olwo ndibonereza",{"lineBreak":true},"abo bonna abeewala okulinnya ku muziziko,",{"lineBreak":true},"n’abo abajjuza ennyumba ya Mukama waabwe",{"lineBreak":true},"ebikolwa eby’obukambwe n’obulimba."]},{"type":"verse","number":10,"content":["Ku lunaku olwo, bw’ayogera Mukama,",{"lineBreak":true},"eddoboozi ery’okukaaba liriwulikika ku Mulyango ogw’Ebyennyanja,",{"lineBreak":true},"okukaaba okuva ku luuyi olwokubiri,",{"lineBreak":true},"n’okubwatuka okunene okuva ku nsozi."]},{"type":"verse","number":11,"content":["Mwekaabireko, mmwe abali mu matwale g’akatale;",{"lineBreak":true},"abasuubuzi bammwe bonna zibasanze,",{"lineBreak":true},"n’abo abeebinika ffeeza balizikirizibwa."]},{"type":"verse","number":12,"content":["Awo olulituuka mu biro ebyo ndimulisa Yerusaalemi n’ettabaaza nga nnoonya,",{"lineBreak":true},"mbonereze abo bonna abalagajjavu",{"lineBreak":true},"abali ng’omwenge ogutanasengejjebwa,",{"lineBreak":true},"abalowooza nti Mukama",{"lineBreak":true},"talibaako ne ky’akolawo."]},{"type":"verse","number":13,"content":["Obugagga bwabwe bulinyagibwa,",{"lineBreak":true},"n’ennyumba zaabwe zimenyebwemenyebwe.",{"lineBreak":true},"Ne bwe balizimba ennyumba",{"lineBreak":true},"tebalizituulamu,",{"lineBreak":true},"era balisimba ennimiro ez’emizabbibu nazo",{"lineBreak":true},"tebalinywa wayini wamu."]},{"type":"heading","content":["Olunaku lwa Mukama Olukulu"]},{"type":"verse","number":14,"content":["Olunaku lwa Mukama olukulu luli kumpi;",{"lineBreak":true},"ddala lunaatera okutuuka.",{"lineBreak":true},"Wuliriza! Omulwanyi alikaabira eyo ng’aliko obuyinike bungi,",{"lineBreak":true},"n’okukaaba ku lunaku lwa Mukama kujja kuba kungi nnyo."]},{"type":"verse","number":15,"content":["Olunaku olwo lunaku lwa busungu,",{"lineBreak":true},"lunaku lwa buyinike n’okulaba ennaku,",{"lineBreak":true},"lunaku lwa mutawaana n’okuzikirira,",{"lineBreak":true},"olunaku olw’ekikome n’ekizikiza,",{"lineBreak":true},"olunaku lw’ebire n’ekizikiza ekikutte ennyo;"]},{"type":"verse","number":16,"content":["olunaku olw’okufuuwa ekkondeere n’okulangirira olutalo",{"lineBreak":true},"ku bibuga ebiriko ebigo",{"lineBreak":true},"n’eri eminaala emigulumivu."]},{"type":"verse","number":17,"content":["Ndireeta, obuyinike ku bantu,",{"lineBreak":true},"batambule ng’abazibe b’amaaso,",{"lineBreak":true},"kubanga bakoze ebibi mu maaso ga Mukama,",{"lineBreak":true},"omusaayi gwabwe guliyiyibwa ng’enfuufu,",{"lineBreak":true},"n’ebyenda byabwe bivundire kungulu."]},{"type":"verse","number":18,"content":["Effeeza yaabwe ne zaabu yaabwe",{"lineBreak":true},"tebiriyinza kubataasa",{"lineBreak":true},"ku lunaku olw’obusungu bwa Mukama.",{"lineBreak":true},"Ensi yonna erizikirizibwa",{"lineBreak":true},"omuliro gw’obuggya bwe,",{"lineBreak":true},"era alimalirawo ddala",{"lineBreak":true},"abo bonna abali mu nsi."]}],"footnotes":[]},{"number":2,"content":[{"type":"heading","content":["Abalabe ba Isirayiri Basalirwa Omusango"]},{"type":"verse","number":1,"content":["Mukuŋŋaane, weewaawo, mukuŋŋaane,",{"lineBreak":true},"mmwe eggwanga eritalina nsonyi,"]},{"type":"verse","number":2,"content":["ekiseera ekyategekebwa nga tekinnatuuka,",{"lineBreak":true},"olunaku ne luba ng’ebisusunku ebifuumulibwa,",{"lineBreak":true},"obusungu bwa Mukama nga tebunnabatuukako,",{"lineBreak":true},"ng’olunaku olw’obusungu bwa Mukama terunnabatuukako."]},{"type":"verse","number":3,"content":["Munoonye Mukama, mmwe mwenna abawombeefu ab’omu nsi,",{"lineBreak":true},"abakola by’alagira;",{"lineBreak":true},"munoonye obutuukirivu n’obuwombeefu;",{"lineBreak":true},"mpozzi mulikwekebwa",{"lineBreak":true},"ku lunaku olw’obusungu bwe."]},{"type":"heading","content":["Obubaka eri Abafirisuuti"]},{"type":"verse","number":4,"content":["Gaza kirirekebwawo,",{"lineBreak":true},"ne Asukulooni kiriba matongo:",{"lineBreak":true},"abantu ba Asudodi baligobebwamu mu ttuntu,",{"lineBreak":true},"ne Ekuloni kirisimbulibwa."]},{"type":"verse","number":5,"content":["Zibasanze mmwe ababeera ku lubalama lw’ennyanja,",{"lineBreak":true},"eggwanga ery’Abakeresi!",{"lineBreak":true},"Ekigambo kya Mukama kikwolekedde,",{"lineBreak":true},"ggwe Kanani, ensi ey’Abafirisuuti.",{"lineBreak":true},"Ndikuzikiriza",{"lineBreak":true},"so tewaliba asigalawo."]},{"type":"verse","number":6,"content":["Olubalama lw’ennyanja ab’Akeresi gye babeera",{"lineBreak":true},"luliba malundiro g’abasumba n’ebisulo by’endiga."]},{"type":"verse","number":7,"content":["Olubalama lw’ennyanja luliba lwa kitundu ky’ennyumba ya Yuda ekyasigalawo",{"lineBreak":true},"era we banaalundiranga,",{"lineBreak":true},"ne mu nnyumba za Asukulooni",{"lineBreak":true},"mwe banaagalamiranga akawungeezi.",{"lineBreak":true},"Mukama Katonda waabwe alibalabirira,",{"lineBreak":true},"n’akomyawo obugagga bwabwe."]},{"type":"heading","content":["Obubaka eri Abamowaabu n’Abamoni"]},{"type":"verse","number":8,"content":["Mpulidde okuvuma kwa Mowaabu",{"lineBreak":true},"n’okusekerera kw’Abamoni",{"lineBreak":true},"kwe bavumye abantu bange",{"lineBreak":true},"ne batiisatiisa ensi yaabwe."]},{"type":"verse","number":9,"content":["Kale nga bwe ndi omulamu,",{"lineBreak":true},"bw’ayogera Mukama Ayinzabyonna, Katonda wa Isirayiri,",{"lineBreak":true},"ddala Mowaabu aliba nga Sodomu,",{"lineBreak":true},"n’abaana ba Amoni nga Ggomola,",{"lineBreak":true},"ekifo emyennyango kye gyemala, n’ebirombe by’omunnyo,",{"lineBreak":true},"amatongo agolubeerera. Balinyagibwa abantu bange abaliba basigaddewo,",{"lineBreak":true},"n’ekitundu ky’eggwanga lyange ekifisseewo kiritwala ensi yaabwe."]},{"type":"verse","number":10,"content":["Eno y’eriba empeera yaabwe olw’amalala gaabwe,",{"lineBreak":true},"kubanga bavumye ne banyooma abantu ba Mukama Ayinzabyonna."]},{"type":"verse","number":11,"content":["Mukama aliba wa ntiisa gye bali",{"lineBreak":true},"bw’alizikiriza bakatonda bonna ab’ensi.",{"lineBreak":true},"Amawanga gonna ag’oku mbalama zonna galimusinza,",{"lineBreak":true},"buli muntu ng’asinziira mu nsi ye."]},{"type":"heading","content":["Obubaka eri Abaesiyopiya"]},{"type":"verse","number":12,"content":["Nammwe Abaesiyopiya, mulittibwa n’ekitala kyange."]},{"type":"heading","content":["Obubaka eri Obwasuli"]},{"type":"verse","number":13,"content":["Aligololera omukono gwe ku bukiikakkono",{"lineBreak":true},"n’azikiriza Obwasuli;",{"lineBreak":true},"n’afuula Nineeve amatongo",{"lineBreak":true},"era ekikalu ng’eddungu."]},{"type":"verse","number":14,"content":["Ente n’endiga zinaagalamiranga wakati mu kyo,",{"lineBreak":true},"n’ensolo zonna eza buli kika:",{"lineBreak":true},"ekiwuugulu era ne nnamunnungu",{"lineBreak":true},"banaasulanga ku mpagi zaakyo.",{"lineBreak":true},"Amaloboozi gaabyo ganaawulikikanga mu madirisa;",{"lineBreak":true},"kafakalimbo ajjudde mu miryango,",{"lineBreak":true},"n’emikiikiro egy’emivule giryelulwa."]},{"type":"verse","number":15,"content":["Kino kye kibuga ekya kyetwala,",{"lineBreak":true},"ekyayogeranga mu mutima gwakyo nti,",{"lineBreak":true},"Nze we ndi, tewali mulala wabula nze:",{"lineBreak":true},"nga kifuuse bifulukwa,",{"lineBreak":true},"ekifo ensolo ez’omu nsiko we zigalamira!",{"lineBreak":true},"Buli muntu akiyitako aneesoozanga",{"lineBreak":true},"n’akinyoomoola."]}],"footnotes":[]},{"number":3,"content":[{"type":"heading","content":["Obujeemu bwa Yerusaalemi"]},{"type":"verse","number":1,"content":["Zikisanze ekibuga ekijooga,",{"lineBreak":true},"ekijeemu era ekyonoonefu!"]},{"type":"verse","number":2,"content":["Tekigondera ddoboozi lya Mukama,",{"lineBreak":true},"wadde okukkiriza okubuulirirwa;",{"lineBreak":true},"tekyesiga Mukama;",{"lineBreak":true},"wadde okusemberera Katonda waakyo."]},{"type":"verse","number":3,"content":["Abakungu baakyo mpologoma eziwuluguma,",{"lineBreak":true},"era n’abalamuzi baakyo misege gya kiro,",{"lineBreak":true},"bakirimululu abatafissaawo kantu."]},{"type":"verse","number":4,"content":["Bannabbi baakyo si ba buvunaanyizibwa",{"lineBreak":true},"era ba nkwe;",{"lineBreak":true},"bakabona baakyo baweebuusizza ekifo ekitukuvu,",{"lineBreak":true},"era bamenya amateeka."]},{"type":"verse","number":5,"content":["Mukama ali wakati mu kyo, mutuukirivu",{"lineBreak":true},"era tasobya.",{"lineBreak":true},"Buli nkya alamula mu bwenkanya,",{"lineBreak":true},"era buli lukya talemwa;",{"lineBreak":true},"naye atali mutuukirivu taswala."]},{"type":"verse","number":6,"content":["“Nsanyizzaawo amawanga,",{"lineBreak":true},"era ebigo byabwe bifufuggaziddwa;",{"lineBreak":true},"nzisizza enguudo zaabwe,",{"lineBreak":true},"ne wataba ayitamu.",{"lineBreak":true},"Ebibuga byabwe bizikiridde,",{"lineBreak":true},"ne watabaawo muntu n’omu abeeramu."]},{"type":"verse","number":7,"content":["Nagamba eri ekibuga nti,",{"lineBreak":true},"‘Ddala onontya,",{"lineBreak":true},"era onokkiriza okubuulirirwa.’",{"lineBreak":true},"Ennyumba zaakyo tezandimaliddwawo,",{"lineBreak":true},"n’ebibonerezo byange byonna tebyandimutuuseeko.",{"lineBreak":true},"Naye beesunganga nnyo",{"lineBreak":true},"okukola ebitasaana mu byonna bye baakolanga."]},{"type":"verse","number":8,"content":["Noolwekyo munnindirire,” bw’ayogera Mukama.",{"lineBreak":true},"Olunaku lwe ndiyimirira ne ntegeeza byonna",{"lineBreak":true},"kubanga mmaliridde okukuŋŋaanya amawanga,",{"lineBreak":true},"ndireeta obwakabaka wamu",{"lineBreak":true},"okubayiwako obusungu bwange,",{"lineBreak":true},"n’ekiruyi kyange kyonna.",{"lineBreak":true},"Omuliro ogw’obuggya bwange",{"lineBreak":true},"gulisaanyaawo ensi yonna."]},{"type":"heading","content":["Essuubi lya Isirayiri"]},{"type":"verse","number":9,"content":["“Mu biro ebyo ndirongoosa enjogera ey’amawanga;",{"lineBreak":true},"bonna balikoowoola erinnya lya Mukama,",{"lineBreak":true},"okumuweereza n’omwoyo gumu."]},{"type":"verse","number":10,"content":["Okuva emitala w’emigga egy’Obuwesiyopya,",{"lineBreak":true},"abo abansinza, abantu bange abasaasaana,",{"lineBreak":true},"balindeetera ssaddaaka."]},{"type":"verse","number":11,"content":["Ku lunaku olwo toliswala",{"lineBreak":true},"olw’ebyo byonna by’osobezza gye ndi:",{"lineBreak":true},"kubanga ndiggya wakati mu ggwe",{"lineBreak":true},"abo abeenyumiririza mu malala,",{"lineBreak":true},"toliddayo nate kwegulumiza",{"lineBreak":true},"ku lusozi lwange olutukuvu."]},{"type":"verse","number":12,"content":["Naye ndireka wakati mu ggwe",{"lineBreak":true},"abantu abakakkamu era abeetoowaze,",{"lineBreak":true},"abo abesiga erinnya lya Mukama."]},{"type":"verse","number":13,"content":["Ekitundu kya Isirayiri ekirisigalawo tebalikola bitali bya butuukirivu",{"lineBreak":true},"so tebalyogera bya bulimba",{"lineBreak":true},"wadde okuba abakuusa.",{"lineBreak":true},"Balirya, baligalamira,",{"lineBreak":true},"so tewaliba alibatiisa.”"]},{"type":"heading","content":["Oluyimba olw’Essanyu"]},{"type":"verse","number":14,"content":["Yimba, ggwe omuwala wa Sayuuni;",{"lineBreak":true},"yogerera waggulu, ggwe Isirayiri;",{"lineBreak":true},"sanyuka ojaguze n’omutima gwo gwonna,",{"lineBreak":true},"ggwe omuwala wa Yerusaalemi."]},{"type":"verse","number":15,"content":["Mukama akuggyeeko ekibonerezo kyo,",{"lineBreak":true},"agobyewo omulabe wo.",{"lineBreak":true},"Kabaka wa Isirayiri, Mukama, ali naawe;",{"lineBreak":true},"tokyaddayo kutya kabi konna."]},{"type":"verse","number":16,"content":["Ku lunaku olwo Yerusaalemi kirigambibwa nti,",{"lineBreak":true},"“Totya, ggwe Sayuuni;",{"lineBreak":true},"emikono gyo gireme okuddirira."]},{"type":"verse","number":17,"content":["Mukama Katonda ali naawe,",{"lineBreak":true},"ow’amaanyi alokola:",{"lineBreak":true},"alikusanyukira,",{"lineBreak":true},"alikukkakkanyiza mu kwagala kwe,",{"lineBreak":true},"alikusanyukira n’okuyimba.”"]},{"type":"verse","number":18,"content":["“Ennaku eyabakwatanga olw’embaga ezabakuŋŋaanyanga",{"lineBreak":true},"ndigibaggyako;",{"lineBreak":true},"kubanga kibafuukidde omugugu."]},{"type":"verse","number":19,"content":["Laba, mu biro ebyo ndibonereza",{"lineBreak":true},"abo bonna abaakubonyaabonya:",{"lineBreak":true},"era ndinunula omulema,",{"lineBreak":true},"ne nkuŋŋaanya n’abo abaasaasaanyizibwa;",{"lineBreak":true},"era ndibafuula ettendo ne mbawa ekitiibwa",{"lineBreak":true},"mu nsi zonna gye baaswazibwa."]},{"type":"verse","number":20,"content":["Mu biro ebyo ndibakuŋŋaanya;",{"lineBreak":true},"mu kiseera ekyo ndibazza eka.",{"lineBreak":true},"Weewaawo ndibawa ekitiibwa n’ettendo",{"lineBreak":true},"mu mawanga gonna ag’omu nsi zonna,",{"lineBreak":true},"bwe ndikomyawo obugagga bwammwe",{"lineBreak":true},"nga mulaba,”",{"lineBreak":true},"bw’ayogera Mukama."]}],"footnotes":[]}]}